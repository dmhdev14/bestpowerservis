---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Fuel Filtration Systems — PT Best Power Servis"
  description="Solusi Fuel Filtration Systems canggih dan bejana filtrasi solar untuk memurnikan bahan bakar industri, mengurangi kontaminasi, dan melindungi mesin."
>
  <main class="service-page">
    <div class="hex-pattern"></div>
    <div class="ambient-glow"></div>

    <div class="container page-container">
      <!-- Breadcrumb Navigation -->
      <nav class="breadcrumb-nav" aria-label="Breadcrumb">
        <a href="/">HOME</a>
        <span class="bc-slash">/</span>
        <a href="/layanan">OUR SOLUTIONS</a>
        <span class="bc-slash">/</span>
        <span class="bc-current">FUEL FILTRATION SYSTEMS</span>
      </nav>

      <!-- Hero Header -->
      <header class="service-header">
        <div class="chip-badge">
          <span class="chip-dot"></span>
          OUR SOLUTIONS
        </div>

        <h1 class="service-title">
          FUEL FILTRATION <span class="gold-foil">SYSTEMS</span>
        </h1>

        <p class="service-lead">
          Solusi sistem filtrasi bahan bakar dan pelumas industri mutakhir untuk efisiensi maksimal dan proteksi mesin jangka panjang.
        </p>

        <div class="gold-hairline"></div>
      </header>

      <!-- Content Section (Kosong terlebih dahulu sesuai permintaan) -->
      <section class="empty-content-section" aria-label="Konten Utama">
        <div class="empty-placeholder">
          <!-- Section ini kosong terlebih dahulu dan siap diisi konten detail -->
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  .service-page {
    background-color: #0d0d0d;
    position: relative;
    padding: 130px 0 100px;
    overflow: hidden;
    min-height: calc(100vh - 120px);
  }

  .ambient-glow {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 400px;
    background: radial-gradient(circle, rgba(201, 146, 42, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .page-container {
    position: relative;
    z-index: 1;
  }

  /* Breadcrumb */
  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .breadcrumb-nav a {
    color: #c9922a;
    transition: color 0.2s ease;
  }

  .breadcrumb-nav a:hover {
    color: #e8b84b;
  }

  .bc-slash {
    color: rgba(255, 255, 255, 0.2);
  }

  .bc-current {
    color: rgba(255, 255, 255, 0.85);
  }

  /* Header */
  .service-header {
    text-align: center;
    max-width: 820px;
    margin: 0 auto 48px;
  }

  .chip-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    color: #e8b84b;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 18px;
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 8px #e8b84b;
  }

  .service-title {
    font-family: "Oswald", sans-serif;
    font-size: clamp(2.4rem, 5vw, 4.2rem);
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.1;
    color: #ffffff;
    text-transform: uppercase;
    margin: 0 0 20px;
  }

  .gold-foil {
    background: linear-gradient(135deg, #ffffff 0%, #e8b84b 55%, #c9922a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .service-lead {
    font-family: "Inter", sans-serif;
    font-size: 1.08rem;
    line-height: 1.76;
    color: rgba(255, 255, 255, 0.82);
    margin: 0 auto 30px;
    text-wrap: pretty;
  }

  .gold-hairline {
    width: 64px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #e8b84b, transparent);
    margin: 0 auto;
    border-radius: 2px;
  }

  /* Empty Content Section (Placeholder) */
  .empty-content-section {
    min-height: 260px;
    background: rgba(255, 255, 255, 0.015);
    border: 1px dashed rgba(201, 146, 42, 0.18);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
  }

  .empty-placeholder {
    width: 100%;
  }

  /* Responsive Mobile */
  @media (max-width: 768px), (hover: none) and (pointer: coarse) {
    .service-page {
      padding: 110px 0 68px;
    }

    .service-title {
      font-size: 2.1rem;
    }

    .service-lead {
      font-size: 0.98rem;
      line-height: 1.66;
    }

    .empty-content-section {
      min-height: 200px;
    }
  }
</style>
