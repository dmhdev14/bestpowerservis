---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';

const highlights = [
  {
    num: '01',
    title: 'Tentang Kami',
    desc: 'Profil resmi PT Best Power Servis yang didirikan sejak 2023 dengan legalitas operasional lengkap.',
    href: '/tentang',
    cta: 'Profil Lengkap',
  },
  {
    num: '02',
    title: 'Visi & Misi',
    desc: 'Komitmen dan 5 pilar utama dalam menghadirkan solusi energi serta sistem filtrasi terbaik.',
    href: '/visi-misi',
    cta: 'Lihat Visi Misi',
  },
  {
    num: '03',
    title: 'Layanan Kami',
    desc: 'Rental genset & loadbank, perawatan berkala, penyediaan suku cadang, dan sistem filtrasi industri.',
    href: '/layanan',
    cta: 'Lihat Layanan',
  },
  {
    num: '04',
    title: 'Portofolio Proyek',
    desc: 'Dokumentasi pekerjaan lapangan instalasi genset, overhaul mesin, dan vessel filtrasi industri.',
    href: '/proyek',
    cta: 'Galeri Proyek',
  },
  {
    num: '05',
    title: 'Produk Filtrasi',
    desc: 'Replacement filter element brand global (Parker, Hydac, Pall, Cimtek) hingga Fuel Filtration Vessel.',
    href: '/produk',
    cta: 'Katalog Produk',
  },
  {
    num: '06',
    title: 'Keunggulan Kami',
    desc: 'Alasan utama mitra industri di seluruh Indonesia mempercayakan kebutuhan energinya kepada kami.',
    href: '/keunggulan',
    cta: 'Lihat Keunggulan',
  },
];
---

<Layout
  title="PT Best Power Servis — Solusi Energi & Filtrasi Terbaik untuk Industri Anda"
  description="PT Best Power Servis menyediakan rental genset, loadbank, service & perawatan genset, suku cadang, serta sistem filtrasi industri berkualitas tinggi. Melayani seluruh Indonesia."
  isHome={true}
>
  <Hero />

  <!-- Executive Hub / Directory Section -->
  <section id="ringkasan" class="section section-darker">
    <div class="hex-pattern"></div>
    <div class="container" style="position: relative; z-index: 1;">
      <div class="hub-header">
        <div class="section-label reveal">Eksplorasi Profil</div>
        <h2 class="section-title reveal delay-100">
          KENALI LEBIH DEKAT<br />PT BEST POWER SERVIS
        </h2>
        <p class="section-desc reveal delay-200">
          Pilih informasi yang Anda butuhkan secara spesifik untuk melihat layanan, katalog produk, dokumentasi proyek lapangan, hingga konsultasi langsung dengan tim kami.
        </p>
      </div>

      <div class="hub-grid">
        {highlights.map((item, idx) => (
          <a href={item.href} class={`hub-card reveal delay-${((idx % 3) + 1) * 100}`}>
            <div class="hub-card-top">
              <span class="hub-num">{item.num}</span>
              <div class="hub-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14M12 5l7 7-7 7" />
                </svg>
              </div>
            </div>
            <h3 class="hub-title">{item.title}</h3>
            <p class="hub-desc">{item.desc}</p>
            <span class="hub-cta">{item.cta} →</span>
          </a>
        ))}
      </div>

      <!-- Direct CTA -->
      <div class="hub-contact-strip reveal delay-300">
        <div>
          <h3>Butuh Penawaran Cepat atau Konsultasi Teknis?</h3>
          <p>Hubungi tim kami langsung untuk konsultasi kebutuhan genset, loadbank, atau sistem filtrasi Anda.</p>
        </div>
        <a href="/kontak" class="btn btn-gold">
          Hubungi Kami
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  #ringkasan {
    border-top: 1px solid rgba(201, 146, 42, 0.12);
  }

  .hub-header {
    max-width: 640px;
    margin-bottom: 48px;
  }

  .hub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }

  .hub-card {
    background: #151515;
    border: 1px solid rgba(201, 146, 42, 0.14);
    border-radius: 16px;
    padding: 30px 26px;
    display: flex;
    flex-direction: column;
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
    text-decoration: none;
  }

  .hub-card:hover {
    transform: translateY(-5px);
    background: #191919;
    border-color: rgba(201, 146, 42, 0.45);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.55), 0 0 20px rgba(201, 146, 42, 0.08);
  }

  .hub-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .hub-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    color: rgba(201, 146, 42, 0.35);
    line-height: 1;
    transition: color 0.3s ease;
  }

  .hub-card:hover .hub-num {
    color: #E8B84B;
  }

  .hub-arrow {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #C9922A;
    transition: all 0.3s ease;
  }

  .hub-card:hover .hub-arrow {
    background: #C9922A;
    color: #000;
    transform: translateX(3px);
  }

  .hub-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.55rem;
    letter-spacing: 0.04em;
    color: #fff;
    margin-bottom: 10px;
  }

  .hub-desc {
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 20px;
    flex-grow: 1;
  }

  .hub-cta {
    font-size: 0.82rem;
    font-weight: 700;
    color: #E8B84B;
    letter-spacing: 0.03em;
  }

  .hub-contact-strip {
    background: linear-gradient(135deg, rgba(201, 146, 42, 0.1), rgba(20, 20, 20, 0.95));
    border: 1px solid rgba(201, 146, 42, 0.28);
    border-radius: 16px;
    padding: 32px 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .hub-contact-strip h3 {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.6rem;
    letter-spacing: 0.04em;
    color: #fff;
    margin-bottom: 6px;
  }

  .hub-contact-strip p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.5;
  }

  .hub-contact-strip .btn {
    flex-shrink: 0;
  }

  @media (max-width: 992px) {
    .hub-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hub-contact-strip {
      flex-direction: column;
      align-items: flex-start;
      padding: 24px 20px;
    }
    .hub-contact-strip .btn {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 600px) {
    .hub-header {
      margin-bottom: 32px;
    }
    .hub-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 32px;
    }
    .hub-card {
      padding: 22px 18px;
      border-radius: 14px;
    }
    .hub-num {
      font-size: 1.6rem;
    }
    .hub-title {
      font-size: 1.35rem;
    }
    .hub-desc {
      font-size: 0.85rem;
      margin-bottom: 14px;
    }
  }
</style>
