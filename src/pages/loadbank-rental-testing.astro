---
import Layout from '../layouts/Layout.astro';

const servicesList = [
  {
    num: '01',
    title: 'Loadbank Rental for UPS Testing',
    desc: 'Penyewaan unit loadbank presisi tinggi untuk pengujian kapasitas beban, verifikasi waktu otonomi baterai, serta uji pelepasan muatan (discharge test) sistem UPS tanpa risiko terhadap beban kritis.',
    badge: 'UPS VERIFICATION'
  },
  {
    num: '02',
    title: 'Loadbank Rental for Generator Testing',
    desc: 'Penyediaan dummy load resistif dan reaktif untuk pengujian beban generator berkala, mencegah terjadinya penumpukan karbon (wet-stacking), dan memastikan kesiapan genset saat pemadaman PLN.',
    badge: 'GENSET READINESS'
  },
  {
    num: '03',
    title: 'UPS Commissioning Support',
    desc: 'Dukungan pengujian beban penuh saat fase instalasi dan commissioning fasilitas baru. Memastikan seluruh modul UPS, bypass statis, dan sistem proteksi bekerja sinkron sebelum serah terima.',
    badge: 'COMMISSIONING PHASE'
  },
  {
    num: '04',
    title: 'Generator Load Testing',
    desc: 'Pengujian performa dinamis genset menggunakan simulasi beban bertahap (25%, 50%, 75%, 100%, hingga 110%) untuk memvalidasi respon transien, stabilitas governor, dan sistem pendingin mesin.',
    badge: 'STEP-LOAD TESTING'
  },
  {
    num: '05',
    title: 'Performance & Acceptance Testing Support',
    desc: 'Pendampingan pengujian penerimaan sistem (Site Acceptance Test / SAT) bersama konsultan proyek dan auditor teknis dengan metodologi pengujian standar industri nasional dan internasional.',
    badge: 'AUDIT & COMPLIANCE'
  },
  {
    num: '06',
    title: 'Technical Operator and On-site Support',
    desc: 'Penyediaan teknisi dan operator bersertifikat di lokasi pengujian untuk penginstalan kabel daya, operasional instrumen loadbank, pemantauan parameter elektrikal, dan jaminan keselamatan kerja (K3).',
    badge: 'ON-SITE EXPERTISE'
  }
];

const capabilities = [
  {
    label: 'Kapasitas Uji Fleksibel',
    desc: 'Mendukung pengujian mulai dari skala kecil hingga multi-megawatt untuk generator dan UPS berdaya besar.'
  },
  {
    label: 'Unit Terkalibrasi Resmi',
    desc: 'Instrumen pengukuran terkalibrasi berkala guna menjamin keakuratan data tegangan, arus, daya nyata, dan faktor daya.'
  },
  {
    label: 'Dokumentasi Telemetri Lengkap',
    desc: 'Laporan pengujian komprehensif berupa log data elektrikal dan grafik beban untuk kebutuhan verifikasi audit klien.'
  },
  {
    label: 'Mobilisasi Cepat Nasional',
    desc: 'Kesiapan armada dan unit untuk dikirim ke seluruh lokasi proyek fasilitas industri dan data center di Indonesia.'
  }
];
---

<Layout
  title="Loadbank Rental & Testing Services — PT Best Power Servis"
  description="Layanan Loadbank Rental dan Testing Services terkalibrasi untuk pengujian kapasitas generator, UPS, commissioning, dan verifikasi infrastruktur daya kritis di seluruh Indonesia."
>
  <main class="service-page">
    <!-- Ambient Blueprint Grid & Glow -->
    <div class="page-grid-bg"></div>
    <div class="ambient-glow glow-top"></div>
    <div class="ambient-glow glow-side"></div>

    <div class="container relative-z">
      <!-- ========================================================
           BREADCRUMB & HERO HEADER
           ======================================================== -->
      <header class="service-hero anim-fade-in">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">HOME</a>
          <span class="bc-slash">/</span>
          <span class="bc-section">OUR SOLUTIONS</span>
          <span class="bc-slash">/</span>
          <span class="bc-current">LOADBANK RENTAL &amp; TESTING</span>
        </nav>

        <div class="chip-badge">
          <span class="radar-dot"></span>
          CRITICAL POWER VERIFICATION
        </div>

        <h1 class="service-title">
          LOADBANK RENTAL &amp; <span class="gold-foil">TESTING SERVICES</span>
        </h1>

        <!-- Mandatory Tagline from User Request -->
        <p class="service-tagline">
          Powering Confidence. Testing Reliability.
        </p>

        <!-- Mandatory Lead Narrative (Verbatim from User) -->
        <div class="service-narrative-card">
          <p class="narrative-lead">
            <strong>PT Best Power Servis</strong> menyediakan layanan rental Loadbank untuk mendukung pengujian, commissioning, dan verifikasi performa sistem kelistrikan pada fasilitas data center, industri, dan infrastruktur kritikal.
          </p>
          <div class="narrative-divider"></div>
          <div class="narrative-sub-grid">
            <div class="narrative-col">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <p>
                Kami memahami pentingnya pengujian sistem UPS dan generator untuk memastikan kesiapan peralatan sebelum digunakan dalam operasional sebenarnya.
              </p>
            </div>
            <div class="narrative-col">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
              <p>
                Dengan dukungan peralatan Loadbank dan tenaga teknis profesional, BPS siap membantu kebutuhan pengujian sesuai kapasitas, konfigurasi, dan persyaratan teknis proyek.
              </p>
            </div>
          </div>
        </div>

        <div class="gold-accent-line"></div>
      </header>

      <!-- ========================================================
           EDITORIAL SHOWCASE: REAL IMAGE & OPERATIONAL CAPABILITIES
           ======================================================== -->
      <section class="showcase-banner anim-slide-up delay-1">
        <!-- Precision Metallic Corner Crosshairs -->
        <span class="crosshair top-left"></span>
        <span class="crosshair top-right"></span>
        <span class="crosshair bottom-left"></span>
        <span class="crosshair bottom-right"></span>

        <div class="showcase-grid">
          <!-- Left: Real Field Photography -->
          <div class="showcase-media">
            <img
              src="/projects/loadbank.webp"
              alt="Teknisi PT Best Power Servis melakukan pengujian loadbank di lokasi industri"
              class="showcase-img"
              width="640"
              height="400"
              loading="eager"
            />
            <div class="showcase-overlay"></div>
            <div class="media-live-chip">
              <span class="live-dot"></span>
              <span>DOKUMENTASI PENGUJIAN LAPANGAN</span>
            </div>
          </div>

          <!-- Right: Key Technical Standards -->
          <div class="showcase-content">
            <span class="section-tag">KAPABILITAS PENGUJIAN</span>
            <h2 class="showcase-heading">STANDAR REKAYASA &amp; KESELAMATAN TINGGI</h2>
            <p class="showcase-desc">
              Setiap pekerjaan pengujian beban dijalankan dengan SOP ketat berorientasi K3, instrumen telemetri digital terkalibrasi, serta kabel daya berspesifikasi industri untuk memastikan keandalan tanpa kompromi.
            </p>

            <div class="capabilities-grid">
              {capabilities.map((cap) => (
                <div class="cap-item">
                  <div class="cap-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <div class="cap-text">
                    <strong class="cap-title">{cap.label}</strong>
                    <span class="cap-detail">{cap.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================================
           OUR SERVICES SECTION (6 SERVICES AS REQUESTED)
           ======================================================== -->
      <section class="services-suite-section anim-slide-up delay-2">
        <div class="section-center-header">
          <span class="suite-chip">LINGKUP LAYANAN SPESIFIK</span>
          <h2 class="suite-title">OUR SERVICES</h2>
          <p class="suite-desc">
            Solusi menyeluruh dari pengujian unit mandiri hingga pendampingan komprehensif commissioning infrastruktur kelistrikan kritikal.
          </p>
          <div class="gold-accent-line"></div>
        </div>

        <div class="services-grid">
          {servicesList.map((svc) => (
            <article class="svc-card">
              <!-- Edge Hover Beam -->
              <div class="svc-beam"></div>

              <div class="svc-card-top">
                <span class="svc-num">{svc.num}</span>
                <span class="svc-badge">{svc.badge}</span>
              </div>

              <h3 class="svc-title">{svc.title}</h3>
              <div class="svc-divider"></div>
              <p class="svc-desc">{svc.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ========================================================
           CONSULTATION & DIRECT ACTION DOCK
           ======================================================== -->
      <section class="consultation-dock anim-slide-up delay-3">
        <div class="dock-content">
          <span class="dock-chip">KONSULTASI PENGUJIAN BEBAN</span>
          <h3 class="dock-title">SIAPKAN PENGUJIAN SISTEM KELISTRIKAN ANDA</h3>
          <p class="dock-desc">
            Hubungi tim teknisi PT Best Power Servis untuk mendiskusikan kapasitas loadbank yang dibutuhkan, konfigurasi pengujian, dan penawaran teknis resmi proyek Anda.
          </p>
        </div>
        <div class="dock-actions">
          <a
            href="https://wa.me/628111464967?text=Halo%20PT%20Best%20Power%20Servis,%20saya%20ingin%20konsultasi%20layanan%20Loadbank%20Rental%20%26%20Testing."
            target="_blank"
            rel="noopener noreferrer"
            class="dock-btn-whatsapp"
          >
            <span>Konsultasi WhatsApp</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/kontak" class="dock-btn-outline">
            Hubungi Kantor Kami
          </a>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  /* =========================================
     PAGE CONTAINER & INDUSTRIAL AMBIENCE
     ========================================= */
  .service-page {
    background-color: #0A0A0A;
    position: relative;
    padding: 120px 0 100px;
    overflow: hidden;
    min-height: 100vh;
  }

  .relative-z {
    position: relative;
    z-index: 1;
  }

  /* Blueprint Grid Pattern */
  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 146, 42, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 146, 42, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    z-index: 0;
  }
  .glow-top {
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 420px;
    background: radial-gradient(circle, rgba(201, 146, 42, 0.09) 0%, transparent 70%);
  }
  .glow-side {
    bottom: 20%;
    right: 5%;
    width: 500px;
    height: 450px;
    background: radial-gradient(circle, rgba(232, 184, 75, 0.05) 0%, transparent 70%);
  }

  /* =========================================
     HERO & NARRATIVE
     ========================================= */
  .service-hero {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 60px;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .breadcrumb-nav a {
    color: #c9922a;
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    color: #e8b84b;
  }
  .bc-slash { color: rgba(255, 255, 255, 0.2); }
  .bc-section { color: rgba(255, 255, 255, 0.6); }
  .bc-current { color: rgba(255, 255, 255, 0.9); }

  .chip-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    color: #e8b84b;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .radar-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 10px #e8b84b;
    animation: radarPulse 2s infinite ease-in-out;
  }

  @keyframes radarPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .service-title {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.05;
    color: #ffffff;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .gold-foil {
    background: linear-gradient(135deg, #ffffff 0%, #e8b84b 55%, #c9922a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* Tagline */
  .service-tagline {
    font-family: "Inter", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #e8b84b;
    text-transform: uppercase;
    margin: 0 0 28px;
  }

  /* Narrative Dossier Card */
  .service-narrative-card {
    background: #111111;
    border: 1px solid rgba(201, 146, 42, 0.22);
    border-left: 4px solid #c9922a;
    border-radius: 4px;
    padding: 28px 32px;
    text-align: left;
    margin-bottom: 30px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .narrative-lead {
    font-family: "Inter", sans-serif;
    font-size: 1.05rem;
    line-height: 1.75;
    color: #FFFFFF;
    margin: 0 0 20px;
  }

  .narrative-lead strong {
    color: #e8b84b;
    font-weight: 600;
  }

  .narrative-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin-bottom: 20px;
  }

  .narrative-sub-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .narrative-col {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .narrative-col svg {
    color: #e8b84b;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .narrative-col p {
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .gold-accent-line {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #e8b84b, transparent);
    margin: 0 auto;
    border-radius: 2px;
  }

  /* =========================================
     SHOWCASE BANNER (IMAGE & STANDARDS)
     ========================================= */
  .showcase-banner {
    position: relative;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 72px;
    box-shadow: 0 20px 56px rgba(0, 0, 0, 0.6);
  }

  /* Precision Corner Crosshair Marks */
  .crosshair {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: #C9922A;
    pointer-events: none;
    z-index: 4;
  }
  .crosshair.top-left { top: 8px; left: 8px; border-top: 2px solid; border-left: 2px solid; }
  .crosshair.top-right { top: 8px; right: 8px; border-top: 2px solid; border-right: 2px solid; }
  .crosshair.bottom-left { bottom: 8px; left: 8px; border-bottom: 2px solid; border-left: 2px solid; }
  .crosshair.bottom-right { bottom: 8px; right: 8px; border-bottom: 2px solid; border-right: 2px solid; }

  .showcase-grid {
    display: grid;
    grid-template-columns: 460px 1fr;
    min-height: 400px;
  }

  .showcase-media {
    position: relative;
    background: #080808;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-banner:hover .showcase-img {
    transform: scale(1.04);
  }

  .showcase-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.1) 0%, rgba(10, 10, 10, 0.85) 100%);
  }

  .media-live-chip {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(10, 10, 10, 0.88);
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 6px 14px;
    border-radius: 4px;
    font-family: "Inter", sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #E8B84B;
    z-index: 3;
    backdrop-filter: blur(8px);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8B84B;
    box-shadow: 0 0 8px #E8B84B;
  }

  .showcase-content {
    padding: 38px 42px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-tag {
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #C9922A;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .showcase-heading {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(1.8rem, 2.5vw, 2.3rem);
    letter-spacing: 0.03em;
    color: #FFFFFF;
    margin: 0 0 12px;
    line-height: 1.1;
  }

  .showcase-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 24px;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .cap-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 12px 14px;
    border-radius: 4px;
  }

  .cap-check {
    color: #E8B84B;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cap-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cap-title {
    font-family: "Inter", sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .cap-detail {
    font-family: "Inter", sans-serif;
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.55);
  }

  /* =========================================
     OUR SERVICES (6 SERVICES SUITE)
     ========================================= */
  .services-suite-section {
    margin-bottom: 72px;
  }

  .section-center-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 44px;
  }

  .suite-chip {
    display: inline-block;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #E8B84B;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .suite-title {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    letter-spacing: 0.04em;
    color: #FFFFFF;
    margin: 0 0 10px;
  }

  .suite-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.94rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 20px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .svc-card {
    position: relative;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
  }

  .svc-card:hover {
    transform: translateY(-5px);
    border-color: rgba(201, 146, 42, 0.4);
    box-shadow: 0 20px 52px rgba(0, 0, 0, 0.65), 0 0 24px rgba(201, 146, 42, 0.08);
  }

  .svc-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #e8b84b, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s ease;
  }
  .svc-card:hover .svc-beam {
    transform: scaleX(1);
  }

  .svc-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .svc-num {
    font-family: "Bebas Neue", sans-serif;
    font-size: 1.6rem;
    color: #E8B84B;
    line-height: 1;
  }

  .svc-badge {
    font-family: "Inter", sans-serif;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgba(201, 146, 42, 0.85);
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.2);
    padding: 3px 8px;
    border-radius: 2px;
  }

  .svc-title {
    font-family: "Bebas Neue", "Oswald", sans-serif;
