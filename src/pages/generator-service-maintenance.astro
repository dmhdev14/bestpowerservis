---
import Layout from "../layouts/Layout.astro";

const servicesList = [
  {
    num: "01",
    title: "Preventive Maintenance",
    desc: "Program pemeliharaan berkala terjadwal (bulanan atau per 250/500 jam operasi) mencakup pengecekan multi-titik, pembersihan unit, penggantian filter, dan pelumasan untuk mencegah keausan komponen.",
    badge: "SCHEDULED CARE",
  },
  {
    num: "02",
    title: "Corrective Maintenance",
    desc: "Tindakan perbaikan terencana untuk mengatasi anomali performa mesin, perbaikan kebocoran fluida, rekondisi komponen pendingin radiator, serta penggantian suku cadang yang mengalami penurunan fungsi.",
    badge: "REPAIR & RESTORATION",
  },
  {
    num: "03",
    title: "Generator Troubleshooting",
    desc: "Investigasi diagnostik menyeluruh untuk mengidentifikasi akar masalah saat genset gagal start, mengalami trip proteksi, fluktuasi tegangan, overheating, atau kegagalan sinkronisasi panel.",
    badge: "DIAGNOSTIC EXPERTISE",
  },
  {
    num: "04",
    title: "Engine Inspection & Servicing",
    desc: "Pemeriksaan mekanikal blok mesin diesel dan gas, penyetelan celah katup, inspeksi turbocharger, sistem injeksi bahan bakar, serta pengujian kompresi ruang bakar oleh teknisi berpengalaman.",
    badge: "ENGINE SPECIALIST",
  },
  {
    num: "05",
    title: "Electrical System Inspection",
    desc: "Inspeksi winding alternator, uji resistansi isolasi (megger test), verifikasi modul kontrol ATS/AMF, sensor proteksi darurat, serta kalibrasi sistem pengisian baterai aki generator.",
    badge: "ELECTRICAL & CONTROL",
  },
  {
    num: "06",
    title: "Generator Performance Check",
    desc: "Pengujian beban performa dinamis untuk mengevaluasi stabilitas voltase, regulasi frekuensi, dan respon termal mesin guna memastikan genset beroperasi optimal sesuai rating kapasitas pabrikan.",
    badge: "PERFORMANCE AUDIT",
  },
  {
    num: "07",
    title: "Maintenance Contract Services",
    desc: "Perjanjian kerja sama pemeliharaan jangka panjang (kontrak tahunan) dengan jadwal servis rutin terprogram, prioritas penanganan darurat 24/7, serta logbook pemeliharaan terintegrasi.",
    badge: "ANNUAL CONTRACT (SLA)",
  },
];

const capabilities = [
  {
    label: "Mitigasi Kerusakan Total",
    desc: "Mendeteksi gejala keausan lebih dini sebelum merambat menjadi kerusakan mesin fatal berbiaya besar.",
  },
  {
    label: "Kesiagaan Tanggap Darurat",
    desc: "Dukungan teknisi panggilan darurat untuk merespon gangguan genset fasilitas industri pelanggan.",
  },
  {
    label: "Suku Cadang Berkualitas Tinggi",
    desc: "Jaminan penggunaan filter, pelumas, dan komponen pengganti sesuai standar pabrikan generator.",
  },
  {
    label: "Laporan Servis & Riwayat Log",
    desc: "Dokumentasi teknis transparan mencakup parameter operasi sebelum dan sesudah pelaksanaan servis.",
  },
];
---

<Layout
  title="Generator Service & Maintenance Contracts — PT Best Power Servis"
  description="Layanan servis genset terencana, pemeliharaan berkala, perbaikan darurat, dan kontrak pemeliharaan generator industri oleh teknisi profesional PT Best Power Servis."
>
  <main class="service-page">
    <!-- Ambient Blueprint Grid & Glow -->
    <div class="page-grid-bg"></div>
    <div class="ambient-glow glow-top"></div>
    <div class="ambient-glow glow-side"></div>

    <div class="container relative-z">
      <!-- ========================================================
           BREADCRUMB & HERO HEADER
           ======================================================== -->
      <header class="service-hero anim-fade-in">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">HOME</a>
          <span class="bc-slash">/</span>
          <span class="bc-section">OUR SOLUTIONS</span>
          <span class="bc-slash">/</span>
          <span class="bc-current">GENERATOR SERVICE &amp; MAINTENANCE</span>
        </nav>

        <div class="chip-badge">
          <span class="radar-dot"></span>
          PREVENTIVE &amp; CORRECTIVE MAINTENANCE
        </div>

        <h1 class="service-title">
          GENERATOR SERVICE &amp;{" "}
          <span class="gold-foil">MAINTENANCE CONTRACTS</span>
        </h1>

        <!-- Mandatory Tagline from User Request -->
        <p class="service-tagline">Keeping Power Running.</p>

        <!-- Mandatory Lead Narrative (Verbatim from User) -->
        <div class="service-narrative-card">
          <p class="narrative-lead">
            <strong>PT Best Power Servis</strong> menyediakan layanan servis dan
            pemeliharaan generator set untuk membantu menjaga performa,
            keandalan, dan kesiapan operasional sistem pembangkit listrik
            pelanggan.
          </p>
          <div class="narrative-divider"></div>
          <div class="narrative-sub-grid">
            <div class="narrative-col">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <p>
                Kami memahami bahwa gangguan pada generator dapat berdampak
                langsung terhadap kelangsungan operasional perusahaan. Karena
                itu, BPS menawarkan pendekatan pemeliharaan yang terencana dan
                berorientasi pada pencegahan gangguan.
              </p>
            </div>
            <div class="narrative-col">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                <polyline points="9 12 11 14 15 10"></polyline>
              </svg>
              <p>
                Dengan dukungan tenaga teknis dan pendekatan kerja profesional,
                kami siap membantu kebutuhan perawatan genset untuk berbagai
                sektor industri.
              </p>
            </div>
          </div>
        </div>

        <div class="gold-accent-line"></div>
      </header>

      <!-- ========================================================
           EDITORIAL SHOWCASE: REAL IMAGE & ADVANTAGES
           ======================================================== -->
      <section class="showcase-banner anim-slide-up delay-1">
        <!-- Precision Metallic Corner Crosshairs -->
        <span class="crosshair top-left"></span>
        <span class="crosshair top-right"></span>
        <span class="crosshair bottom-left"></span>
        <span class="crosshair bottom-right"></span>

        <div class="showcase-grid">
          <!-- Left: Real Field Photography -->
          <div class="showcase-media">
            <img
              src="/projects/maintenance.webp"
              alt="Instalasi dan servis pemeliharaan genset industri PT Best Power Servis"
              class="showcase-img"
              width="640"
              height="400"
              loading="eager"
            />
            <div class="showcase-overlay"></div>
            <div class="media-live-chip">
              <span class="live-dot"></span>
              <span>DOKUMENTASI PEMELIHARAAN SISTEM GENSET</span>
            </div>
          </div>

          <!-- Right: Key Technical Standards -->
          <div class="showcase-content">
            <span class="section-tag">PENDEKATAN PEMELIHARAAN TERENCANA</span>
            <h2 class="showcase-heading">
              PERFORMA ANDAL &amp; BEBAS DOWNTIME
            </h2>
            <p class="showcase-desc">
              Dengan jadwal servis terjadwal dan tim teknisi berpengalaman, kami
              memastikan generator cadangan Anda siap mengambil alih beban
              seketika saat listrik utama padam.
            </p>

            <div class="capabilities-grid">
              {capabilities.map((cap) => (
                <div class="cap-item">
                  <div class="cap-check">
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="3"
                    >
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <div class="cap-text">
                    <strong class="cap-title">{cap.label}</strong>
                    <span class="cap-detail">{cap.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ========================================================
           OUR SERVICES SECTION (7 SERVICES AS REQUESTED)
           ======================================================== -->
      <section class="services-suite-section anim-slide-up delay-2">
        <div class="section-center-header">
          <span class="suite-chip">LINGKUP PEMELIHARAAN &amp; SERVIS</span>
          <h2 class="suite-title">OUR SERVICES</h2>
          <p class="suite-desc">
            Spektrum layanan pemeliharaan lengkap dari inspeksi komponen tunggal
            hingga kontrak pemeliharaan tahunan fasilitas industri.
          </p>
          <div class="gold-accent-line"></div>
        </div>

        <div class="services-grid">
          {servicesList.map((svc) => (
            <article class="svc-card">
              <!-- Edge Hover Beam -->
              <div class="svc-beam"></div>

              <div class="svc-card-top">
                <span class="svc-num">{svc.num}</span>
                <span class="svc-badge">{svc.badge}</span>
              </div>

              <h3 class="svc-title">{svc.title}</h3>
              <div class="svc-divider"></div>
              <p class="svc-desc">{svc.desc}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- ========================================================
           CONSULTATION & DIRECT ACTION DOCK
           ======================================================== -->
      <section class="consultation-dock anim-slide-up delay-3">
        <div class="dock-content">
          <span class="dock-chip">KONSULTASI PEMELIHARAAN GENSET</span>
          <h3 class="dock-title">AMANKAN KONTINUITAS DAYA OPERASIONAL ANDA</h3>
          <p class="dock-desc">
            Diskusikan jadwal servis berkala atau paket kontrak pemeliharaan
            (Maintenance Contract Services) bersama tim engineering PT Best
            Power Servis.
          </p>
        </div>
        <div class="dock-actions">
          <a
            href="https://wa.me/628111464967?text=Halo%20PT%20Best%20Power%20Servis,%20saya%20ingin%20konsultasi%20layanan%20Generator%20Service%20%26%20Maintenance."
            target="_blank"
            rel="noopener noreferrer"
            class="dock-btn-whatsapp"
          >
            <span>Konsultasi WhatsApp</span>
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
            >
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a href="/kontak" class="dock-btn-outline">
            Hubungi Kantor Kami
          </a>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  /* =========================================
     PAGE CONTAINER & INDUSTRIAL AMBIENCE
     ========================================= */
  .service-page {
    background-color: #0a0a0a;
    position: relative;
    padding: 120px 0 100px;
    overflow: hidden;
    min-height: 100vh;
  }

  .relative-z {
    position: relative;
    z-index: 1;
  }

  /* Blueprint Grid Pattern */
  .page-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 146, 42, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 146, 42, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    z-index: 0;
  }
  .glow-top {
    top: 8%;
    left: 50%;
    transform: translateX(-50%);
    width: 700px;
    height: 420px;
    background: radial-gradient(
      circle,
      rgba(201, 146, 42, 0.09) 0%,
      transparent 70%
    );
  }
  .glow-side {
    bottom: 20%;
    right: 5%;
    width: 500px;
    height: 450px;
    background: radial-gradient(
      circle,
      rgba(232, 184, 75, 0.05) 0%,
      transparent 70%
    );
  }

  /* =========================================
     HERO & NARRATIVE
     ========================================= */
  .service-hero {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 60px;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .breadcrumb-nav a {
    color: #c9922a;
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    color: #e8b84b;
  }
  .bc-slash {
    color: rgba(255, 255, 255, 0.2);
  }
  .bc-section {
    color: rgba(255, 255, 255, 0.6);
  }
  .bc-current {
    color: rgba(255, 255, 255, 0.9);
  }

  .chip-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    color: #e8b84b;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .radar-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 10px #e8b84b;
    animation: radarPulse 2s infinite ease-in-out;
  }

  @keyframes radarPulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.4);
      opacity: 0.6;
    }
  }

  .service-title {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.05;
    color: #ffffff;
    text-transform: uppercase;
    margin: 0 0 16px;
  }

  .gold-foil {
    background: linear-gradient(135deg, #ffffff 0%, #e8b84b 55%, #c9922a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  /* Tagline */
  .service-tagline {
    font-family: "Inter", sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: #e8b84b;
    text-transform: uppercase;
    margin: 0 0 28px;
  }

  /* Narrative Dossier Card */
  .service-narrative-card {
    background: #111111;
    border: 1px solid rgba(201, 146, 42, 0.22);
    border-left: 4px solid #c9922a;
    border-radius: 4px;
    padding: 28px 32px;
    text-align: left;
    margin-bottom: 30px;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.5);
  }

  .narrative-lead {
    font-family: "Inter", sans-serif;
    font-size: 1.05rem;
    line-height: 1.75;
    color: #ffffff;
    margin: 0 0 20px;
  }

  .narrative-lead strong {
    color: #e8b84b;
    font-weight: 600;
  }

  .narrative-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.08);
    margin-bottom: 20px;
  }

  .narrative-sub-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }

  .narrative-col {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .narrative-col svg {
    color: #e8b84b;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .narrative-col p {
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.72);
    margin: 0;
  }

  .gold-accent-line {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #e8b84b, transparent);
    margin: 0 auto;
    border-radius: 2px;
  }

  /* =========================================
     SHOWCASE BANNER (IMAGE & STANDARDS)
     ========================================= */
  .showcase-banner {
    position: relative;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 72px;
    box-shadow: 0 20px 56px rgba(0, 0, 0, 0.6);
  }

  /* Precision Corner Crosshair Marks */
  .crosshair {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: #c9922a;
    pointer-events: none;
    z-index: 4;
  }
  .crosshair.top-left {
    top: 8px;
    left: 8px;
    border-top: 2px solid;
    border-left: 2px solid;
  }
  .crosshair.top-right {
    top: 8px;
    right: 8px;
    border-top: 2px solid;
    border-right: 2px solid;
  }
  .crosshair.bottom-left {
    bottom: 8px;
    left: 8px;
    border-bottom: 2px solid;
    border-left: 2px solid;
  }
  .crosshair.bottom-right {
    bottom: 8px;
    right: 8px;
    border-bottom: 2px solid;
    border-right: 2px solid;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: 460px 1fr;
    min-height: 400px;
  }

  .showcase-media {
    position: relative;
    background: #080808;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
    overflow: hidden;
  }

  .showcase-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .showcase-banner:hover .showcase-img {
    transform: scale(1.04);
  }

  .showcase-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.1) 0%,
      rgba(10, 10, 10, 0.85) 100%
    );
  }

  .media-live-chip {
    position: absolute;
    top: 16px;
    left: 16px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(10, 10, 10, 0.88);
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 6px 14px;
    border-radius: 4px;
    font-family: "Inter", sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #e8b84b;
    z-index: 3;
    backdrop-filter: blur(8px);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 8px #e8b84b;
  }

  .showcase-content {
    padding: 38px 42px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-tag {
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: #c9922a;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .showcase-heading {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(1.8rem, 2.5vw, 2.3rem);
    letter-spacing: 0.03em;
    color: #ffffff;
    margin: 0 0 12px;
    line-height: 1.1;
  }

  .showcase-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.9rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 24px;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .cap-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    padding: 12px 14px;
    border-radius: 4px;
  }

  .cap-check {
    color: #e8b84b;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .cap-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cap-title {
    font-family: "Inter", sans-serif;
    font-size: 0.84rem;
    font-weight: 700;
    color: #ffffff;
  }

  .cap-detail {
    font-family: "Inter", sans-serif;
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.55);
  }

  /* =========================================
     OUR SERVICES (7 SERVICES SUITE)
     ========================================= */
  .services-suite-section {
    margin-bottom: 72px;
  }

  .section-center-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 44px;
  }

  .suite-chip {
    display: inline-block;
    font-family: "Inter", sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #e8b84b;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 12px;
    text-transform: uppercase;
  }

  .suite-title {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    letter-spacing: 0.04em;
    color: #ffffff;
    margin: 0 0 10px;
  }

  .suite-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.94rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.65);
    margin: 0 0 20px;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* Special treatment for 7th card to span cleanly or align */
  .svc-card:last-child {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, #141414 0%, #111111 100%);
    border-color: rgba(201, 146, 42, 0.28);
  }

  .svc-card {
    position: relative;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
    transition:
      transform 0.35s ease,
      border-color 0.35s ease,
