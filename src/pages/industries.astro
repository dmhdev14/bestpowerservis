---
import Layout from '../layouts/Layout.astro';

const sectors = [
  {
    num: '01',
    code: 'DATA CENTER',
    tag: 'CRITICAL POWER & COMMISSIONING',
    title: 'Data Center',
    image: '/industries/industry-datacenter.webp',
    imageAlt: 'Ruang Server Data Center dengan rak server dan overhead cable tray',
    statement:
      'Dukungan Loadbank Rental dan Testing Services untuk kebutuhan pengujian UPS, generator, commissioning, dan critical power infrastructure.',
    tags: [
      'Loadbank Rental & Testing',
      'UPS & Generator Commissioning',
      'Validasi Standar Tier II – Tier IV'
    ]
  },
  {
    num: '02',
    code: 'MINING & HEAVY EQUIPMENT',
    tag: 'HEAVY FLEET & FLUID PURIFICATION',
    title: 'Mining & Heavy Equipment',
    image: '/industries/industry-mining.webp',
    imageAlt: 'Area tambang terbuka dengan ekskavator hidrolik tambang dan dump truck',
    statement:
      'Solusi Fuel Filtration System serta layanan pemeliharaan genset untuk mendukung operasional pertambangan dan peralatan berat.',
    tags: [
      'Fuel Filtration System (B35 / B40)',
      'Hemat Filter Mesin s/d 50% vs OEM',
      'Pemeliharaan Genset Tambang Siaga'
    ]
  },
  {
    num: '03',
    code: 'MANUFACTURING & INDUSTRIAL',
    tag: 'CONTINUOUS PRODUCTION UPTIME',
    title: 'Manufacturing & Industrial Facilities',
    image: '/industries/industry-manufacturing.webp',
    imageAlt: 'Ruang genset pembangkit daya industri manufaktur dengan pipa ducting perak',
    statement:
      'Dukungan pengujian sistem kelistrikan, pengelolaan kualitas bahan bakar, serta pemeliharaan generator untuk kebutuhan fasilitas industri.',
    tags: [
      'Audit Sistem Kelistrikan Pabrik',
      'Pemurnian Solar Tangki Harian',
      'Preventive Maintenance Siaga 24 Jam'
    ]
  }
];
---

<Layout
  title="Industries — PT Best Power Servis | Solusi Sektor Strategis"
  description="Solusi energi dan sistem filtrasi industri untuk Data Center, Mining & Heavy Equipment, serta Manufacturing & Industrial Facilities di seluruh Indonesia."
>
  <div class="industries-page">
    <!-- Ambient Backdrop Effects -->
    <div class="ind-grid-bg"></div>
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>

    <div class="container relative-z">
      <!-- ========================================================
           CLEAN LUXURY HERO HEADER (MINIMAL & IMPACTFUL)
           ======================================================== -->
      <header class="ind-hero anim-fade-in">
        <nav class="breadcrumb-nav" aria-label="Breadcrumb">
          <a href="/">HOME</a>
          <span class="bc-slash">/</span>
          <span class="bc-current">INDUSTRIES</span>
        </nav>

        <div class="chip-badge anim-pulse-badge">
          <span class="radar-dot"></span>
          SEKTOR INDUSTRI STRATEGIS
        </div>

        <h1 class="ind-title">
          SOLUSI TEKNIS UNTUK <span class="gold-foil">SEKTOR STRATEGIS</span>
        </h1>

        <p class="ind-lead">
          <strong>PT Best Power Servis</strong> memahami bahwa setiap sektor industri memiliki kebutuhan teknis dan tantangan operasional yang berbeda. Kami menyediakan solusi yang disesuaikan dengan kebutuhan pelanggan untuk mendukung keandalan sistem dan keberlangsungan operasional.
        </p>

        <div class="gold-accent-line"></div>
      </header>

      <!-- ========================================================
           3 CINEMATIC INDUSTRY SHOWCASES (PUNCHY & VISUAL-FIRST)
           ======================================================== -->
      <div class="cinematic-showcase-stack">
        {sectors.map((sec, i) => (
          <article class={`cinematic-card anim-slide-up delay-${i + 1} ${i % 2 === 1 ? 'reverse-card' : ''}`}>
            <!-- Animated Edge Beam -->
            <div class="card-beam-glow"></div>

            <!-- Precision Metallic Corner Marks -->
            <span class="crosshair top-left"></span>
            <span class="crosshair top-right"></span>
            <span class="crosshair bottom-left"></span>
            <span class="crosshair bottom-right"></span>

            <div class="card-layout">
              <!-- Visual Image Stage (Cinematic Aspect Ratio) -->
              <div class="card-media-stage">
                <img
                  src={sec.image}
                  alt={sec.imageAlt}
                  class="stage-img"
                  width="720"
                  height="450"
                  loading="lazy"
                  decoding="async"
                />
                <div class="stage-overlay"></div>
                
                <!-- Huge Watermark Index -->
                <span class="stage-watermark">{sec.num}</span>

                <!-- Live Industrial Chip -->
                <div class="stage-chip">
                  <span class="live-dot"></span>
                  <span>{sec.tag}</span>
                </div>
              </div>

              <!-- Content Stage: Concise, Bold & Direct -->
              <div class="card-content-stage">
                <!-- Top Indicator -->
                <div class="stage-meta">
                  <span class="meta-num">{sec.num}</span>
                  <span class="meta-sep">/</span>
                  <span class="meta-code">{sec.code}</span>
                </div>

                <!-- Sector Title -->
                <h2 class="sector-title">{sec.title}</h2>

                <!-- Core Mandate Statement (Highlighted & Concise) -->
                <div class="statement-card">
                  <p class="statement-text">
                    "{sec.statement}"
                  </p>
                </div>

                <!-- Scope Tags (Clean & Fast Scanning) -->
                <div class="tags-row">
                  {sec.tags.map(tag => (
                    <span class="scope-tag">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                      {tag}
                    </span>
                  ))}
                </div>

              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- ========================================================
           MINIMAL LUXURY CONSULTATION DOCK
           ======================================================== -->
      <section class="consultation-dock anim-slide-up delay-4">
        <div class="dock-content">
          <div class="dock-badge">KONSULTASI SPESIFIKASI INDUSTRI</div>
          <h3 class="dock-title">BUTUH SOLUSI TEKNIS KHUSUS UNTUK FASILITAS ANDA?</h3>
          <p class="dock-desc">
            Diskusikan kebutuhan kapasitas loadbank, purifikasi bahan bakar, atau jadwal pemeliharaan genset dengan tim rekayasa kami.
          </p>
        </div>
        <div class="dock-actions">
          <a
            href="https://wa.me/628111464967?text=Halo%20PT%20Best%20Power%20Servis,%20saya%20ingin%20konsultasi%20solusi%20untuk%20sektor%20industri%20kami."
            target="_blank"
            rel="noopener noreferrer"
            class="dock-btn-whatsapp"
          >
            <span>Konsultasi WhatsApp</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="/kontak" class="dock-btn-outline">
            Hubungi Kantor Kami
          </a>
        </div>
      </section>

    </div>
  </div>
</Layout>

<style>
  /* =========================================
     PAGE BACKDROP & ATMOSPHERE
     ========================================= */
  .industries-page {
    background-color: #0A0A0A;
    position: relative;
    padding: 120px 0 100px;
    overflow: hidden;
    min-height: 100vh;
  }

  .relative-z {
    position: relative;
    z-index: 1;
  }

  /* Subtle Blueprint Grid */
  .ind-grid-bg {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(201, 146, 42, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201, 146, 42, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
    z-index: 0;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
    filter: blur(100px);
    z-index: 0;
  }
  .glow-1 {
    top: 10%;
    left: 50%;
    transform: translateX(-50%);
    width: 650px;
    height: 400px;
    background: radial-gradient(circle, rgba(201, 146, 42, 0.09) 0%, transparent 70%);
  }
  .glow-2 {
    bottom: 15%;
    right: 5%;
    width: 500px;
    height: 450px;
    background: radial-gradient(circle, rgba(232, 184, 75, 0.05) 0%, transparent 70%);
  }

  /* =========================================
     HERO SECTION
     ========================================= */
  .ind-hero {
    text-align: center;
    max-width: 860px;
    margin: 0 auto 60px;
  }

  .breadcrumb-nav {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 20px;
    text-transform: uppercase;
  }

  .breadcrumb-nav a {
    color: #c9922a;
    transition: color 0.2s ease;
    text-decoration: none;
  }
  .breadcrumb-nav a:hover {
    color: #e8b84b;
  }
  .bc-slash { color: rgba(255, 255, 255, 0.2); }
  .bc-current { color: rgba(255, 255, 255, 0.85); }

  .chip-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 100px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    color: #e8b84b;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .radar-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 10px #e8b84b;
    animation: radarPulse 2s infinite ease-in-out;
  }

  @keyframes radarPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .ind-title {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(2.4rem, 5vw, 4.4rem);
    font-weight: 700;
    letter-spacing: 0.03em;
    line-height: 1.05;
    color: #ffffff;
    text-transform: uppercase;
    margin: 0 0 22px;
  }

  .gold-foil {
    background: linear-gradient(135deg, #ffffff 0%, #e8b84b 55%, #c9922a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .ind-lead {
    font-family: "Inter", sans-serif;
    font-size: 1.02rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.72);
    margin: 0 auto 30px;
    max-width: 820px;
  }

  .ind-lead strong {
    color: #e8b84b;
    font-weight: 600;
  }

  .gold-accent-line {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #e8b84b, transparent);
    margin: 0 auto;
    border-radius: 2px;
  }

  /* =========================================
     CINEMATIC CARDS STACK
     ========================================= */
  .cinematic-showcase-stack {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-bottom: 64px;
  }

  .cinematic-card {
    position: relative;
    background: #111111;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.55);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease,
                box-shadow 0.4s ease;
  }

  .cinematic-card:hover {
    transform: translateY(-5px);
    border-color: rgba(201, 146, 42, 0.38);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75), 0 0 28px rgba(201, 146, 42, 0.08);
  }

  /* Animated Top Gold Beam */
  .card-beam-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #e8b84b, #c9922a, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
  }
  .cinematic-card:hover .card-beam-glow {
    transform: scaleX(1);
  }

  /* Precision Corner Crosshair Marks */
  .crosshair {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: #C9922A;
    pointer-events: none;
    z-index: 4;
    transition: all 0.3s ease;
  }
  .crosshair.top-left { top: 8px; left: 8px; border-top: 2px solid; border-left: 2px solid; }
  .crosshair.top-right { top: 8px; right: 8px; border-top: 2px solid; border-right: 2px solid; }
  .crosshair.bottom-left { bottom: 8px; left: 8px; border-bottom: 2px solid; border-left: 2px solid; }
  .crosshair.bottom-right { bottom: 8px; right: 8px; border-bottom: 2px solid; border-right: 2px solid; }

  .cinematic-card:hover .crosshair {
    border-color: #e8b84b;
    width: 16px;
    height: 16px;
  }

  /* 2-Column Responsive Layout */
  .card-layout {
    display: grid;
    grid-template-columns: 480px 1fr;
    min-height: 420px;
  }

  /* Alternating Zig-Zag Layout: Kiri, Kanan, Kiri */
  .cinematic-card.reverse-card .card-layout {
    grid-template-columns: 1fr 480px;
  }
  .cinematic-card.reverse-card .card-media-stage {
    order: 2;
    border-right: none;
    border-left: 1px solid rgba(255, 255, 255, 0.06);
  }
  .cinematic-card.reverse-card .card-content-stage {
    order: 1;
  }

  /* Media Stage */
  .card-media-stage {
    position: relative;
    background: #080808;
    overflow: hidden;
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
  }

  .cinematic-card:hover .stage-img {
    transform: scale(1.06);
    filter: brightness(1.05) contrast(1.05);
  }

  .stage-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 10, 0.1) 0%,
      rgba(10, 10, 10, 0.4) 60%,
      rgba(10, 10, 10, 0.95) 100%
    );
  }

  .stage-watermark {
    position: absolute;
    bottom: -15px;
    right: 16px;
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: 6rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.05);
    pointer-events: none;
    z-index: 2;
  }

  .stage-chip {
    position: absolute;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(10, 10, 10, 0.88);
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 6px 14px;
    border-radius: 4px;
    font-family: "Inter", sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: #E8B84B;
    z-index: 3;
    backdrop-filter: blur(8px);
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8B84B;
    box-shadow: 0 0 8px #E8B84B;
  }

  /* Content Stage */
  .card-content-stage {
    padding: 38px 42px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .stage-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "Inter", sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #C9922A;
    margin-bottom: 10px;
  }

  .meta-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.15rem;
    color: #E8B84B;
  }
  .meta-sep { color: rgba(255, 255, 255, 0.2); }
  .meta-code { color: #A3A3A3; }

  .sector-title {
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: clamp(2rem, 2.6vw, 2.5rem);
    letter-spacing: 0.03em;
    color: #FFFFFF;
    margin: 0 0 18px;
    line-height: 1.1;
  }

  /* Core Mandate Statement Box */
  .statement-card {
    background: rgba(201, 146, 42, 0.05);
    border: 1px solid rgba(201, 146, 42, 0.2);
    border-left: 3px solid #E8B84B;
    padding: 16px 20px;
    border-radius: 4px;
    margin-bottom: 22px;
  }

  .statement-text {
    font-family: "Inter", sans-serif;
    font-size: 0.94rem;
    line-height: 1.65;
    color: #FFFFFF;
    font-weight: 500;
    margin: 0;
  }

  /* Scope Tags */
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 0;
  }

  .scope-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 6px 14px;
    border-radius: 4px;
    font-family: "Inter", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    transition: all 0.25s ease;
  }

  .scope-tag svg {
    color: #E8B84B;
  }

  .cinematic-card:hover .scope-tag {
    border-color: rgba(201, 146, 42, 0.3);
    background: rgba(201, 146, 42, 0.06);
  }

  /* =========================================
     CONSULTATION DOCK (SLEEK & COMPACT)
     ========================================= */
  .consultation-dock {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    background: #111111;
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-left: 4px solid #C9922A;
    padding: 32px 38px;
    border-radius: 4px;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.4);
  }

  .dock-content {
    max-width: 640px;
  }

  .dock-badge {
    font-family: "Inter", sans-serif;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #E8B84B;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .dock-title {
    font-family: "Bebas Neue", "Oswald", sans-serif;
    font-size: clamp(1.6rem, 2.2vw, 2.2rem);
    color: #FFFFFF;
    margin: 0 0 8px;
    letter-spacing: 0.03em;
    line-height: 1.1;
  }

  .dock-desc {
    font-family: "Inter", sans-serif;
    font-size: 0.88rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  .dock-actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-shrink: 0;
    min-width: 220px;
  }

  .dock-btn-whatsapp {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background: #C9922A;
    color: #0A0A0A;
    padding: 12px 20px;
    border-radius: 4px;
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .dock-btn-whatsapp:hover {
    background: #E8B84B;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(201, 146, 42, 0.35);
  }

  .dock-btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.8);
    padding: 11px 18px;
    border-radius: 4px;
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
  }
  .dock-btn-outline:hover {
    border-color: rgba(201, 146, 42, 0.45);
    color: #FFFFFF;
    background: rgba(201, 146, 42, 0.06);
  }

  /* =========================================
     SMOOTH ANIMATIONS (DESKTOP & ACCELERATED)
     ========================================= */
  .anim-fade-in {
    animation: fadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .anim-slide-up {
    opacity: 0;
    transform: translateY(24px);
    animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .delay-1 { animation-delay: 0.15s; }
  .delay-2 { animation-delay: 0.3s; }
  .delay-3 { animation-delay: 0.45s; }
  .delay-4 { animation-delay: 0.6s; }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =========================================
     RESPONSIVE BREAKPOINTS & MOBILE ZERO-DELAY
     ========================================= */
  @media (max-width: 1024px) {
    .card-layout,
    .cinematic-card.reverse-card .card-layout {
      grid-template-columns: 1fr;
    }
    .card-media-stage,
    .cinematic-card.reverse-card .card-media-stage {
      order: 1;
      border-right: none;
      border-left: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      height: 280px;
    }
    .card-content-stage,
    .cinematic-card.reverse-card .card-content-stage {
      order: 2;
      padding: 30px 24px;
    }
    .consultation-dock {
      flex-direction: column;
      align-items: stretch;
      gap: 22px;
      padding: 24px;
    }
    .dock-actions {
      min-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .industries-page {
      padding: 95px 0 65px;
    }
    .ind-hero {
      margin-bottom: 36px;
    }
    .cinematic-showcase-stack {
      gap: 24px;
      margin-bottom: 40px;
    }
    .card-media-stage {
      height: 220px;
    }
    .card-content-stage {
      padding: 22px 18px;
    }
    .sector-title {
      font-size: 1.8rem;
      margin-bottom: 14px;
    }
    .statement-card {
      padding: 12px 14px;
      margin-bottom: 18px;
    }
    .statement-text {
      font-size: 0.88rem;
      line-height: 1.6;
    }
    .tags-row {
      gap: 8px;
      margin-bottom: 0;
