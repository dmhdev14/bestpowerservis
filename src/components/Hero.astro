---
---

<section id="hero">
  <!-- Background Layers -->
  <div class="hero-bg">
    <!-- Cinematic Industrial Image Background -->
    <div class="hero-image-wrap">
      <img
        src="/hero-bg.webp"
        alt="PT Best Power Servis Industrial Machinery"
        class="hero-bg-image"
        width="1024"
        height="572"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-image-overlay"></div>
    </div>

    <!-- Noise + Hex Pattern + Energy Orbs -->
    <div class="hex-pattern"></div>
    <div class="hero-gradient-orb orb-1"></div>
    <div class="hero-gradient-orb orb-2"></div>
    <div class="hero-grid"></div>
  </div>

  <!-- Canvas Particles -->
  <canvas id="particleCanvas"></canvas>

  <!-- Content -->
  <div class="hero-content">
    <div class="hero-badge reveal">
      <span class="badge-dot"></span>
      Solusi Industri Terpercaya
    </div>

    <h1 class="hero-title reveal delay-100">
      <span class="title-line-1">BEST POWER</span>
      <span class="title-line-2">SERVIS</span>
    </h1>

    <p class="hero-tagline reveal delay-200">
      Solusi Energi &amp; Filtrasi Terbaik
      <br />
      <em>untuk Industri Anda</em>
    </p>

    <p class="hero-desc reveal delay-300">
      Menyediakan rental genset, service perawatan, suku cadang berkualitas, serta sistem filtrasi canggih yang meningkatkan efisiensi operasional industri Anda di seluruh Indonesia.
    </p>

    <div class="hero-cta reveal delay-400">
      <a href="/layanan" class="btn btn-gold">
        Lihat Layanan Kami
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href="/kontak" class="btn btn-outline">
        Konsultasi Gratis
      </a>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #0A0A0A;
  }

  /* Background layers */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  /* Cinematic Industrial Image Background */
  .hero-image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .hero-bg-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.68;
    filter: brightness(0.98) contrast(1.12) saturate(1.15);
    transform: scale(1.02);
    animation: heroSlowZoom 24s ease-in-out infinite alternate;
  }

  @keyframes heroSlowZoom {
    0% { transform: scale(1.02) translateY(0); }
    100% { transform: scale(1.08) translateY(-8px); }
  }

  .hero-image-overlay {
    position: absolute;
    inset: 0;
    background:
      /* Softer center vignette so the industrial machinery details are clearly visible */
      radial-gradient(ellipse at 50% 50%, rgba(10, 10, 10, 0.38) 0%, rgba(10, 10, 10, 0.62) 65%, rgba(10, 10, 10, 0.85) 100%),
      /* Top & bottom gentle gradient to blend with navbar and next section */
      linear-gradient(to bottom, rgba(10, 10, 10, 0.82) 0%, rgba(10, 10, 10, 0.15) 20%, rgba(10, 10, 10, 0.15) 70%, rgba(11, 11, 11, 0.88) 90%, #0D0D0D 100%);
    pointer-events: none;
  }

  .hero-gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    pointer-events: none;
    z-index: 1;
  }

  .orb-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(201,146,42,0.12) 0%, transparent 70%);
    top: -100px;
    right: -100px;
    animation: orbFloat 8s ease-in-out infinite;
  }

  .orb-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(201,146,42,0.07) 0%, transparent 70%);
    bottom: 0;
    left: -100px;
    animation: orbFloat 10s ease-in-out infinite reverse;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 1;
    background-image:
      linear-gradient(rgba(201,146,42,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201,146,42,0.04) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
  }

  #particleCanvas {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 3;
    text-align: center;
    max-width: 860px;
    padding: 130px 40px 90px;
    margin: 0 auto;
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 18px;
    background: rgba(10, 10, 10, 0.65);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(201, 146, 42, 0.35);
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 600;
    color: #E8B84B;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 28px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    background: #E8B84B;
    border-radius: 50%;
    box-shadow: 0 0 8px #E8B84B;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  /* Title */
  .hero-title {
    margin-bottom: 20px;
    line-height: 0.95;
  }

  .title-line-1,
  .title-line-2 {
    display: block;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3.8rem, 9.5vw, 7.5rem);
    letter-spacing: 0.04em;
    line-height: 0.95;
  }

  .title-line-1 {
    color: #FFFFFF;
    text-shadow: 0 4px 24px rgba(0,0,0,0.95), 0 2px 8px rgba(0,0,0,0.9);
  }

  .title-line-2 {
    color: #C9922A;
    background: linear-gradient(135deg, #FFFFFF 0%, #E8B84B 40%, #C9922A 80%, #7A5C1E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 4px 25px rgba(0,0,0,0.95)) drop-shadow(0 4px 35px rgba(201,146,42,0.45));
  }

  /* Tagline & Desc */
  .hero-tagline {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.2rem, 2.5vw, 1.75rem);
    font-weight: 400;
    color: rgba(255,255,255,0.95);
    margin-bottom: 18px;
    line-height: 1.4;
    text-shadow: 0 3px 16px rgba(0,0,0,0.95), 0 1px 4px rgba(0,0,0,0.85);
  }

  .hero-tagline em {
    font-style: italic;
    color: #E8B84B;
    text-shadow: 0 0 20px rgba(232, 184, 75, 0.4);
  }

  .hero-desc {
    font-size: clamp(0.9rem, 1.5vw, 1.05rem);
    line-height: 1.75;
    color: rgba(255,255,255,0.82);
    max-width: 620px;
    margin: 0 auto 36px;
    text-shadow: 0 2px 14px rgba(0,0,0,0.95), 0 1px 3px rgba(0,0,0,0.9);
  }

  /* CTA Buttons */
  .hero-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, 20px) scale(1.05); }
  }

  @media (max-width: 600px) {
    #hero {
      min-height: 100svh;
      padding-top: 76px;
      padding-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .hero-bg-image {
      opacity: 0.65;
    }
    .hero-content {
      padding: 16px 16px 20px;
      width: 100%;
    }
    .hero-badge {
      margin-bottom: 14px;
      font-size: 0.68rem;
      padding: 5px 12px;
      letter-spacing: 0.08em;
    }
    .hero-title {
      margin-bottom: 12px;
      line-height: 0.95;
    }
    .title-line-1,
    .title-line-2 {
      font-size: clamp(2.6rem, 12vw, 3.8rem);
      line-height: 0.95;
    }
    .hero-tagline {
      font-size: 1.05rem;
      line-height: 1.45;
      margin-bottom: 12px;
    }
    .hero-desc {
      font-size: 0.84rem;
      line-height: 1.6;
      margin-bottom: 22px;
      max-width: 320px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-cta {
      flex-direction: column;
      gap: 10px;
      width: 100%;
      max-width: 290px;
      margin: 0 auto;
    }
    .hero-cta .btn {
      width: 100%;
      justify-content: center;
      padding: 12px 18px;
      min-height: 44px;
      font-size: 0.88rem;
    }
  }
</style>

<script>
  // Gold particle system with mobile optimization & pause offscreen
  const canvas = document.getElementById('particleCanvas') as HTMLCanvasElement | null;
  const ctx = canvas ? canvas.getContext('2d') : null;

  if (canvas && ctx) {
    let W = canvas.width = window.innerWidth;
    let H = canvas.height = window.innerHeight;
    let isVisible = true;

    window.addEventListener('resize', () => {
      W = canvas.width = window.innerWidth;
      H = canvas.height = window.innerHeight;
    });

    const isMobile = window.innerWidth <= 600;
    const PARTICLE_COUNT = isMobile ? 25 : 55;

    interface Particle {
      x: number; y: number; vx: number; vy: number;
      size: number; opacity: number; life: number; maxLife: number;
    }
    const particles: Particle[] = [];

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      particles.push({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: (Math.random() - 0.5) * 0.4,
        vy: (Math.random() - 0.5) * 0.4 - 0.1,
        size: Math.random() * 2 + 0.5,
        opacity: Math.random() * 0.5 + 0.1,
        life: Math.random() * 200,
        maxLife: 200 + Math.random() * 100,
      });
    }

    const heroSection = document.getElementById('hero');
    if (heroSection && 'IntersectionObserver' in window) {
      const heroObserver = new IntersectionObserver((entries) => {
        isVisible = entries[0].isIntersecting;
      }, { threshold: 0.05 });
      heroObserver.observe(heroSection);
    }

    function drawParticles() {
      if (isVisible) {
        ctx!.clearRect(0, 0, W, H);
        particles.forEach((p: Particle) => {
          p.life++;
          if (p.life > p.maxLife) {
            p.life = 0;
            p.x = Math.random() * W;
            p.y = H + 10;
          }
          const progress = p.life / p.maxLife;
          const fade = progress < 0.2 ? progress / 0.2 : progress > 0.8 ? (1 - progress) / 0.2 : 1;
          p.x += p.vx;
          p.y += p.vy;
          ctx!.beginPath();
          ctx!.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx!.fillStyle = `rgba(201, 146, 42, ${p.opacity * fade})`;
          ctx!.fill();
        });
      }
      requestAnimationFrame(drawParticles);
    }

    drawParticles();
  }
</script>
