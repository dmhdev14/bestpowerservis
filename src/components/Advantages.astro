---

<section id="keunggulan" class="section section-darker">
  <div class="hex-pattern"></div>
  <div class="container" style="position: relative; z-index: 1;">

    <div class="adv-header">
      <div class="section-label reveal">Keunggulan Kami</div>
      <h2 class="section-title reveal delay-100">MENGAPA MEMILIH<br/>BEST POWER SERVIS?</h2>
      <p class="section-desc reveal delay-200">
        Kami hadir bukan hanya sebagai vendor, tetapi sebagai mitra strategis yang berkomitmen penuh terhadap keberhasilan operasional industri Anda.
      </p>
    </div>

    <div class="adv-grid">
      {advantages.map((a, i) => (
        <div class={`adv-card reveal delay-${((i % 3) + 1) * 100}`}>
          <div class="adv-card-icon" set:html={a.icon}></div>
          <h3 class="adv-card-title">{a.title}</h3>
          <p class="adv-card-desc">{a.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Keunggulan */
  #keunggulan { background: #111; }

  .adv-header {
    max-width: 640px;
    margin-bottom: 60px;
  }

  .adv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .adv-card {
    background: #181818;
    border: 1px solid rgba(201, 146, 42, 0.12);
    border-radius: 16px;
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.35s ease;
    cursor: default;
  }

  .adv-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(201,146,42,0.05), transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .adv-card:hover {
    border-color: rgba(201, 146, 42, 0.38);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.45);
  }

  .adv-card:hover::after { opacity: 1; }

  .adv-card-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.22);
    border-radius: 14px;
    color: #E8B84B;
    margin-bottom: 22px;
    position: relative;
    z-index: 1;
    transition: all 0.35s ease;
  }

  .adv-card:hover .adv-card-icon {
    background: rgba(201, 146, 42, 0.16);
    border-color: rgba(232, 184, 75, 0.48);
    box-shadow: 0 0 22px rgba(201,146,42,0.18);
    color: #F5C658;
    transform: scale(1.04);
  }

  .adv-card-title {
    font-size: 1.04rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }

  .adv-card-desc {
    font-size: 0.88rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.55);
    position: relative;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .adv-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .adv-header { margin-bottom: 28px; }
    .adv-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .adv-card { padding: 20px 14px; border-radius: 12px; }
    .adv-card-icon { width: 48px; height: 48px; margin-bottom: 12px; border-radius: 11px; }
    .adv-card-icon :global(svg) { width: 28px; height: 28px; }
    .adv-card-title { font-size: 0.94rem; margin-bottom: 6px; }
    .adv-card-desc { font-size: 0.78rem; line-height: 1.5; color: rgba(255,255,255,0.6); }
  }
</style>
