---
const advantages = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Kualitas Terjamin',
    desc: 'Produk dan layanan kami berasal dari principal terpercaya dengan standar internasional yang ketat.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M8.46 8.46a5 5 0 0 0 0 7.07"/></svg>`,
    title: 'Teknologi Inovatif',
    desc: 'Menggunakan teknologi filtrasi terbaru untuk meningkatkan efisiensi bahan bakar dan performa peralatan.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Layanan Profesional',
    desc: 'Tim teknisi dan ahli berpengalaman siap memberikan konsultasi serta solusi terbaik untuk kebutuhan Anda.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: 'Jaringan Luas',
    desc: 'Didukung sistem distribusi yang luas untuk memastikan ketersediaan produk dan layanan di seluruh Indonesia.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 22V12C2 6.48 6.48 2 12 2s10 4.48 10 10v10"/><path d="M12 12v.01"/><path d="M7.5 15.5l-2 2.5"/><path d="M16.5 15.5l2 2.5"/></svg>`,
    title: 'Efisiensi & Keberlanjutan',
    desc: 'Berkontribusi dalam pengurangan limbah, peningkatan efisiensi energi, dan operasional yang lebih ramah lingkungan.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    title: 'Kepuasan Pelanggan',
    desc: 'Memberikan layanan responsif, cepat, dan tepat guna untuk memenuhi kebutuhan klien dengan sepenuh hati.',
  },
];
---

<section id="keunggulan" class="section section-darker">
  <div class="hex-pattern"></div>
  <div class="container" style="position: relative; z-index: 1;">

    <div class="adv-header">
      <div class="section-label reveal">Keunggulan Kami</div>
      <h2 class="section-title reveal delay-100">MENGAPA MEMILIH<br/>BEST POWER SERVIS?</h2>
      <p class="section-desc reveal delay-200">
        Kami hadir bukan hanya sebagai vendor, tetapi sebagai mitra strategis yang berkomitmen penuh terhadap keberhasilan operasional industri Anda.
      </p>
    </div>

    <div class="adv-grid">
      {advantages.map((a, i) => (
        <div class={`adv-card reveal delay-${((i % 3) + 1) * 100}`}>
          <div class="adv-card-icon" set:html={a.icon}></div>
          <h3 class="adv-card-title">{a.title}</h3>
          <p class="adv-card-desc">{a.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  /* Keunggulan */
  #keunggulan { background: #111; }

  .adv-header {
    max-width: 640px;
    margin-bottom: 60px;
  }

  .adv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .adv-card {
    background: #181818;
    border: 1px solid rgba(201, 146, 42, 0.1);
    border-radius: 16px;
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.35s ease;
    cursor: default;
  }

  .adv-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(201,146,42,0.04), transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .adv-card:hover {
    border-color: rgba(201, 146, 42, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }

  .adv-card:hover::after { opacity: 1; }

  .adv-card-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(201, 146, 42, 0.08);
    border-radius: 14px;
    color: #C9922A;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    transition: all 0.35s ease;
  }

  .adv-card:hover .adv-card-icon {
    background: rgba(201, 146, 42, 0.15);
    box-shadow: 0 0 20px rgba(201,146,42,0.15);
    color: #E8B84B;
  }

  .adv-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }

  .adv-card-desc {
    font-size: 0.88rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.5);
    position: relative;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .adv-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .adv-header { margin-bottom: 28px; }
    .adv-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .adv-card { padding: 20px 14px; border-radius: 12px; }
    .adv-card-icon { width: 38px; height: 38px; margin-bottom: 12px; border-radius: 10px; }
    .adv-card-icon :global(svg) { width: 20px; height: 20px; }
    .adv-card-title { font-size: 0.95rem; margin-bottom: 6px; }
    .adv-card-desc { font-size: 0.78rem; line-height: 1.5; color: rgba(255,255,255,0.6); }
  }
</style>
