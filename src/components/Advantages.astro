---
const advantages = [
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    title: 'Kualitas Terjamin',
    desc: 'Produk dan layanan kami berasal dari principal terpercaya dengan standar internasional yang ketat.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07M8.46 8.46a5 5 0 0 0 0 7.07"/></svg>`,
    title: 'Teknologi Inovatif',
    desc: 'Menggunakan teknologi filtrasi terbaru untuk meningkatkan efisiensi bahan bakar dan performa peralatan.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: 'Layanan Profesional',
    desc: 'Tim teknisi dan ahli berpengalaman siap memberikan konsultasi serta solusi terbaik untuk kebutuhan Anda.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: 'Jaringan Luas',
    desc: 'Didukung sistem distribusi yang luas untuk memastikan ketersediaan produk dan layanan di seluruh Indonesia.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 22V12C2 6.48 6.48 2 12 2s10 4.48 10 10v10"/><path d="M12 12v.01"/><path d="M7.5 15.5l-2 2.5"/><path d="M16.5 15.5l2 2.5"/></svg>`,
    title: 'Efisiensi & Keberlanjutan',
    desc: 'Berkontribusi dalam pengurangan limbah, peningkatan efisiensi energi, dan operasional yang lebih ramah lingkungan.',
  },
  {
    icon: `<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
    title: 'Kepuasan Pelanggan',
    desc: 'Memberikan layanan responsif, cepat, dan tepat guna untuk memenuhi kebutuhan klien dengan sepenuh hati.',
  },
];
---

<section id="keunggulan" class="section section-dark">
  <div class="hex-pattern"></div>
  <div class="container" style="position: relative; z-index: 1;">

    <div class="adv-header">
      <div class="section-label reveal">Keunggulan Kami</div>
      <h2 class="section-title reveal delay-100">MENGAPA MEMILIH<br/>BEST POWER SERVIS?</h2>
      <p class="section-desc reveal delay-200">
        Kami hadir bukan hanya sebagai vendor, tetapi sebagai mitra strategis yang berkomitmen penuh terhadap keberhasilan operasional industri Anda.
      </p>
    </div>

    <div class="adv-grid">
      {advantages.map((a, i) => (
        <div class={`adv-card reveal delay-${((i % 3) + 1) * 100}`}>
          <div class="adv-card-icon" set:html={a.icon}></div>
          <h3 class="adv-card-title">{a.title}</h3>
          <p class="adv-card-desc">{a.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<!-- CTA Banner -->
<section class="cta-banner">
  <div class="cta-bg">
    <div class="cta-glow cta-glow-1"></div>
    <div class="cta-glow cta-glow-2"></div>
    <div class="hex-pattern" style="opacity: 0.3;"></div>
  </div>
  <div class="container cta-content">
    <div class="reveal">
      <p class="cta-sub">Siap Berkolaborasi?</p>
      <h2 class="cta-title">Konsultasikan Kebutuhan<br/>Industri Anda Sekarang</h2>
      <p class="cta-desc">
        Tim ahli kami siap membantu Anda menemukan solusi energi dan filtrasi yang tepat, efisien, dan terjangkau.
      </p>
      <div class="cta-actions">
        <a href="#kontak" class="btn btn-gold">
          Hubungi Kami Sekarang
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a href="tel:08111464967" class="cta-tel">
          <div class="cta-tel-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <div>
            <div class="cta-tel-label">Telepon Langsung</div>
            <div class="cta-tel-num">0811-1464-967</div>
          </div>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Keunggulan */
  #keunggulan { background: #111; }

  .adv-header {
    max-width: 640px;
    margin-bottom: 60px;
  }

  .adv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .adv-card {
    background: #181818;
    border: 1px solid rgba(201, 146, 42, 0.1);
    border-radius: 16px;
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.35s ease;
    cursor: default;
  }

  .adv-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
    background: linear-gradient(135deg, rgba(201,146,42,0.04), transparent);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .adv-card:hover {
    border-color: rgba(201, 146, 42, 0.3);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
  }

  .adv-card:hover::after { opacity: 1; }

  .adv-card-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(201, 146, 42, 0.08);
    border-radius: 14px;
    color: #C9922A;
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
    transition: all 0.35s ease;
  }

  .adv-card:hover .adv-card-icon {
    background: rgba(201, 146, 42, 0.15);
    box-shadow: 0 0 20px rgba(201,146,42,0.15);
    color: #E8B84B;
  }

  .adv-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 12px;
    position: relative;
    z-index: 1;
  }

  .adv-card-desc {
    font-size: 0.88rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.5);
    position: relative;
    z-index: 1;
  }

  /* CTA Banner */
  .cta-banner {
    position: relative;
    padding: 100px 0;
    overflow: hidden;
    background: #0A0A0A;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
  }

  .cta-glow-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(201,146,42,0.15) 0%, transparent 70%);
    top: -100px;
    left: -100px;
    animation: slowDrift 10s ease-in-out infinite;
  }

  .cta-glow-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(201,146,42,0.1) 0%, transparent 70%);
    bottom: -80px;
    right: -80px;
    animation: slowDrift 12s ease-in-out infinite reverse;
  }

  @keyframes slowDrift {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(30px, 20px); }
  }

  .cta-content {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .cta-sub {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #C9922A;
    margin-bottom: 16px;
  }

  .cta-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    color: #fff;
    letter-spacing: 0.03em;
    margin-bottom: 20px;
  }

  .cta-desc {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.5);
    max-width: 480px;
    margin: 0 auto 40px;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta-tel {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .cta-tel:hover { transform: translateY(-2px); }

  .cta-tel-icon {
    width: 44px;
    height: 44px;
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.6);
    transition: all 0.3s ease;
  }

  .cta-tel:hover .cta-tel-icon {
    border-color: #C9922A;
    color: #C9922A;
  }

  .cta-tel-label {
    font-size: 0.72rem;
    color: rgba(255,255,255,0.4);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .cta-tel-num {
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
  }

  @media (max-width: 900px) {
    .adv-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 580px) {
    .adv-header { margin-bottom: 36px; }
    .adv-grid { grid-template-columns: 1fr; gap: 16px; }
    .adv-card { padding: 26px 20px; border-radius: 12px; }
    .adv-card-icon { width: 44px; height: 44px; margin-bottom: 16px; }
    .adv-card-title { font-size: 1.15rem; }
    .adv-card-desc { font-size: 0.88rem; line-height: 1.65; }
    .cta-banner { padding: 36px 20px; border-radius: 14px; }
    .cta-title { font-size: 2rem; }
    .cta-desc { font-size: 0.92rem; line-height: 1.65; margin-bottom: 28px; }
    .cta-actions { flex-direction: column; width: 100%; gap: 16px; }
    .cta-actions .btn { width: 100%; justify-content: center; min-height: 48px; }
    .cta-tel { width: 100%; justify-content: center; }
  }
</style>
