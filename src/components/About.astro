---
---

<section id="tentang" class="section section-light">
  <div class="container">
    <div class="about-grid">
      <!-- Left: Text -->
      <div class="about-text">
        <div class="section-label reveal-left">Tentang Perusahaan</div>
        <h2 class="section-title text-dark reveal-left delay-100">
          Siapa Kami?
        </h2>
        <div class="gold-divider reveal-left delay-200"></div>

        <p class="about-desc reveal-left delay-200">
          <strong>PT Best Power Servis</strong> adalah perusahaan yang bergerak di bidang penyediaan solusi energi dan sistem filtrasi industri. Didirikan secara resmi pada
          <span class="text-highlight">17 September 2023</span> oleh Bapak Sunardi, perusahaan kami telah mendapatkan izin operasional yang sah.
        </p>

        <p class="about-desc reveal-left delay-300">
          Kami menyediakan layanan rental genset dan loadbank, perawatan serta perbaikan genset, suku cadang berkualitas, serta sistem filtrasi canggih untuk berbagai sektor industri. Dengan keahlian yang mumpuni, kami berkomitmen menghadirkan produk dan layanan terbaik guna memastikan keandalan operasional dan efisiensi energi bagi pelanggan kami.
        </p>

        <!-- Tags -->
        <div class="about-tags reveal-left delay-400">
          <span class="tag-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 7l-8 8-4-4"/></svg>
            Izin Operasional Resmi
          </span>
          <span class="tag-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 7l-8 8-4-4"/></svg>
            Jangkauan Seluruh Indonesia
          </span>
          <span class="tag-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 7l-8 8-4-4"/></svg>
            Standar Kualitas Tinggi
          </span>
        </div>

        <a href="#layanan" class="btn btn-gold reveal-left delay-500" style="margin-top: 8px; display: inline-flex;">
          Lihat Layanan Kami
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Right: Visual Card -->
      <div class="about-visual reveal-right delay-200">
        <div class="visual-card">
          <div class="visual-bg-glow"></div>
          <!-- Industrial visual -->
          <div class="visual-inner">
            <div class="visual-icon-ring">
              <img src="/logo.png" alt="Best Power Servis" width="72" height="72" />
            </div>
            <div class="visual-line"></div>
            <p class="visual-quote">
              "Solusi Energi dan Filtrasi Terbaik untuk Industri Anda."
            </p>
            <span class="visual-founder">— Sunardi, Founder</span>
          </div>

          <!-- Stats Grid -->
          <div class="about-stats">
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="2023">0</span>
              </div>
              <div class="stat-label">Tahun Berdiri</div>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="4">0</span>+
              </div>
              <div class="stat-label">Layanan Utama</div>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="50">0</span>%
              </div>
              <div class="stat-label">Hemat Filter</div>
            </div>
          </div>
        </div>

        <!-- Floating badges -->
        <div class="float-badge badge-tl">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#C9922A" stroke="none"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          Kualitas Terjamin
        </div>
        <div class="float-badge badge-br">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C9922A" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          Layanan 24/7
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #tentang { background-color: #F5F2ED; }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* Text */
  .about-desc {
    font-size: 1rem;
    line-height: 1.85;
    color: #4A4A4A;
    margin-bottom: 20px;
  }

  .text-highlight {
    color: #C9922A;
    font-weight: 600;
  }

  .about-tags {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }

  .tag-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    color: #2A2A2A;
  }

  .tag-item svg { color: #C9922A; flex-shrink: 0; }

  /* Visual Card */
  .about-visual {
    position: relative;
  }

  .visual-card {
    background: linear-gradient(145deg, #1A1A1A, #111111);
    border: 1px solid rgba(201, 146, 42, 0.2);
    border-radius: 20px;
    overflow: hidden;
    padding: 48px 36px 0;
    position: relative;
  }

  .visual-bg-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(201,146,42,0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  .visual-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    position: relative;
    z-index: 1;
  }

  .visual-icon-ring {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 2px solid rgba(201, 146, 42, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    background: rgba(201, 146, 42, 0.05);
    box-shadow: 0 0 40px rgba(201, 146, 42, 0.1);
  }

  .visual-line {
    width: 40px;
    height: 2px;
    background: linear-gradient(90deg, #C9922A, #E8B84B);
    border-radius: 2px;
    margin-bottom: 20px;
  }

  .visual-quote {
    font-size: 1rem;
    font-style: italic;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .visual-founder {
    font-size: 0.8rem;
    color: #C9922A;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  /* Stats in card */
  .about-stats {
    display: flex;
    align-items: center;
    padding: 24px 0;
    position: relative;
    z-index: 1;
  }

  .about-stat {
    flex: 1;
    text-align: center;
  }

  .about-stat .stat-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    color: #C9922A;
    line-height: 1;
    margin-bottom: 4px;
  }

  .about-stat .stat-label {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .about-stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(201, 146, 42, 0.15);
    flex-shrink: 0;
  }

  /* Floating badges */
  .float-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(10, 10, 10, 0.9);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fff;
    backdrop-filter: blur(10px);
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
  }

  .badge-tl {
    top: -16px;
    left: -16px;
    animation: floatBadge 3s ease-in-out infinite;
  }

  .badge-br {
    bottom: 40px;
    right: -16px;
    animation: floatBadge 3s ease-in-out infinite 1.5s;
  }

  @keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* Section label for light bg */
  #tentang .section-label { color: #C9922A; }
  #tentang .section-title { color: #111; }
  #tentang .section-label::before { background: #C9922A; }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .float-badge { display: none; }
  }
</style>
