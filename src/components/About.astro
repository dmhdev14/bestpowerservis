---
import { logoBase64 } from '../data/logo';
---

<section id="tentang" class="section section-dark">
  <div class="hex-pattern"></div>
  <div class="about-ambient-glow"></div>

  <div class="container" style="position: relative; z-index: 1;">
    <div class="about-grid">

      <!-- Left: Narrative & Trust Highlights -->
      <div class="about-text">
        <div class="section-label reveal-left">Tentang Perusahaan</div>
        <h2 class="section-title reveal-left delay-100">Siapa Kami?</h2>
        <div class="gold-divider reveal-left delay-200"></div>

        <!-- Lead Paragraph -->
        <p class="about-lead reveal-left delay-200">
          <strong>PT Best Power Servis</strong> adalah perusahaan yang bergerak di bidang penyediaan solusi energi dan sistem filtrasi industri terpercaya.
        </p>

        <!-- Establishment Callout -->
        <div class="about-establishment reveal-left delay-250">
          <div class="establishment-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              <polyline points="9 12 11 14 15 10"></polyline>
            </svg>
          </div>
          <p class="establishment-text">
            Didirikan secara resmi pada <span class="text-highlight">17 September 2023</span> oleh <strong>Bapak Sunardi</strong> dan telah memiliki izin operasional yang sah.
          </p>
        </div>

        <!-- Description Paragraph -->
        <p class="about-desc reveal-left delay-300">
          Kami menyediakan layanan loadbank rental & testing, generator service & maintenance, suku cadang berkualitas, serta sistem filtrasi industri canggih untuk berbagai sektor industri guna memastikan keandalan operasional dan efisiensi energi bagi pelanggan kami.
        </p>

        <!-- Clean Structured Trust Pills -->
        <div class="about-tags reveal-left delay-400">
          <div class="tag-pill">
            <span class="tag-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
            </span>
            <span>Izin Operasional Resmi</span>
          </div>

          <div class="tag-pill">
            <span class="tag-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
            </span>
            <span>Jangkauan Seluruh Indonesia</span>
          </div>

          <div class="tag-pill">
            <span class="tag-check">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <path d="M20 6L9 17l-5-5"></path>
              </svg>
            </span>
            <span>Standar Kualitas Tinggi</span>
          </div>
        </div>

        <!-- Action CTA -->
        <div class="about-actions reveal-left delay-500">
          <a href="/#layanan" class="btn btn-gold">
            Lihat Layanan Kami
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M12 5l7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right: Executive Profile Visual Card -->
      <div class="about-visual reveal-right delay-200">
        <div class="visual-card">
          <div class="visual-bg-glow"></div>

          <!-- Industrial Corner Accents -->
          <span class="card-corner tl"></span>
          <span class="card-corner tr"></span>
          <span class="card-corner bl"></span>
          <span class="card-corner br"></span>

          <!-- Integrated Top Status Bar (No Overlapping Floating Badges) -->
          <div class="visual-card-header">
            <div class="status-chip gold-chip">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
              </svg>
              <span>Kualitas Terjamin</span>
            </div>

            <div class="status-chip live-chip">
              <span class="live-dot"></span>
              <span>Layanan 24/7</span>
            </div>
          </div>

          <!-- Center Brand Emblem & Quote -->
          <div class="visual-inner">
            <div class="visual-emblem-wrap">
              <div class="visual-orbit-ring"></div>
              <div class="visual-icon-ring">
                <img
                  src={logoBase64}
                  alt="Best Power Servis"
                  width="68"
                  height="49"
                />
              </div>
            </div>

            <div class="visual-company-tag">PT BEST POWER SERVIS</div>
            <div class="visual-line"></div>

            <blockquote class="visual-quote">
              "Solusi Energi dan Filtrasi Terbaik untuk Industri Anda."
            </blockquote>

            <div class="visual-founder-wrap">
              <span class="visual-founder">— Sunardi, Founder</span>
            </div>
          </div>

          <!-- Bottom Stats Grid (Clean, Balanced, No Comma on Year) -->
          <div class="about-stats">
            <div class="about-stat">
              <div class="stat-number">2023</div>
              <div class="stat-label">Tahun Berdiri</div>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="4">4</span>+
              </div>
              <div class="stat-label">Layanan Utama</div>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="50">50</span>%
              </div>
              <div class="stat-label">Hemat Filter</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #tentang {
    background-color: #111111;
    position: relative;
    overflow: hidden;
  }

  .about-ambient-glow {
    position: absolute;
    top: 50%;
    right: -120px;
    transform: translateY(-50%);
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(201, 146, 42, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.95fr;
    gap: 64px;
    align-items: center;
  }

  /* =========================================
     LEFT COLUMN: TEXT & STORY
     ========================================= */
  #tentang .section-label {
    color: #C9922A;
  }
  #tentang .section-label::before {
    background: #C9922A;
  }

  .about-lead {
    font-size: 1.12rem;
    line-height: 1.7;
    color: #FFFFFF;
    margin-bottom: 20px;
    text-wrap: pretty;
  }

  .about-lead strong {
    color: #EBB136;
    font-weight: 700;
  }

  /* Establishment Callout */
  .about-establishment {
    display: flex;
    align-items: center;
    gap: 14px;
    background: linear-gradient(90deg, rgba(201, 146, 42, 0.1) 0%, rgba(201, 146, 42, 0.03) 100%);
    border: 1px solid rgba(201, 146, 42, 0.18);
    border-left: 3px solid #C9922A;
    border-radius: 10px;
    padding: 14px 18px;
    margin-bottom: 20px;
  }

  .establishment-icon {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: rgba(201, 146, 42, 0.14);
    border: 1px solid rgba(201, 146, 42, 0.25);
    color: #E8B84B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .establishment-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
    text-wrap: pretty;
  }

  .text-highlight {
    color: #E8B84B;
    font-weight: 700;
  }

  .about-desc {
    font-size: 0.95rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.66);
    margin-bottom: 26px;
    text-wrap: pretty;
  }

  /* Structured Trust Pills */
  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 30px;
  }

  .tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    font-size: 0.84rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.88);
    transition: border-color 0.25s ease, background 0.25s ease;
  }

  .tag-pill:hover {
    background: rgba(201, 146, 42, 0.07);
    border-color: rgba(201, 146, 42, 0.3);
  }

  .tag-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(201, 146, 42, 0.15);
    color: #E8B84B;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .about-actions {
    display: flex;
    align-items: center;
  }

  /* =========================================
     RIGHT COLUMN: EXECUTIVE VISUAL CARD
     ========================================= */
  .about-visual {
    position: relative;
  }

  .visual-card {
    background: linear-gradient(155deg, #191919 0%, #101010 100%);
    border: 1px solid rgba(201, 146, 42, 0.28);
    border-radius: 20px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 24px 54px rgba(0, 0, 0, 0.65), 0 0 36px rgba(201, 146, 42, 0.06);
    transition: border-color 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease;
  }

  .visual-card:hover {
    border-color: rgba(201, 146, 42, 0.48);
    transform: translateY(-3px);
    box-shadow: 0 28px 60px rgba(0, 0, 0, 0.75), 0 0 42px rgba(201, 146, 42, 0.1);
  }

  .visual-bg-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 240px;
    height: 240px;
    background: radial-gradient(circle, rgba(201, 146, 42, 0.16) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Corner Brackets */
  .card-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: rgba(232, 184, 75, 0.65);
    pointer-events: none;
    z-index: 2;
  }
  .card-corner.tl { top: 10px; left: 10px; border-top: 2px solid; border-left: 2px solid; }
  .card-corner.tr { top: 10px; right: 10px; border-top: 2px solid; border-right: 2px solid; }
  .card-corner.bl { bottom: 10px; left: 10px; border-bottom: 2px solid; border-left: 2px solid; }
  .card-corner.br { bottom: 10px; right: 10px; border-bottom: 2px solid; border-right: 2px solid; }

  /* Integrated Top Header Strip */
  .visual-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 26px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
    position: relative;
    z-index: 1;
  }

  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 12px;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .gold-chip {
    background: rgba(201, 146, 42, 0.12);
    border: 1px solid rgba(201, 146, 42, 0.3);
    color: #E8B84B;
  }

  .live-chip {
    background: rgba(37, 211, 102, 0.08);
    border: 1px solid rgba(37, 211, 102, 0.25);
    color: #E5E5E5;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #25D366;
    box-shadow: 0 0 8px rgba(37, 211, 102, 0.8);
    animation: livePulse 2s ease-in-out infinite;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.45; transform: scale(0.8); }
  }

  /* Center Content */
  .visual-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 38px 34px 34px;
    position: relative;
    z-index: 1;
  }

  .visual-emblem-wrap {
    position: relative;
    width: 118px;
    height: 118px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }

  .visual-orbit-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px dashed rgba(201, 146, 42, 0.28);
    animation: slowOrbit 28s linear infinite;
  }

  @keyframes slowOrbit {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .visual-icon-ring {
    width: 98px;
    height: 98px;
    border-radius: 50%;
    border: 1.5px solid rgba(201, 146, 42, 0.38);
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, rgba(201, 146, 42, 0.1) 0%, rgba(15, 15, 15, 0.9) 75%);
    box-shadow: 0 0 32px rgba(201, 146, 42, 0.14);
  }

  .visual-icon-ring img {
    width: 66px;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(232, 184, 75, 0.25));
  }

  .visual-company-tag {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.26em;
    color: rgba(255, 255, 255, 0.45);
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .visual-line {
    width: 44px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #E8B84B, transparent);
    border-radius: 2px;
    margin-bottom: 20px;
  }

  .visual-quote {
    font-size: 1.04rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.88);
    line-height: 1.7;
    margin: 0 0 16px;
    max-width: 360px;
  }

  .visual-founder-wrap {
    display: inline-flex;
    align-items: center;
    padding: 5px 14px;
    border-radius: 50px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.2);
  }

  .visual-founder {
    font-size: 0.78rem;
    color: #E8B84B;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* Bottom Stats Strip */
  .about-stats {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    padding: 24px 20px;
    background: rgba(0, 0, 0, 0.35);
    border-top: 1px solid rgba(201, 146, 42, 0.15);
    position: relative;
    z-index: 1;
  }

  .about-stat {
    text-align: center;
    padding: 0 8px;
  }

  .about-stat .stat-number {
    font-family: "Bebas Neue", sans-serif;
    font-size: 2.15rem;
    letter-spacing: 0.03em;
    color: #E8B84B;
    line-height: 1;
    margin-bottom: 6px;
  }

  .about-stat .stat-label {
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.5);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .about-stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(201, 146, 42, 0.18);
  }

  /* =========================================
     RESPONSIVE BREAKPOINTS
     ========================================= */
  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .visual-card {
      max-width: 560px;
      margin: 0 auto;
    }
  }

  @media (max-width: 600px) {
    .about-lead {
      font-size: 1rem;
      line-height: 1.65;
      margin-bottom: 16px;
    }
    .about-establishment {
      padding: 12px 14px;
      gap: 12px;
      margin-bottom: 16px;
    }
    .establishment-icon {
      width: 34px;
      height: 34px;
    }
    .establishment-text {
      font-size: 0.85rem;
      line-height: 1.55;
    }
    .about-desc {
      font-size: 0.88rem;
      line-height: 1.7;
      margin-bottom: 20px;
    }
    .about-tags {
      flex-direction: column;
      gap: 8px;
      margin-bottom: 24px;
    }
    .tag-pill {
      width: 100%;
      font-size: 0.84rem;
      padding: 9px 14px;
    }
    .about-actions .btn {
      width: 100%;
      justify-content: center;
      min-height: 48px;
    }

    .visual-card {
      border-radius: 16px;
    }
    .visual-card-header {
      padding: 14px 16px;
      gap: 8px;
    }
    .status-chip {
      padding: 5px 10px;
      font-size: 0.68rem;
    }
    .visual-inner {
      padding: 28px 20px 26px;
    }
    .visual-emblem-wrap {
      width: 96px;
      height: 96px;
      margin-bottom: 16px;
    }
    .visual-icon-ring {
      width: 82px;
      height: 82px;
    }
    .visual-icon-ring img {
      width: 54px;
      height: auto;
    }
    .visual-quote {
      font-size: 0.94rem;
      line-height: 1.6;
    }
    .about-stats {
      padding: 18px 10px;
    }
    .about-stat .stat-number {
      font-size: 1.8rem;
    }
    .about-stat .stat-label {
      font-size: 0.6rem;
      letter-spacing: 0.06em;
    }
  }
</style>
