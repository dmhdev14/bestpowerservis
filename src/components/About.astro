---

---

<section id="tentang" class="section section-dark">
  <div class="hex-pattern"></div>
  <div class="container" style="position: relative; z-index: 1;">
    <div class="about-grid">
      <!-- Left: Text -->
      <div class="about-text">
        <div class="section-label reveal-left">Tentang Perusahaan</div>
        <h2 class="section-title reveal-left delay-100">Siapa Kami?</h2>
        <div class="gold-divider reveal-left delay-200"></div>

        <!-- Lead Paragraph -->
        <p class="about-lead reveal-left delay-200">
          <strong>PT Best Power Servis</strong> adalah perusahaan yang bergerak di bidang penyediaan solusi energi dan sistem filtrasi industri terpercaya.
        </p>

        <!-- Establishment Callout -->
        <div class="about-establishment reveal-left delay-250">
          <div class="establishment-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
          </div>
          <p class="establishment-text">
            Didirikan secara resmi pada <span class="text-highlight">17 September 2023</span> oleh <strong>Bapak Sunardi</strong> dan telah memiliki izin operasional yang sah.
          </p>
        </div>

        <!-- Description Paragraph -->
        <p class="about-desc reveal-left delay-300">
          Kami menyediakan layanan rental genset dan loadbank, perawatan serta perbaikan genset, suku cadang berkualitas, serta sistem filtrasi canggih untuk berbagai sektor industri guna memastikan keandalan operasional dan efisiensi energi bagi pelanggan kami.
        </p>

        <!-- Tags -->
        <div class="about-tags reveal-left delay-400">
          <span class="tag-item">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"><path d="M20 7l-8 8-4-4"></path></svg
            >
            Izin Operasional Resmi
          </span>
          <span class="tag-item">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"><path d="M20 7l-8 8-4-4"></path></svg
            >
            Jangkauan Seluruh Indonesia
          </span>
          <span class="tag-item">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"><path d="M20 7l-8 8-4-4"></path></svg
            >
            Standar Kualitas Tinggi
          </span>
        </div>

        <a
          href="#layanan"
          class="btn btn-gold reveal-left delay-500"
          style="margin-top: 8px; display: inline-flex;"
        >
          Lihat Layanan Kami
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </div>

      <!-- Right: Visual Card -->
      <div class="about-visual reveal-right delay-200">
        <div class="visual-card">
          <div class="visual-bg-glow"></div>
          <!-- Industrial visual -->
          <div class="visual-inner">
            <div class="visual-icon-ring">
              <img
                src="/logo.webp"
                alt="Best Power Servis"
                width="72"
                height="72"
              />
            </div>
            <div class="visual-line"></div>
            <p class="visual-quote">
              "Solusi Energi dan Filtrasi Terbaik untuk Industri Anda."
            </p>
            <span class="visual-founder">— Sunardi, Founder</span>
          </div>

          <!-- Stats Grid -->
          <div class="about-stats">
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="2023">0</span>
              </div>
              <div class="stat-label">Tahun Berdiri</div>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="4">0</span>+
              </div>
              <div class="stat-label">Layanan Utama</div>
            </div>
            <div class="about-stat-divider"></div>
            <div class="about-stat">
              <div class="stat-number">
                <span data-counter data-target="50">0</span>%
              </div>
              <div class="stat-label">Hemat Filter</div>
            </div>
          </div>
        </div>

        <!-- Floating badges -->
        <div class="float-badge badge-tl">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="#C9922A"
            stroke="none"
            ><path
              d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
            ></path></svg
          >
          Kualitas Terjamin
        </div>
        <div class="float-badge badge-br">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="#C9922A"
            stroke-width="2"
            ><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"
            ></path></svg
          >
          Layanan 24/7
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #tentang {
    background-color: #121212;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  /* Text Styling */
  .about-lead {
    font-size: 1.12rem;
    line-height: 1.75;
    color: #FFFFFF;
    margin-bottom: 18px;
    text-wrap: pretty;
  }

  .about-lead strong {
    color: #EBB136;
    font-weight: 700;
  }

  /* Establishment / Trust Box */
  .about-establishment {
    display: flex;
    align-items: center;
    gap: 14px;
    background: rgba(201, 146, 42, 0.07);
    border-left: 3px solid #C9922A;
    border-radius: 0 10px 10px 0;
    padding: 12px 18px;
    margin-bottom: 20px;
  }

  .establishment-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(201, 146, 42, 0.15);
    color: #E8B84B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .establishment-text {
    font-size: 0.92rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.85);
    margin: 0;
    text-wrap: pretty;
  }

  .about-desc {
    font-size: 0.96rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.68);
    margin-bottom: 24px;
    text-wrap: pretty;
  }

  .text-highlight {
    color: #E8B84B;
    font-weight: 700;
  }

  .about-tags {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 32px;
  }

  .tag-item {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
  }

  .tag-item svg {
    color: #c9922a;
    flex-shrink: 0;
  }

  /* Visual Card */
  .about-visual {
    position: relative;
  }

  .visual-card {
    background: linear-gradient(145deg, #181818, #0f0f0f);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 20px;
    overflow: hidden;
    padding: 48px 36px 0;
    position: relative;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
  }

  .visual-bg-glow {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(
      circle,
      rgba(201, 146, 42, 0.15) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .visual-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-bottom: 36px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    z-index: 1;
  }

  .visual-icon-ring {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    border: 2px solid rgba(201, 146, 42, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 24px;
    background: rgba(201, 146, 42, 0.05);
    box-shadow: 0 0 40px rgba(201, 146, 42, 0.1);
  }

  .visual-line {
    width: 40px;
    height: 2px;
    background: linear-gradient(90deg, #c9922a, #e8b84b);
    border-radius: 2px;
    margin-bottom: 20px;
  }

  .visual-quote {
    font-size: 1rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.75);
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .visual-founder {
    font-size: 0.8rem;
    color: #c9922a;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  /* Stats in card */
  .about-stats {
    display: flex;
    align-items: center;
    padding: 24px 0;
    position: relative;
    z-index: 1;
  }

  .about-stat {
    flex: 1;
    text-align: center;
  }

  .about-stat .stat-number {
    font-family: "Bebas Neue", sans-serif;
    font-size: 2rem;
    color: #c9922a;
    line-height: 1;
    margin-bottom: 4px;
  }

  .about-stat .stat-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 500;
  }

  .about-stat-divider {
    width: 1px;
    height: 36px;
    background: rgba(201, 146, 42, 0.15);
    flex-shrink: 0;
  }

  /* Floating badges */
  .float-badge {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 14px;
    background: rgba(10, 10, 10, 0.9);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #fff;
    backdrop-filter: blur(10px);
    white-space: nowrap;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .badge-tl {
    top: -16px;
    left: -16px;
    animation: floatBadge 3s ease-in-out infinite;
  }

  .badge-br {
    bottom: 40px;
    right: -16px;
    animation: floatBadge 3s ease-in-out infinite 1.5s;
  }

  @keyframes floatBadge {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-6px);
    }
  }

  /* Section label */
  #tentang .section-label {
    color: #c9922a;
  }
  #tentang .section-label::before {
    background: #c9922a;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .float-badge {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .visual-card {
      padding: 32px 18px 0;
      border-radius: 14px;
    }
    .visual-inner {
      padding-bottom: 24px;
    }
    .visual-icon-ring {
      width: 80px;
      height: 80px;
      margin-bottom: 18px;
    }
    .visual-icon-ring img {
      width: 56px;
      height: 56px;
    }
    .visual-quote {
      font-size: 0.92rem;
      line-height: 1.6;
    }
    .about-lead {
      font-size: 1rem;
      line-height: 1.65;
      margin-bottom: 14px;
    }
    .about-establishment {
      padding: 10px 14px;
      gap: 12px;
      margin-bottom: 16px;
    }
    .establishment-icon {
      width: 32px;
      height: 32px;
    }
    .establishment-text {
      font-size: 0.84rem;
      line-height: 1.55;
    }
    .about-desc {
      font-size: 0.86rem;
      line-height: 1.65;
      margin-bottom: 20px;
    }
    .about-stats {
      padding: 16px 0;
    }
    .about-stat .stat-number {
      font-size: 1.7rem;
    }
    .about-stat .stat-label {
      font-size: 0.65rem;
    }
    .about-tags {
      margin-bottom: 24px;
    }
    .tag-item {
      font-size: 0.85rem;
    }
    .about-text .btn {
      width: 100%;
      justify-content: center;
      min-height: 48px;
    }
  }
</style>
