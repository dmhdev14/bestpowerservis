---
---

<section id="visi-misi" class="section section-darker">
  <!-- Decorative background elements -->
  <div class="hex-pattern"></div>
  <div class="visi-ambient-glow"></div>

  <div class="container" style="position: relative; z-index: 1;">
    <!-- Section Title Top -->
    <div class="vm-top-header reveal">
      <h2 class="section-title text-center">VISI &amp; MISI PERUSAHAAN</h2>
    </div>

    <!-- ========================================================
         VISI HERO CARD (ELEVATED INDUSTRIAL STATEMENT)
         ======================================================== -->
    <div class="visi-hero-card reveal delay-100">
      <span class="corner-bracket top-left"></span>
      <span class="corner-bracket top-right"></span>
      <span class="corner-bracket bottom-left"></span>
      <span class="corner-bracket bottom-right"></span>

      <div class="visi-card-inner">
        <!-- Visi Badge & Icon -->
        <div class="visi-badge-row">
          <div class="visi-chip">
            <span class="visi-dot"></span>
            VISI UTAMA PERUSAHAAN
          </div>
          <div class="visi-quote-icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"
              ></path>
            </svg>
          </div>
        </div>

        <!-- Vision Statement Quote -->
        <blockquote class="visi-statement">
          "Menjadi mitra terpercaya dalam penyediaan <span
            class="highlight-gold">solusi energi</span
          > dan <span class="highlight-gold">sistem filtrasi industri</span> dengan
          menghadirkan produk berkualitas tinggi yang <span
            class="highlight-gold">inovatif dan efisien</span
          >."
        </blockquote>

        <!-- 3 Core Philosophy Pillars -->
        <div class="visi-pillars">
          <div class="v-pillar-item">
            <div class="v-pillar-icon">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path></svg
              >
            </div>
            <span>Keandalan Energi Teruji</span>
          </div>

          <div class="v-pillar-item">
            <div class="v-pillar-icon">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                ></path></svg
              >
            </div>
            <span>Filtrasi Standar Global</span>
          </div>

          <div class="v-pillar-item">
            <div class="v-pillar-icon">
              <svg
                width="17"
                height="17"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline
                  points="22 4 12 14.01 9 11.01"></polyline></svg
              >
            </div>
            <span>Efisiensi Operasional Klien</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Subtle Divider -->
    <div class="vm-divider"></div>

    <!-- ========================================================
         MISI SECTION: BESPOKE EXECUTIVE TRIPLE SUITE
         ======================================================== -->
    <div class="misi-section reveal delay-150">
      <div class="misi-header">
        <div class="misi-chip">
          <span class="misi-dot"></span>
          MISI PERUSAHAAN
        </div>
      </div>

      <div class="misi-grid">
        <!-- Misi 01 -->
        <div class="misi-card">
          <span class="card-bracket top-left"></span>
          <span class="card-bracket bottom-right"></span>
          <div class="misi-watermark" aria-hidden="true">01</div>

          <div class="misi-card-header">
            <div class="misi-crest">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <polyline points="9 12 11 14 15 10"/>
              </svg>
            </div>
            <div class="misi-badge-tag">
              <span class="misi-roman">PILAR</span>
              <span class="misi-index">01</span>
            </div>
          </div>

          <div class="misi-gold-line"></div>

          <p class="misi-text">
            Menyediakan produk dan layanan energi serta filtrasi industri yang <span class="gold-foil">berkualitas, andal, dan kompetitif</span>.
          </p>

          <div class="misi-card-footer">
            <span class="footer-label">STANDAR KUALITAS</span>
            <span class="footer-dot"></span>
          </div>
        </div>

        <!-- Misi 02 -->
        <div class="misi-card">
          <span class="card-bracket top-left"></span>
          <span class="card-bracket bottom-right"></span>
          <div class="misi-watermark" aria-hidden="true">02</div>

          <div class="misi-card-header">
            <div class="misi-crest">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
            </div>
            <div class="misi-badge-tag">
              <span class="misi-roman">PILAR</span>
              <span class="misi-index">02</span>
            </div>
          </div>

          <div class="misi-gold-line"></div>

          <p class="misi-text">
            Membangun kemitraan jangka panjang berdasarkan <span class="gold-foil">kepercayaan, integritas, dan komitmen pelayanan</span>.
          </p>

          <div class="misi-card-footer">
            <span class="footer-label">INTEGRITAS KEMITRAAN</span>
            <span class="footer-dot"></span>
          </div>
        </div>

        <!-- Misi 03 -->
        <div class="misi-card">
          <span class="card-bracket top-left"></span>
          <span class="card-bracket bottom-right"></span>
          <div class="misi-watermark" aria-hidden="true">03</div>

          <div class="misi-card-header">
            <div class="misi-crest">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                <path d="M6 12v5c3 3 9 3 12 0v-5"/>
              </svg>
            </div>
            <div class="misi-badge-tag">
              <span class="misi-roman">PILAR</span>
              <span class="misi-index">03</span>
            </div>
          </div>

          <div class="misi-gold-line"></div>

          <p class="misi-text">
            Mengembangkan kompetensi sumber daya manusia Indonesia melalui <span class="gold-foil">pelatihan, peningkatan keterampilan, dan penciptaan lapangan kerja berkualitas</span>.
          </p>

          <div class="misi-card-footer">
            <span class="footer-label">PEMBERDAYAAN SDM</span>
            <span class="footer-dot"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #visi-misi {
    background: #0b0b0b;
    position: relative;
    overflow: hidden;
    padding: 95px 0 115px;
  }

  /* Ambient Glow */
  .visi-ambient-glow {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 850px;
    height: 600px;
    background: radial-gradient(
      ellipse at center,
      rgba(201, 146, 42, 0.1) 0%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .vm-top-header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto 46px;
  }

  .text-center {
    text-align: center;
  }

  /* =========================================
     ELEVATED VISI HERO CARD
     ========================================= */
  .visi-hero-card {
    position: relative;
    background: linear-gradient(
      145deg,
      rgba(24, 24, 24, 0.88),
      rgba(12, 12, 12, 0.96)
    );
    border: 1px solid rgba(201, 146, 42, 0.28);
    border-radius: 20px;
    padding: 46px 54px;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.7),
      0 0 40px rgba(201, 146, 42, 0.05);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition:
      transform 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .visi-hero-card:hover {
    border-color: rgba(201, 146, 42, 0.5);
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.8),
      0 0 50px rgba(201, 146, 42, 0.12);
    transform: translateY(-2px);
  }

  /* Industrial Corner Brackets */
  .corner-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: #e8b84b;
    pointer-events: none;
    opacity: 0.7;
    transition:
      opacity 0.3s ease,
      border-color 0.3s ease;
  }

  .visi-hero-card:hover .corner-bracket {
    opacity: 1;
    border-color: #f5c658;
  }

  .corner-bracket.top-left {
    top: 10px;
    left: 10px;
    border-top: 2px solid;
    border-left: 2px solid;
  }
  .corner-bracket.top-right {
    top: 10px;
    right: 10px;
    border-top: 2px solid;
    border-right: 2px solid;
  }
  .corner-bracket.bottom-left {
    bottom: 10px;
    left: 10px;
    border-bottom: 2px solid;
    border-left: 2px solid;
  }
  .corner-bracket.bottom-right {
    bottom: 10px;
    right: 10px;
    border-bottom: 2px solid;
    border-right: 2px solid;
  }

  .visi-card-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .visi-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 18px;
  }

  .visi-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(201, 146, 42, 0.1);
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #e8b84b;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .visi-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 10px #e8b84b;
  }

  .visi-quote-icon {
    color: rgba(201, 146, 42, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visi-statement {
    font-family: "Inter", sans-serif;
    font-size: clamp(1.22rem, 2.4vw, 1.75rem);
    line-height: 1.68;
    color: #ffffff;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 920px;
    margin: 0 auto 36px;
    font-style: normal;
  }

  .highlight-gold {
    color: #f0bc42;
    font-weight: 700;
    background: linear-gradient(135deg, #fff1c5 0%, #e8b84b 60%, #c9922a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 20px rgba(201, 146, 42, 0.3);
  }

  .visi-pillars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 20px;
    border-top: 1px dashed rgba(201, 146, 42, 0.2);
  }

  .v-pillar-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.02em;
    transition: all 0.25s ease;
  }

  .v-pillar-item:hover {
    background: rgba(201, 146, 42, 0.08);
    border-color: rgba(201, 146, 42, 0.35);
    color: #e8b84b;
  }

  .v-pillar-icon {
    color: #c9922a;
    display: flex;
    align-items: center;
  }

  /* =========================================
     SUBTLE DIVIDER BETWEEN VISI & MISI
     ========================================= */
  .vm-divider {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(201, 146, 42, 0.25),
      transparent
    );
    max-width: 500px;
    margin: 54px auto;
    position: relative;
    z-index: 1;
  }

  /* =========================================
     MISI SECTION: BESPOKE EXECUTIVE TRIPLE SUITE
     ========================================= */
  .misi-section {
    position: relative;
    z-index: 1;
  }

  .misi-header {
    text-align: center;
    margin-bottom: 38px;
  }

  .misi-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(201, 146, 42, 0.1);
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 7px 18px;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #e8b84b;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 241, 197, 0.12);
  }

  .misi-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 10px #e8b84b;
  }

  .misi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
    align-items: stretch;
  }

  /* Luxury Card Frame */
  .misi-card {
    position: relative;
    background: linear-gradient(
      155deg,
      rgba(26, 24, 20, 0.88) 0%,
      rgba(14, 13, 12, 0.94) 60%,
      rgba(9, 9, 9, 0.98) 100%
    );
    background-image: radial-gradient(
      ellipse at 20% 0%,
      rgba(232, 184, 75, 0.08) 0%,
      transparent 65%
    );
    border: 1px solid rgba(201, 146, 42, 0.26);
    border-radius: 18px;
    padding: 36px 32px 30px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow:
      inset 0 1px 0 rgba(255, 241, 197, 0.14),
      0 20px 45px rgba(0, 0, 0, 0.65),
      0 0 30px rgba(201, 146, 42, 0.03);
    transition:
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }

  .misi-card:hover {
    transform: translateY(-5px);
    border-color: rgba(232, 184, 75, 0.5);
    box-shadow:
      inset 0 1px 0 rgba(255, 241, 197, 0.25),
      0 26px 60px rgba(0, 0, 0, 0.8),
      0 0 40px rgba(201, 146, 42, 0.12);
  }

  /* Card Micro Corner Brackets */
  .card-bracket {
    position: absolute;
    width: 10px;
    height: 10px;
    border-color: rgba(232, 184, 75, 0.4);
    pointer-events: none;
    transition: border-color 0.3s ease, transform 0.3s ease;
  }

  .card-bracket.top-left {
    top: 8px;
    left: 8px;
    border-top: 1.5px solid;
    border-left: 1.5px solid;
  }

  .card-bracket.bottom-right {
    bottom: 8px;
    right: 8px;
    border-bottom: 1.5px solid;
    border-right: 1.5px solid;
  }

  .misi-card:hover .card-bracket {
    border-color: #f5c658;
  }

  /* Monumental Watermark Numeral */
  .misi-watermark {
    position: absolute;
    top: 4px;
    right: 18px;
    font-family: "Oswald", sans-serif;
    font-size: 5.6rem;
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201, 146, 42, 0.1);
    opacity: 0.65;
    line-height: 1;
    pointer-events: none;
    user-select: none;
    transition:
      opacity 0.4s ease,
      -webkit-text-stroke 0.4s ease,
      transform 0.4s ease;
  }

  .misi-card:hover .misi-watermark {
    opacity: 0.95;
    -webkit-text-stroke: 1px rgba(232, 184, 75, 0.25);
    transform: translateY(-2px);
  }

  /* Header inside Card */
  .misi-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 1;
  }

  .misi-crest {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.28);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #e8b84b;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
    transition: all 0.35s ease;
  }

  .misi-card:hover .misi-crest {
    background: rgba(201, 146, 42, 0.18);
    border-color: #e8b84b;
    color: #fff;
    box-shadow: 0 0 16px rgba(201, 146, 42, 0.4);
    transform: scale(1.05);
  }

  .misi-badge-tag {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .misi-roman {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: rgba(201, 146, 42, 0.75);
    text-transform: uppercase;
    line-height: 1.1;
    margin-bottom: 2px;
  }

  .misi-index {
    font-family: "Oswald", sans-serif;
    font-size: 1.7rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    background: linear-gradient(135deg, #fff1c5 0%, #e8b84b 55%, #c9922a 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Specular Metallic Hairline */
  .misi-gold-line {
    height: 1px;
    background: linear-gradient(
      90deg,
      rgba(232, 184, 75, 0.6) 0%,
      rgba(201, 146, 42, 0.22) 65%,
      transparent 100%
    );
    margin: 22px 0 20px;
    width: 100%;
    position: relative;
    z-index: 1;
    transition: background 0.3s ease;
  }

  .misi-card:hover .misi-gold-line {
    background: linear-gradient(
      90deg,
      #f5c658 0%,
      rgba(232, 184, 75, 0.4) 75%,
      transparent 100%
    );
  }

  /* Editorial Statement */
  .misi-text {
    font-family: "Inter", sans-serif;
    font-size: 1.05rem;
    line-height: 1.74;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 26px;
    position: relative;
    z-index: 1;
    flex-grow: 1;
  }

  .gold-foil {
    color: #f5c658;
    font-weight: 600;
    text-shadow: 0 0 16px rgba(232, 184, 75, 0.25);
  }

  /* Luxury Bottom Grounding */
  .misi-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    position: relative;
    z-index: 1;
  }

  .footer-label {
    font-family: "Oswald", sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: rgba(201, 146, 42, 0.7);
    text-transform: uppercase;
  }

  .footer-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 8px #e8b84b;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .misi-card:hover .footer-dot {
    transform: scale(1.4);
    box-shadow: 0 0 12px #f5c658;
  }

  /* =========================================
     RESPONSIVE BREAKPOINTS
     ========================================= */
  @media (max-width: 1024px) {
    .misi-grid {
      grid-template-columns: 1fr;
      gap: 22px;
      max-width: 640px;
      margin: 0 auto;
    }

    .misi-card {
      padding: 32px 28px 26px;
    }
  }

  @media (max-width: 768px) {
    #visi-misi {
      padding: 68px 0 76px;
    }

    .visi-hero-card {
      padding: 26px 18px;
      border-radius: 14px;
    }

    .visi-statement {
      font-size: 1.05rem;
      line-height: 1.58;
      margin-bottom: 22px;
    }

    .visi-pillars {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
    }

    .v-pillar-item {
      justify-content: center;
    }

    .vm-divider {
      margin: 36px auto;
    }

    .misi-card {
      padding: 26px 20px 22px;
    }

    .misi-text {
      font-size: 0.98rem;
      line-height: 1.66;
    }
  }
</style>
