---
const missions = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>`,
    text: 'Menyediakan genset dan loadbank berkualitas tinggi dengan berbagai kapasitas untuk kebutuhan temporary power.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    text: 'Memberikan layanan perawatan dan perbaikan genset secara profesional guna memastikan kinerja optimal.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`,
    text: 'Menyediakan suku cadang genset berkualitas untuk memastikan kelancaran operasional pelanggan.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
    text: 'Menyediakan sistem filtrasi dan part filter berkualitas yang meningkatkan efisiensi bahan bakar dan umur peralatan.',
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>`,
    text: 'Bermitra dengan principal filter global untuk menghadirkan teknologi filtrasi terbaik di industri.',
  },
];
---

<section id="visi-misi" class="section section-darker">
  <div class="hex-pattern"></div>

  <div class="container" style="position: relative; z-index: 1;">
    <!-- Visi -->
    <div class="visi-block">
      <div class="section-label reveal">Visi</div>
      <h2 class="visi-title reveal delay-100">
        Menjadi mitra terpercaya dalam penyediaan
        <span class="visi-highlight">solusi energi</span> dan
        <span class="visi-highlight">sistem filtrasi industri</span>
        dengan menghadirkan produk berkualitas tinggi yang inovatif dan efisien.
      </h2>
      <div class="gold-divider reveal delay-200" style="margin: 0 auto;"></div>
    </div>

    <!-- Misi -->
    <div class="misi-block">
      <div class="misi-header reveal">
        <div class="section-label">Misi</div>
        <h3 class="misi-title">Langkah Kami Mewujudkan Visi</h3>
      </div>

      <div class="misi-grid">
        {missions.map((m, i) => (
          <div class={`misi-card reveal delay-${(i + 1) * 100}`}>
            <div class="misi-number">0{i + 1}</div>
            <div class="misi-icon" set:html={m.icon}></div>
            <p class="misi-text">{m.text}</p>
            <div class="misi-line"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #visi-misi {
    background: #0A0A0A;
    text-align: center;
  }

  /* Visi */
  .visi-block {
    max-width: 800px;
    margin: 0 auto 80px;
  }

  .visi-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
    color: rgba(255,255,255,0.85);
    letter-spacing: 0.04em;
    margin-bottom: 28px;
  }

  .visi-highlight {
    color: #C9922A;
    position: relative;
  }

  .visi-highlight::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #C9922A, #E8B84B);
    border-radius: 2px;
  }

  /* Misi */
  .misi-block { text-align: left; }

  .misi-header {
    margin-bottom: 48px;
  }

  .misi-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    color: #fff;
    letter-spacing: 0.04em;
  }

  .misi-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .misi-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(201, 146, 42, 0.12);
    border-radius: 16px;
    padding: 32px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.35s ease;
    cursor: default;
  }

  .misi-card:hover {
    background: rgba(201, 146, 42, 0.05);
    border-color: rgba(201, 146, 42, 0.35);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3);
  }

  .misi-number {
    position: absolute;
    top: 16px;
    right: 20px;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3.5rem;
    color: rgba(201, 146, 42, 0.06);
    line-height: 1;
    pointer-events: none;
    transition: color 0.35s ease;
  }

  .misi-card:hover .misi-number {
    color: rgba(201, 146, 42, 0.12);
  }

  .misi-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(201, 146, 42, 0.1);
    border-radius: 12px;
    color: #C9922A;
    margin-bottom: 20px;
    transition: background 0.35s ease;
  }

  .misi-card:hover .misi-icon {
    background: rgba(201, 146, 42, 0.18);
  }

  .misi-text {
    font-size: 0.92rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.6);
  }

  .misi-line {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #C9922A, transparent);
    transform: scaleX(0);
    transition: transform 0.4s ease;
  }

  .misi-card:hover .misi-line { transform: scaleX(1); }

  /* Last card spans full width on 5-item grid */
  .misi-grid > *:last-child:nth-child(3n + 2) {
    grid-column: 2 / 3;
  }

  @media (max-width: 900px) {
    .misi-grid { grid-template-columns: 1fr 1fr; }
    .misi-grid > *:last-child:nth-child(3n + 2) { grid-column: auto; }
  }

  @media (max-width: 600px) {
    .visi-block { margin-bottom: 48px; text-align: left; }
    .visi-title { font-size: 1.65rem; line-height: 1.25; margin-bottom: 20px; }
    .gold-divider { margin: 0 !important; }
    .misi-header { margin-bottom: 28px; }
    .misi-grid { grid-template-columns: 1fr; gap: 16px; }
    .misi-card { padding: 24px 20px; border-radius: 12px; }
    .misi-icon { width: 42px; height: 42px; margin-bottom: 16px; }
    .misi-number { font-size: 2.8rem; top: 12px; right: 16px; }
    .misi-text { font-size: 0.88rem; line-height: 1.65; }
    #visi-misi { text-align: left; }
  }
</style>
