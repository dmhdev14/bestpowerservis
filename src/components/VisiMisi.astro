---
---

<section id="visi-misi" class="section section-darker">
  <!-- Decorative background elements -->
  <div class="hex-pattern"></div>
  <div class="visi-ambient-glow"></div>

  <div class="container" style="position: relative; z-index: 1;">
    
    <!-- Section Title Top -->
    <div class="vm-top-header reveal">
      <div class="section-label" style="justify-content: center;">Arah &amp; Komitmen Perusahaan</div>
      <h2 class="section-title text-center">VISI &amp; MISI PERUSAHAAN</h2>
      <p class="section-desc text-center" style="margin: 0 auto 52px;">
        Fondasi filosofis dan komitmen operasional yang menjadi kompas PT Best Power Servis dalam menghadirkan standar terbaik bagi industri energi dan filtrasi nasional.
      </p>
    </div>

    <!-- ========================================================
         VISI HERO CARD (ELEVATED INDUSTRIAL STATEMENT)
         ======================================================== -->
    <div class="visi-hero-card reveal delay-100">
      <span class="corner-bracket top-left"></span>
      <span class="corner-bracket top-right"></span>
      <span class="corner-bracket bottom-left"></span>
      <span class="corner-bracket bottom-right"></span>

      <div class="visi-card-inner">
        <!-- Visi Badge & Icon -->
        <div class="visi-badge-row">
          <div class="visi-chip">
            <span class="visi-dot"></span>
            VISI UTAMA PERUSAHAAN
          </div>
          <div class="visi-quote-icon" aria-hidden="true">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>
          </div>
        </div>

        <!-- Vision Statement Quote -->
        <blockquote class="visi-statement">
          "Menjadi mitra terpercaya dalam penyediaan <span class="highlight-gold">solusi energi</span> dan <span class="highlight-gold">sistem filtrasi industri</span> dengan menghadirkan produk berkualitas tinggi yang <span class="highlight-gold">inovatif dan efisien</span>."
        </blockquote>

        <!-- 3 Core Philosophy Pillars -->
        <div class="visi-pillars">
          <div class="v-pillar-item">
            <div class="v-pillar-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            </div>
            <span>Keandalan Energi Teruji</span>
          </div>

          <div class="v-pillar-item">
            <div class="v-pillar-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <span>Filtrasi Standar Global</span>
          </div>

          <div class="v-pillar-item">
            <div class="v-pillar-icon">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
            <span>Efisiensi Operasional Klien</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Architectural Connector -->
    <div class="vm-connector">
      <div class="connector-line"></div>
      <div class="connector-badge">
        <span class="connector-dot"></span>
        <span>EKSEKUSI OPERASIONAL</span>
        <span class="connector-dot"></span>
      </div>
      <div class="connector-line"></div>
    </div>

    <!-- ========================================================
         MISI SECTION: BESPOKE ASYMMETRIC SPECIFICATION SUITE
         ======================================================== -->
    <div class="misi-suite reveal delay-150">
      <div class="misi-layout">
        
        <!-- Left Column: Sticky Editorial Context & Technical Framework -->
        <div class="misi-aside">
          <div class="misi-aside-card">
            <div class="aside-badge">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
              <span>PILAR AKSI STRATEGIS</span>
            </div>

            <h3 class="aside-title">
              MISI KAMI UNTUK <span class="highlight-gold">INDUSTRI</span>
            </h3>

            <p class="aside-desc">
              Visi besar kami diterjemahkan menjadi tiga langkah nyata yang kami jalankan dengan disiplin tinggi setiap hari demi memastikan kelancaran operasional setiap mitra.
            </p>

            <!-- Specification Data Card -->
            <div class="aside-spec-card">
              <div class="spec-card-head">
                <span class="spec-status-light"></span>
                <span class="spec-head-text">SISTEM MANAJEMEN MUTU</span>
              </div>
              
              <div class="spec-card-rows">
                <div class="spec-row">
                  <span class="spec-key">Pengujian Daya</span>
                  <span class="spec-val">Loadbank Terkalibrasi</span>
                </div>
                <div class="spec-row">
                  <span class="spec-key">Sistem Filtrasi</span>
                  <span class="spec-val">Standar Internasional</span>
                </div>
                <div class="spec-row">
                  <span class="spec-key">Layanan Lapangan</span>
                  <span class="spec-val">Dukungan Siaga 24 Jam</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Right Column: 3 Precision Engineered Mission Rows -->
        <div class="misi-panels">
          
          <!-- Mission Item 01 -->
          <div class="misi-panel">
            <div class="panel-left-line"></div>
            <div class="panel-content">
              
              <div class="panel-head">
                <div class="panel-num-tag">
                  <span class="num-slash">//</span>
                  <span class="num-digit">01</span>
                  <span class="num-pilar-title">MUTU &amp; KEANDALAN PRODUK</span>
                </div>
                <div class="panel-crest">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    <polyline points="9 12 11 14 15 10"/>
                  </svg>
                </div>
              </div>

              <blockquote class="panel-statement">
                "Menyediakan produk dan layanan energi serta filtrasi industri yang <span class="quote-gold">berkualitas, andal, dan kompetitif</span>."
              </blockquote>

              <div class="panel-footer-spec">
                <span class="footer-spec-label">Fokus Implementasi:</span>
                <span class="footer-spec-text">Rental genset &amp; loadbank teruji, sistem filtrasi bahan bakar presisi, ketersediaan suku cadang orisinal.</span>
              </div>

            </div>
          </div>

          <!-- Mission Item 02 -->
          <div class="misi-panel">
            <div class="panel-left-line"></div>
            <div class="panel-content">
              
              <div class="panel-head">
                <div class="panel-num-tag">
                  <span class="num-slash">//</span>
                  <span class="num-digit">02</span>
                  <span class="num-pilar-title">INTEGRITAS &amp; KEMITRAAN</span>
                </div>
                <div class="panel-crest">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                    <circle cx="9" cy="7" r="4"/>
                    <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>
                    <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                  </svg>
                </div>
              </div>

              <blockquote class="panel-statement">
                "Membangun kemitraan jangka panjang berdasarkan <span class="quote-gold">kepercayaan, integritas, dan komitmen pelayanan</span>."
              </blockquote>

              <div class="panel-footer-spec">
                <span class="footer-spec-label">Fokus Implementasi:</span>
                <span class="footer-spec-text">Transparansi teknis, respon darurat cepat 24/7, serta solusi rekayasa energi yang disesuaikan kebutuhan klien.</span>
              </div>

            </div>
          </div>

          <!-- Mission Item 03 -->
          <div class="misi-panel">
            <div class="panel-left-line"></div>
            <div class="panel-content">
              
              <div class="panel-head">
                <div class="panel-num-tag">
                  <span class="num-slash">//</span>
                  <span class="num-digit">03</span>
                  <span class="num-pilar-title">PEMBERDAYAAN SDM NASIONAL</span>
                </div>
                <div class="panel-crest">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                    <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                  </svg>
                </div>
              </div>

              <blockquote class="panel-statement">
                "Mengembangkan kompetensi sumber daya manusia Indonesia melalui <span class="quote-gold">pelatihan, peningkatan keterampilan, dan penciptaan lapangan kerja berkualitas</span>."
              </blockquote>

              <div class="panel-footer-spec">
                <span class="footer-spec-label">Fokus Implementasi:</span>
                <span class="footer-spec-text">Pelatihan teknisi bersertifikat, penerapan standar K3 ketat, dan perluasan kesempatan kerja di sektor energi nasional.</span>
              </div>

            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>

<style>
  #visi-misi {
    background: #0B0B0B;
    position: relative;
    overflow: hidden;
    padding: 95px 0 110px;
  }

  /* Ambient Glow */
  .visi-ambient-glow {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 850px;
    height: 600px;
    background: radial-gradient(ellipse at center, rgba(201, 146, 42, 0.1) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .vm-top-header {
    text-align: center;
    max-width: 740px;
    margin: 0 auto;
  }

  .text-center { text-align: center; }

  /* =========================================
     ELEVATED VISI HERO CARD
     ========================================= */
  .visi-hero-card {
    position: relative;
    background: linear-gradient(145deg, rgba(24, 24, 24, 0.88), rgba(12, 12, 12, 0.96));
    border: 1px solid rgba(201, 146, 42, 0.28);
    border-radius: 20px;
    padding: 46px 54px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), 0 0 40px rgba(201, 146, 42, 0.05);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    transition: transform 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }

  .visi-hero-card:hover {
    border-color: rgba(201, 146, 42, 0.5);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.8), 0 0 50px rgba(201, 146, 42, 0.12);
    transform: translateY(-2px);
  }

  /* Industrial Corner Brackets */
  .corner-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: #E8B84B;
    pointer-events: none;
    opacity: 0.7;
    transition: opacity 0.3s ease, border-color 0.3s ease;
  }

  .visi-hero-card:hover .corner-bracket {
    opacity: 1;
    border-color: #F5C658;
  }

  .corner-bracket.top-left {
    top: 10px;
    left: 10px;
    border-top: 2px solid;
    border-left: 2px solid;
  }
  .corner-bracket.top-right {
    top: 10px;
    right: 10px;
    border-top: 2px solid;
    border-right: 2px solid;
  }
  .corner-bracket.bottom-left {
    bottom: 10px;
    left: 10px;
    border-bottom: 2px solid;
    border-left: 2px solid;
  }
  .corner-bracket.bottom-right {
    bottom: 10px;
    right: 10px;
    border-bottom: 2px solid;
    border-right: 2px solid;
  }

  .visi-card-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .visi-badge-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 18px;
  }

  .visi-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(201, 146, 42, 0.1);
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #E8B84B;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .visi-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8B84B;
    box-shadow: 0 0 10px #E8B84B;
  }

  .visi-quote-icon {
    color: rgba(201, 146, 42, 0.35);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visi-statement {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.22rem, 2.4vw, 1.75rem);
    line-height: 1.68;
    color: #FFFFFF;
    font-weight: 500;
    letter-spacing: -0.01em;
    max-width: 920px;
    margin: 0 auto 36px;
    font-style: normal;
  }

  .highlight-gold {
    color: #F0BC42;
    font-weight: 700;
    background: linear-gradient(135deg, #FFF1C5 0%, #E8B84B 60%, #C9922A 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: 0 0 20px rgba(201, 146, 42, 0.3);
  }

  .visi-pillars {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    flex-wrap: wrap;
    padding-top: 20px;
    border-top: 1px dashed rgba(201, 146, 42, 0.2);
  }

  .v-pillar-item {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    letter-spacing: 0.02em;
    transition: all 0.25s ease;
  }

  .v-pillar-item:hover {
    background: rgba(201, 146, 42, 0.08);
    border-color: rgba(201, 146, 42, 0.35);
    color: #E8B84B;
  }

  .v-pillar-icon {
    color: #C9922A;
    display: flex;
    align-items: center;
  }

  /* =========================================
     ARCHITECTURAL CONNECTOR
     ========================================= */
  .vm-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin: 54px 0 54px;
    position: relative;
    z-index: 1;
  }

  .connector-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 146, 42, 0.25), transparent);
    max-width: 240px;
  }

  .connector-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: 'Oswald', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: rgba(201, 146, 42, 0.85);
    text-transform: uppercase;
  }

  .connector-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #E8B84B;
    box-shadow: 0 0 6px #E8B84B;
  }

  /* =========================================
     MISI SUITE: ASYMMETRIC BESPOKE LAYOUT
     ========================================= */
  .misi-suite {
    position: relative;
    z-index: 1;
  }

  .misi-layout {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 36px;
    align-items: start;
  }

  /* Aside Column (Sticky Context) */
  .misi-aside {
    position: sticky;
    top: 100px;
  }

  .misi-aside-card {
    background: linear-gradient(160deg, rgba(24, 24, 24, 0.9) 0%, rgba(14, 14, 14, 0.96) 100%);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 16px;
    padding: 34px 28px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.5);
    position: relative;
    overflow: hidden;
  }

  .misi-aside-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 3.5px;
    height: 100%;
    background: linear-gradient(180deg, #E8B84B 0%, #C9922A 100%);
  }

  .aside-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    color: #E8B84B;
    letter-spacing: 0.16em;
    margin-bottom: 14px;
    text-transform: uppercase;
  }

  .aside-badge svg {
    color: #E8B84B;
  }

  .aside-title {
    font-family: 'Oswald', sans-serif;
    font-size: 1.85rem;
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: 0.02em;
    line-height: 1.22;
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .aside-desc {
    font-size: 0.88rem;
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.68);
    margin: 0 0 28px;
  }

  /* Aside Technical Spec Card */
  .aside-spec-card {
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid rgba(201, 146, 42, 0.2);
    border-radius: 10px;
    padding: 16px;
  }

  .spec-card-head {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .spec-status-light {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00E676;
    box-shadow: 0 0 8px #00E676;
  }

  .spec-head-text {
    font-family: 'Oswald', sans-serif;
    font-size: 0.72rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .spec-card-rows {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.76rem;
    gap: 10px;
  }

  .spec-key {
    color: rgba(255, 255, 255, 0.5);
  }

  .spec-val {
    color: #E8B84B;
    font-weight: 600;
    text-align: right;
  }

  /* =========================================
     RIGHT PANELS: THE 3 MISSION STRIPS
     ========================================= */
  .misi-panels {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .misi-panel {
    position: relative;
    background: linear-gradient(135deg, rgba(22, 22, 22, 0.9) 0%, rgba(14, 14, 14, 0.97) 100%);
    border: 1px solid rgba(201, 146, 42, 0.2);
    border-radius: 14px;
    padding: 28px 32px 24px;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
    overflow: hidden;
  }

  /* Technical left accent bar */
  .panel-left-line {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 3px;
    background: rgba(201, 146, 42, 0.3);
    transition: all 0.35s ease;
  }

  .misi-panel:hover {
    transform: translateX(4px);
    border-color: rgba(201, 146, 42, 0.5);
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.65), 0 0 25px rgba(201, 146, 42, 0.08);
  }

  .misi-panel:hover .panel-left-line {
    width: 5px;
    background: linear-gradient(180deg, #F5C658, #C9922A);
    box-shadow: 0 0 14px rgba(232, 184, 75, 0.6);
  }

  .panel-content {
    position: relative;
    z-index: 1;
  }

  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .panel-num-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: 'Oswald', sans-serif;
  }

  .num-slash {
    color: #C9922A;
    font-weight: 700;
    font-size: 1rem;
  }

  .num-digit {
    font-size: 1.25rem;
    font-weight: 700;
    color: #E8B84B;
    letter-spacing: 0.04em;
    line-height: 1;
  }

  .num-pilar-title {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    margin-left: 6px;
    padding-left: 10px;
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  .panel-crest {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.22);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #E8B84B;
    transition: all 0.3s ease;
  }

  .misi-panel:hover .panel-crest {
    background: #C9922A;
    color: #0A0A0A;
    box-shadow: 0 0 14px rgba(201, 146, 42, 0.4);
    transform: scale(1.05);
  }

  .panel-statement {
    font-family: 'Inter', sans-serif;
    font-size: 1.08rem;
    line-height: 1.72;
    color: #FFFFFF;
    font-weight: 500;
    margin: 0 0 18px;
    letter-spacing: -0.01em;
    font-style: normal;
  }

  .quote-gold {
    color: #F5C658;
    font-weight: 600;
  }

  .panel-footer-spec {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .footer-spec-label {
    font-family: 'Oswald', sans-serif;
    font-size: 0.72rem;
