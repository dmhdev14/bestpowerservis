---
---

<section id="kontak" class="section" style="background: #F5F2ED;">
  <div class="container">
    <div class="contact-grid">

      <!-- Left: Info -->
      <div class="contact-info">
        <div class="section-label reveal" style="color:#C9922A;">
          <span style="background:#C9922A;display:block;width:32px;height:2px;"></span>
          Kontak Kami
        </div>
        <h2 class="section-title text-dark reveal delay-100">MARI BICARA<br/>LEBIH LANJUT</h2>
        <div class="gold-divider reveal delay-200"></div>
        <p class="contact-desc reveal delay-300">
          Punya kebutuhan energi atau filtrasi industri? Tim ahli kami siap berdiskusi dan memberikan solusi terbaik untuk bisnis Anda.
        </p>

        <div class="contact-details">
          <div class="contact-item reveal delay-300">
            <div class="contact-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div class="contact-detail-content">
              <div class="detail-label">Alamat</div>
              <div class="detail-text">Greenhill Residences Blok D2/5 RT. 011 RW. 10, Jatisari, Jatiasih, Bekasi, Jawa Barat 17426</div>
            </div>
          </div>

          <div class="contact-item reveal delay-400">
            <div class="contact-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="contact-detail-content">
              <div class="detail-label">Telepon / WhatsApp</div>
              <a href="tel:08111464967" class="detail-link">0811-1464-967</a>
            </div>
          </div>

          <div class="contact-item reveal delay-500">
            <div class="contact-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
            <div class="contact-detail-content">
              <div class="detail-label">Email</div>
              <a href="mailto:sales@bestpower.id" class="detail-link">sales@bestpower.id</a>
            </div>
          </div>
        </div>

        <!-- Sunardi card -->
        <div class="founder-card reveal delay-400">
          <div class="founder-avatar">S</div>
          <div class="founder-info">
            <div class="founder-name">Sunardi</div>
            <div class="founder-role">Founder & Direktur</div>
          </div>
          <a href="https://wa.me/628111464967" target="_blank" rel="noopener" class="founder-wa">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            WhatsApp
          </a>
        </div>
      </div>

      <!-- Right: Form -->
      <div class="contact-form-wrap reveal-right delay-200">
        <form class="contact-form" id="contactForm">
          <h3 class="form-title">Kirim Pesan</h3>
          <p class="form-sub">Ceritakan kebutuhan Anda, kami akan merespons dalam 1x24 jam.</p>

          <div class="form-row">
            <div class="form-group">
              <label for="nama">Nama Lengkap *</label>
              <input type="text" id="nama" name="nama" placeholder="Nama Anda" required />
            </div>
            <div class="form-group">
              <label for="perusahaan">Nama Perusahaan</label>
              <input type="text" id="perusahaan" name="perusahaan" placeholder="PT / CV / UD..." />
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="telepon">Nomor Telepon *</label>
              <input type="tel" id="telepon" name="telepon" placeholder="08xxxxxxxxxx" inputmode="tel" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="email@perusahaan.com" inputmode="email" />
            </div>
          </div>

          <div class="form-group">
            <label for="layanan">Layanan yang Diminati</label>
            <select id="layanan" name="layanan">
              <option value="" disabled selected>Pilih layanan...</option>
              <option value="rental-genset">Rental Genset & Loadbank</option>
              <option value="service-genset">Service & Perawatan Genset</option>
              <option value="suku-cadang">Penyediaan Suku Cadang</option>
              <option value="filtrasi">Sistem Filtrasi & Part Filter</option>
              <option value="lainnya">Lainnya</option>
            </select>
          </div>

          <div class="form-group">
            <label for="pesan">Pesan *</label>
            <textarea id="pesan" name="pesan" rows="4" placeholder="Ceritakan kebutuhan industri Anda..." required></textarea>
          </div>

          <button type="submit" class="btn btn-gold form-submit">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Kirim Pesan
          </button>

          <div class="form-note">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            Data Anda aman dan tidak akan dibagikan ke pihak ketiga.
          </div>
        </form>
      </div>

    </div>
  </div>
</section>

<style>
  #kontak { background: #F5F2ED; }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 80px;
    align-items: start;
  }

  .contact-desc {
    font-size: 1rem;
    line-height: 1.8;
    color: #555;
    margin-bottom: 36px;
  }

  /* Contact Details */
  .contact-details {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-bottom: 32px;
  }

  .contact-item {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .contact-icon {
    width: 44px;
    height: 44px;
    background: rgba(201, 146, 42, 0.1);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #C9922A;
    flex-shrink: 0;
  }

  .detail-label {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #C9922A;
    margin-bottom: 4px;
  }

  .detail-text {
    font-size: 0.9rem;
    color: #333;
    line-height: 1.6;
  }

  .detail-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: #111;
    transition: color 0.2s ease;
  }
  .detail-link:hover { color: #C9922A; }

  /* Founder Card */
  .founder-card {
    display: flex;
    align-items: center;
    gap: 16px;
    background: #fff;
    border: 1px solid rgba(201, 146, 42, 0.15);
    border-radius: 14px;
    padding: 16px 20px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }

  .founder-avatar {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #C9922A, #E8B84B);
    color: #000;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.4rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .founder-name {
    font-size: 0.95rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 2px;
  }

  .founder-role {
    font-size: 0.75rem;
    color: #888;
    letter-spacing: 0.04em;
  }

  .founder-wa {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    background: #25D366;
    color: #fff;
    font-size: 0.78rem;
    font-weight: 700;
    padding: 8px 14px;
    border-radius: 100px;
    transition: all 0.3s ease;
  }
  .founder-wa:hover {
    background: #20ba5a;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(37,211,102,0.35);
  }

  /* Form */
  .contact-form-wrap {
    background: #fff;
    border-radius: 20px;
    padding: 48px 40px;
    box-shadow: 0 8px 48px rgba(0,0,0,0.1);
    border: 1px solid rgba(201, 146, 42, 0.08);
  }

  .form-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.8rem;
    color: #111;
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }

  .form-sub {
    font-size: 0.88rem;
    color: #888;
    margin-bottom: 32px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .form-group label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #333;
    letter-spacing: 0.03em;
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    font-family: 'Inter', sans-serif;
    font-size: 16px; /* Prevents auto-zoom on iOS Safari */
    color: #111;
    background: #FAFAFA;
    border: 1.5px solid #E5E5E5;
    border-radius: 8px;
    padding: 12px 16px;
    outline: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
    resize: none;
    width: 100%;
    min-height: 48px;
    box-sizing: border-box;
  }

  .form-group textarea {
    min-height: 110px;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #bbb;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    border-color: #C9922A;
    box-shadow: 0 0 0 3px rgba(201, 146, 42, 0.12);
    background: #fff;
  }

  .form-submit {
    width: 100%;
    justify-content: center;
    padding: 16px;
    font-size: 0.95rem;
    margin-bottom: 16px;
  }

  .form-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.75rem;
    color: #aaa;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
  }

  @media (max-width: 520px) {
    .contact-form-wrap { padding: 24px 18px; border-radius: 14px; }
    .form-row { grid-template-columns: 1fr; gap: 0; }
    .form-title { font-size: 1.6rem; }
    .form-sub { font-size: 0.85rem; margin-bottom: 20px; }
    .founder-card { padding: 18px 16px; border-radius: 12px; }
    .contact-item { gap: 12px; }
    .contact-icon { width: 40px; height: 40px; border-radius: 10px; }
    .detail-text, .detail-link { font-size: 0.92rem; }
  }
</style>

<script>
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  if (form) {
    form.addEventListener('submit', (e: Event) => {
      e.preventDefault();
      const btn = form.querySelector('.form-submit') as HTMLButtonElement | null;
      if (!btn) return;
      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 7l-8 8-4-4"/></svg> Pesan Terkirim!';
      btn.style.background = '#22C55E';
      btn.disabled = true;
      setTimeout(() => {
        btn.innerHTML = originalHTML;
        btn.style.background = '';
        btn.disabled = false;
        form.reset();
      }, 3000);
    });
  }
</script>
