---
import { logoBase64 } from '../data/logo';
---

<footer id="footer">
  <div class="footer-top">
    <div class="container footer-grid">

      <!-- Column 1: Brand & Credibility -->
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <img src={logoBase64} alt="Best Power Servis" width="46" height="46" />
          <div class="footer-logo-wrap">
            <span class="footer-logo-text">Best Power Servis</span>
            <span class="footer-logo-sub">PT BEST POWER SERVIS</span>
          </div>
        </a>

        <p class="footer-tagline">
          "Solusi Energi dan Filtrasi Terbaik untuk Industri Anda."
        </p>

        <!-- Trust / Legal Badge -->
        <div class="footer-legal-badge">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <polyline points="9 12 11 14 15 10"/>
          </svg>
          <span>Legalitas Resmi • Beroperasi Sejak 2023</span>
        </div>

        <!-- Touch-Friendly Contact Action Buttons -->
        <div class="footer-action-pills">
          <a href="tel:08111464967" class="f-pill-btn">
            <div class="f-pill-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4 2 2 0 0 1 3.6 1.22h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.8a16 16 0 0 0 6.29 6.29l.95-.95a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <span>Hubungi: 0811-1464-967</span>
          </a>

          <a href="mailto:sales@bestpower.id" class="f-pill-btn">
            <div class="f-pill-icon">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <span>Email: sales@bestpower.id</span>
          </a>
        </div>
      </div>

      <!-- Column 2: Location & Operating Info -->
      <div class="footer-location-col">
        <div class="footer-nav-title">
          <span>Kantor Operasional &amp; Workshop</span>
          <div class="footer-title-bar"></div>
        </div>
        
        <div class="footer-location-card">
          <div class="footer-address-box">
            <div class="f-address-pin">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <p class="footer-address-text">
              Greenhill Residences Blok D2/5 RT. 011 RW. 10, Jatisari, Jatiasih, Kota Bekasi, Jawa Barat 17426
            </p>
          </div>

          <div class="footer-hours">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <polyline points="12 6 12 12 16 14"/>
            </svg>
            <span>Senin – Sabtu • Layanan Emergency 24 Jam</span>
          </div>

          <a
            href="https://maps.google.com/?q=Greenhill+Residences+Jatisari+Jatiasih+Bekasi"
            target="_blank"
            rel="noopener noreferrer"
            class="footer-maps-link"
          >
            <span>Buka di Google Maps</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
          </a>
        </div>
      </div>

    </div>
  </div>

  <!-- Footer Bottom Bar -->
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <div class="footer-copyright">
        © {new Date().getFullYear()} <strong>PT Best Power Servis</strong>.
        <span class="desktop-only">•</span>
        <span class="copyright-sub">Hak Cipta Dilindungi.</span>
      </div>

      <div class="footer-meta">
        <span>Solusi Energi &amp; Filtrasi Industri</span>
        <span class="f-dot">•</span>
        <span>Bekasi, Indonesia</span>
      </div>

      <a href="#navbar" class="footer-back-to-top" aria-label="Kembali ke atas">
        <span>Ke Atas</span>
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="18 15 12 9 6 15"/>
        </svg>
      </a>
    </div>
  </div>
</footer>

<style>
  footer {
    background: #090909;
    border-top: 1px solid rgba(201, 146, 42, 0.2);
    position: relative;
    overflow: hidden;
  }

  /* Subtle Top Glow Border */
  footer::before {
    content: '';
    position: absolute;
    top: 0;
    left: 15%;
    right: 15%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #E8B84B, transparent);
    pointer-events: none;
  }

  .footer-top {
    padding: 64px 0 44px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    align-items: start;
    max-width: 1100px;
  }

  /* =========================================
     COLUMN 1: BRAND
     ========================================= */
  .footer-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-bottom: 14px;
  }

  .footer-logo img {
    width: 46px;
    height: 46px;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(201, 146, 42, 0.3));
    transition: transform 0.3s ease;
  }

  .footer-logo:hover img {
    transform: scale(1.05);
  }

  .footer-logo-wrap {
    display: flex;
    flex-direction: column;
  }

  .footer-logo-text {
    font-family: 'Inter', sans-serif;
    font-size: 1.28rem;
    font-weight: 800;
    color: #EBB136;
    letter-spacing: -0.01em;
    line-height: 1.1;
  }

  .footer-logo-sub {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    margin-top: 3px;
  }

  .footer-tagline {
    font-size: 0.86rem;
    font-style: italic;
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.6;
    margin-bottom: 16px;
    max-width: 380px;
  }

  .footer-legal-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.22);
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 600;
    color: #E8B84B;
    margin-bottom: 20px;
  }

  .footer-legal-badge svg {
    color: #E8B84B;
    flex-shrink: 0;
  }

  /* Contact Action Pills */
  .footer-action-pills {
    display: flex;
    flex-direction: column;
    gap: 9px;
    max-width: 360px;
  }

  .f-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 0.84rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 9px 14px;
    border-radius: 8px;
    transition: all 0.25s ease;
  }

  .f-pill-icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: rgba(201, 146, 42, 0.12);
    color: #E8B84B;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.25s ease;
  }

  .f-pill-btn:hover {
    background: rgba(201, 146, 42, 0.1);
    border-color: rgba(201, 146, 42, 0.35);
    color: #FFF;
    transform: translateY(-1px);
  }

  .f-pill-btn:hover .f-pill-icon {
    background: #C9922A;
    color: #000;
  }

  /* =========================================
     COLUMN 2: LOCATION CARD
     ========================================= */
  .footer-nav-title {
    margin-bottom: 18px;
  }

  .footer-nav-title span {
    font-family: 'Inter', sans-serif;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #E8B84B;
    display: block;
  }

  .footer-title-bar {
    width: 24px;
    height: 2px;
    background: #C9922A;
    margin-top: 5px;
    border-radius: 2px;
  }

  .footer-location-card {
    background: rgba(20, 20, 20, 0.65);
    border: 1px solid rgba(201, 146, 42, 0.15);
    border-radius: 14px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
  }

  .footer-address-box {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .f-address-pin {
    color: #C9922A;
    margin-top: 2px;
    flex-shrink: 0;
  }

  .footer-address-text {
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
  }

  .footer-hours {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.76rem;
    font-weight: 500;
    color: rgba(201, 146, 42, 0.9);
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.2);
    padding: 8px 12px;
    border-radius: 6px;
  }

  .footer-hours svg {
    color: #E8B84B;
    flex-shrink: 0;
  }

  .footer-maps-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    color: #E8B84B;
    text-decoration: none;
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 10px 16px;
    border-radius: 8px;
    background: rgba(201, 146, 42, 0.06);
    transition: all 0.25s ease;
    width: 100%;
    text-align: center;
  }

  .footer-maps-link:hover {
    background: rgba(201, 146, 42, 0.18);
    border-color: #E8B84B;
    color: #FFF;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(201, 146, 42, 0.15);
  }

  /* =========================================
     BOTTOM BAR
     ========================================= */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 20px 0;
    background: #060606;
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
    gap: 16px;
    flex-wrap: wrap;
    max-width: 1100px;
  }

  .footer-copyright strong {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 600;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.4);
  }

  .f-dot {
    color: rgba(201, 146, 42, 0.5);
  }

  .footer-back-to-top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.76rem;
    font-weight: 600;
    color: rgba(201, 146, 42, 0.85);
    text-decoration: none;
    background: rgba(201, 146, 42, 0.06);
    border: 1px solid rgba(201, 146, 42, 0.18);
    padding: 5px 12px;
    border-radius: 50px;
    transition: all 0.25s ease;
  }

  .footer-back-to-top:hover {
    color: #E8B84B;
    border-color: #E8B84B;
    background: rgba(201, 146, 42, 0.15);
  }

  /* =========================================
     MOBILE RESPONSIVE
     ========================================= */
  @media (max-width: 768px) {
    .footer-top {
      padding: 38px 0 20px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .footer-brand {
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding-bottom: 22px;
    }

    .footer-tagline {
      max-width: 100%;
      font-size: 0.82rem;
    }

    .footer-legal-badge {
      width: 100%;
      justify-content: center;
      font-size: 0.7rem;
    }

    .footer-action-pills {
      max-width: 100%;
      gap: 8px;
    }

    .f-pill-btn {
      width: 100%;
      padding: 9px 12px;
    }

    .footer-location-card {
      padding: 16px;
    }

    /* 88px clearance at bottom so fixed floating WhatsApp button never covers text */
    .footer-bottom {
      padding: 16px 0 88px;
    }

    .footer-bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .desktop-only,
    .footer-meta {
      display: none;
    }

    .footer-copyright {
      font-size: 0.74rem;
      line-height: 1.5;
    }

    .footer-back-to-top {
      align-self: flex-start;
      padding: 6px 14px;
      font-size: 0.74rem;
    }
  }
</style>
