---
const services = [
  {
    num: '01',
    category: 'CRITICAL POWER VERIFICATION',
    title: 'Loadbank Rental & Testing',
    image: '/projects/project-service.webp',
    imageAlt: 'Teknisi PT Best Power Servis melakukan pengujian loadbank di fasilitas industri',
    badge: 'UNIT TERKALIBRASI K3',
    desc: 'Layanan rental dan pengujian dummy load presisi untuk memverifikasi kapasitas riil UPS, generator, serta infrastruktur daya kritis fasilitas Anda.',
    points: [
      'Pengujian beban step-load terkalibrasi',
      'Pencegahan wet-stacking mesin genset',
      'Verifikasi kapasitas baterai cadangan UPS'
    ],
    link: '/loadbank-rental-testing',
    linkText: 'Detail Layanan Loadbank'
  },
  {
    num: '02',
    category: 'PREVENTIVE & CORRECTIVE',
    title: 'Generator Service & Maintenance',
    image: '/projects/maintenance1.webp',
    imageAlt: 'Instalasi dan pemeliharaan genset industri PT Best Power Servis',
    badge: 'SIAGA & KONTRAK RESMI',
    desc: 'Pemeliharaan terencana dan perbaikan komprehensif sistem genset industri guna menjaga kesiapan operasional serta mengeliminasi risiko downtime.',
    points: [
      'Preventive & corrective maintenance rutin',
      'Troubleshooting & inspeksi elektrikal mesin',
      'Kontrak servis berkala dengan jaminan SLA'
    ],
    link: '/generator-service-maintenance',
    linkText: 'Detail Pemeliharaan Genset'
  },
  {
    num: '03',
    category: 'FLUID PURIFICATION & EFFICIENCY',
    title: 'Fuel Filtration Systems',
    image: '/projects/filter.webp',
    imageAlt: 'Unit bejana filtrasi bahan bakar solar industri PT Best Power Servis',
    badge: 'HEMAT FILTER S/D 50%',
    desc: 'Teknologi purifikasi solar diesel dan biosolar (B35/B40) multi-tahap untuk memisahkan kontaminasi air terlarut dan melindungi injektor mesin.',
    points: [
      'Pemisahan air bebas & partikulat sub-mikron',
      'Proteksi injektor mesin common-rail modern',
      'Hemat biaya filter mesin hingga 50% vs OEM'
    ],
    link: '/fuel-filtration-systems',
    linkText: 'Detail Solusi Filtrasi'
  }
];
---

<section id="layanan" class="section services-section">
  <!-- Ambient Backdrop -->
  <div class="hex-pattern"></div>
  <div class="services-ambient-glow"></div>

  <div class="container relative-z">

    <!-- Section Header: Clean & Authoritative -->
    <div class="services-header">
      <div class="section-label reveal">
        <span class="label-dot"></span>
        <span>SOLUSI UTAMA PERUSAHAAN</span>
      </div>
      <h2 class="section-title reveal delay-100">
        APA YANG KAMI <span class="highlight-gold">TAWARKAN</span>
      </h2>
      <div class="gold-divider reveal delay-150"></div>
      <p class="section-desc reveal delay-200">
        Menghadirkan keandalan sistem ketenagalistrikan dan integritas bahan bakar industri melalui tiga pilar rekayasa teruji dengan standar kepatuhan teknis tertinggi.
      </p>
    </div>

    <!-- 3 Industrial Gateway Cards Grid -->
    <div class="services-gateway-grid">
      {services.map((s, i) => (
        <article class={`gateway-card reveal delay-${(i + 1) * 100}`}>
          <!-- Edge Hover Beam Animation -->
          <div class="card-beam"></div>

          <!-- Precision Metallic Corner Crosshairs -->
          <span class="crosshair top-left"></span>
          <span class="crosshair top-right"></span>
          <span class="crosshair bottom-left"></span>
          <span class="crosshair bottom-right"></span>

          <!-- Card Header Image Stage -->
          <div class="card-image-stage">
            <img
              src={s.image}
              alt={s.imageAlt}
              class="stage-img"
              width="480"
              height="260"
              loading="lazy"
              decoding="async"
            />
            <div class="stage-gradient"></div>

            <!-- Number Watermark -->
            <span class="stage-num-watermark">{s.num}</span>

            <!-- Status Badge -->
            <div class="stage-status-chip">
              <span class="chip-pulse-dot"></span>
              <span>{s.badge}</span>
            </div>
          </div>

          <!-- Card Body Stage -->
          <div class="card-body-stage">
            <div class="card-category">
              <span class="cat-idx">{s.num}</span>
              <span class="cat-sep">/</span>
              <span class="cat-text">{s.category}</span>
            </div>

            <h3 class="card-title">{s.title}</h3>

            <p class="card-desc">{s.desc}</p>

            <!-- Specification Checklist -->
            <ul class="card-checklist">
              {s.points.map(p => (
                <li class="check-item">
                  <div class="check-icon">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                  </div>
                  <span>{p}</span>
                </li>
              ))}
            </ul>

            <!-- Dedicated Action Button linking to specific page -->
            <div class="card-action-wrap">
              <a href={s.link} class="btn-gateway">
                <span>{s.linkText}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <path d="M5 12h14M12 5l7 7-7 7"></path>
                </svg>
              </a>
            </div>

          </div>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .services-section {
    background-color: #0E0E0E;
    position: relative;
    padding: 110px 0 115px;
    overflow: hidden;
  }

  .relative-z {
    position: relative;
    z-index: 1;
  }

  .services-ambient-glow {
    position: absolute;
    top: 25%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(201, 146, 42, 0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Header */
  .services-header {
    max-width: 680px;
    margin-bottom: 56px;
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #E8B84B;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  .label-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8B84B;
    box-shadow: 0 0 8px #E8B84B;
  }

  .section-title {
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: 0.03em;
    color: #FFFFFF;
    margin: 0;
  }

  .highlight-gold {
    color: #E8B84B;
  }

  .gold-divider {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, #C9922A, #E8B84B);
    margin: 16px 0 20px;
    border-radius: 2px;
  }

  .section-desc {
    font-size: 0.98rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  /* =========================================
     GATEWAY CARDS GRID
     ========================================= */
  .services-gateway-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .gateway-card {
    position: relative;
    background: #131313;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: 4px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.55);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                border-color 0.4s ease,
                box-shadow 0.4s ease;
  }

  .gateway-card:hover {
    transform: translateY(-6px);
    border-color: rgba(201, 146, 42, 0.38);
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.75), 0 0 28px rgba(201, 146, 42, 0.08);
  }

  /* Animated Top Beam */
  .card-beam {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #E8B84B, #C9922A, transparent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 5;
  }
  .gateway-card:hover .card-beam {
    transform: scaleX(1);
  }

  /* Precision Corner Crosshair Marks */
  .crosshair {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: #C9922A;
    pointer-events: none;
    z-index: 4;
    transition: all 0.3s ease;
  }
  .crosshair.top-left { top: 8px; left: 8px; border-top: 2px solid; border-left: 2px solid; }
  .crosshair.top-right { top: 8px; right: 8px; border-top: 2px solid; border-right: 2px solid; }
  .crosshair.bottom-left { bottom: 8px; left: 8px; border-bottom: 2px solid; border-left: 2px solid; }
  .crosshair.bottom-right { bottom: 8px; right: 8px; border-bottom: 2px solid; border-right: 2px solid; }

  .gateway-card:hover .crosshair {
    border-color: #E8B84B;
    width: 15px;
    height: 15px;
  }

  /* Image Stage */
  .card-image-stage {
    position: relative;
    width: 100%;
    height: 220px;
    background: #090909;
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .stage-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1), filter 0.5s ease;
  }

  .gateway-card:hover .stage-img {
    transform: scale(1.06);
    filter: brightness(1.05) contrast(1.05);
  }

  .stage-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(14, 14, 14, 0.1) 0%,
      rgba(14, 14, 14, 0.4) 60%,
      rgba(14, 14, 14, 0.95) 100%
    );
  }

  .stage-num-watermark {
    position: absolute;
    bottom: -10px;
    right: 14px;
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: 5rem;
    line-height: 1;
    color: rgba(255, 255, 255, 0.06);
    pointer-events: none;
    z-index: 2;
  }

  .stage-status-chip {
    position: absolute;
    top: 14px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: rgba(14, 14, 14, 0.88);
    border: 1px solid rgba(201, 146, 42, 0.35);
    padding: 5px 12px;
    border-radius: 3px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: #E8B84B;
    z-index: 3;
    backdrop-filter: blur(8px);
  }

  .chip-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8B84B;
    box-shadow: 0 0 8px #E8B84B;
  }

  /* Body Stage */
  .card-body-stage {
    padding: 30px 28px 28px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-category {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: "Inter", sans-serif;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #C9922A;
    margin-bottom: 8px;
  }

  .cat-idx {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.1rem;
    color: #E8B84B;
  }
  .cat-sep { color: rgba(255, 255, 255, 0.2); }
  .cat-text { color: #A3A3A3; }

  .card-title {
    font-family: 'Bebas Neue', 'Oswald', sans-serif;
    font-size: 1.65rem;
    letter-spacing: 0.03em;
    color: #FFFFFF;
    margin: 0 0 12px;
    line-height: 1.15;
  }

  .card-desc {
    font-size: 0.88rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.62);
    margin: 0 0 20px;
    flex-grow: 0;
  }

  /* Checklist */
  .card-checklist {
    list-style: none;
    padding: 0;
    margin: 0 0 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex-grow: 1;
  }

  .check-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 500;
  }

  .check-icon {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: rgba(201, 146, 42, 0.12);
    border: 1px solid rgba(201, 146, 42, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #E8B84B;
    flex-shrink: 0;
    margin-top: 1px;
  }

  /* Action Button */
  .card-action-wrap {
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .btn-gateway {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.28);
    color: #E8B84B;
    padding: 12px 18px;
    border-radius: 4px;
    font-family: "Inter", sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-gateway:hover {
    background: #C9922A;
    border-color: #C9922A;
    color: #0A0A0A;
    box-shadow: 0 6px 20px rgba(201, 146, 42, 0.3);
    transform: translateY(-2px);
  }

  .btn-gateway svg {
    transition: transform 0.3s ease;
  }

  .btn-gateway:hover svg {
    transform: translateX(4px);
  }

  /* =========================================
     RESPONSIVE
     ========================================= */
  @media (max-width: 1024px) {
    .services-gateway-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 768px) {
    .services-section {
      padding: 75px 0 80px;
    }
    .services-header {
      margin-bottom: 36px;
    }
    .services-gateway-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .card-image-stage {
      height: 200px;
    }
    .card-body-stage {
      padding: 24px 20px;
    }

    /* Zero Delay on Mobile/Touch */
    .gateway-card,
    .reveal {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
      transition: border-color 0.2s ease !important;
    }
  }
</style>
