---
import { logoBase64 } from '../data/logo';

interface NavSubItem {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href: string;
  isDropdown?: boolean;
  children?: NavSubItem[];
}

const navLinks: NavItem[] = [
  { label: 'BERANDA', href: '/' },
  {
    label: 'SOLUSI KAMI',
    href: '/#layanan',
    isDropdown: true,
    children: [
      { label: 'Loadbank Rental & Testing', href: '/loadbank-rental-testing' },
      { label: 'Fuel Filtration Systems', href: '/fuel-filtration-systems' },
      { label: 'Generator Service & Maintenance', href: '/generator-service-maintenance' },
    ],
  },
  { label: 'INDUSTRI', href: '/industries' },
  { label: 'KONTAK', href: '/kontak' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isLinkActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  if (href.startsWith('/#')) return false;
  return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<header id="navbar">
  <div class="nav-container">
    <!-- Logo -->
    <a href="/" class="nav-logo">
      <img src={logoBase64} alt="Best Power Servis Logo" width="67" height="48" />
      <span class="nav-logo-text">Best Power Servis</span>
    </a>

    <!-- Desktop Links -->
    <nav class="nav-links" aria-label="Navigasi Utama">
      {navLinks.map(link => (
        link.isDropdown ? (
          <div class="nav-item has-dropdown">
            <a
              href={link.href}
              class={`nav-link dropdown-trigger ${isLinkActive(link.href) ? 'active' : ''}`}
              aria-haspopup="true"
              aria-expanded="false"
            >
              <span>{link.label}</span>
              <svg class="dropdown-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 9l6 6 6-6"/>
              </svg>
            </a>

            <!-- Dropdown Menu -->
            <div class="dropdown-menu" role="menu">
              <div class="dropdown-inner">
                {link.children?.map(child => (
                  <a href={child.href} class="dropdown-item" role="menuitem">
                    <span class="dropdown-bullet"></span>
                    <span class="dropdown-item-text">{child.label}</span>
                    <svg class="dropdown-item-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class={`nav-link ${isLinkActive(link.href) ? 'active' : ''}`}
            aria-current={isLinkActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <!-- Mobile Hamburger -->
    <button class="hamburger" id="menuBtn" aria-label="Buka navigasi" aria-expanded="false" aria-controls="mobileMenu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    {navLinks.map(link => (
      link.isDropdown ? (
        <div class="mobile-dropdown-wrap">
          <button type="button" class="mobile-dropdown-toggle" id="mobileSolutionsBtn" aria-expanded="false">
            <span>{link.label}</span>
            <svg class="mobile-dropdown-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>
          <div class="mobile-dropdown-content" id="mobileSolutionsContent">
            {link.children?.map(child => (
              <a href={child.href} class="mobile-sublink">
                <span class="sublink-dot"></span>
                <span>{child.label}</span>
              </a>
            ))}
          </div>
        </div>
      ) : (
        <a
          href={link.href}
          class={`mobile-link ${isLinkActive(link.href) ? 'active' : ''}`}
          aria-current={isLinkActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      )
    ))}
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease, padding 0.35s ease;
    padding: 18px 0;
  }

  header.scrolled {
    background: rgba(10, 10, 10, 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(201, 146, 42, 0.18);
    padding: 12px 0;
    box-shadow: 0 4px 30px rgba(0,0,0,0.7);
  }

  .nav-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .nav-logo img {
    height: 46px;
    width: auto;
    object-fit: contain;
    filter: brightness(1.1);
    transition: transform 0.3s ease;
  }
  .nav-logo:hover img { transform: rotate(-5deg) scale(1.06); }

  .nav-logo-text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.12rem, 1.6vw, 1.38rem);
    font-weight: 800;
    color: #EBB136;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.25s ease, text-shadow 0.25s ease;
  }

  .nav-logo:hover .nav-logo-text {
    color: #F5C658;
    text-shadow: 0 0 20px rgba(235, 177, 54, 0.4);
  }

  /* Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .nav-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255,255,255,0.78);
    padding: 8px 14px;
    border-radius: 6px;
    transition: color 0.25s ease, background 0.25s ease;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    position: relative;
    white-space: nowrap;
    text-decoration: none;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: #C9922A;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #fff;
  }

  .nav-link.active {
    color: #E8B84B;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  /* Dropdown Styles */
  .nav-item.has-dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .dropdown-arrow {
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    color: rgba(201, 146, 42, 0.8);
  }

  .nav-item.has-dropdown:hover .dropdown-arrow,
  .nav-item.has-dropdown:focus-within .dropdown-arrow {
    transform: rotate(180deg);
    color: #E8B84B;
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    min-width: 310px;
    background: rgba(14, 14, 14, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid rgba(201, 146, 42, 0.3);
    border-radius: 14px;
    padding: 8px;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.85), 0 0 25px rgba(201, 146, 42, 0.1);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 1010;
  }

  /* Bridge to avoid mouseleave when transitioning from trigger to menu */
  .dropdown-menu::before {
    content: '';
    position: absolute;
    top: -14px;
    left: 0;
    right: 0;
    height: 16px;
  }

  .nav-item.has-dropdown:hover .dropdown-menu,
  .nav-item.has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: all;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-inner {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dropdown-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.86rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
    position: relative;
    white-space: nowrap;
  }

  .dropdown-bullet {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(201, 146, 42, 0.45);
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .dropdown-item-arrow {
    margin-left: auto;
    opacity: 0;
    transform: translateX(-6px);
    transition: all 0.25s ease;
    color: #E8B84B;
  }

  .dropdown-item:hover {
    background: rgba(201, 146, 42, 0.14);
    color: #FFFFFF;
    padding-left: 20px;
  }

  .dropdown-item:hover .dropdown-bullet {
    background: #E8B84B;
    box-shadow: 0 0 10px #E8B84B;
    transform: scale(1.3);
  }

  .dropdown-item:hover .dropdown-item-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 8px;
    cursor: pointer;
    padding: 0;
    margin-left: auto;
    -webkit-tap-highlight-color: transparent;
    outline: none;
    transition: all 0.25s ease;
  }

  .hamburger:hover,
  .hamburger:focus-visible,
  .hamburger.active {
    background: rgba(201, 146, 42, 0.18);
    border-color: #C9922A;
    box-shadow: 0 0 16px rgba(201, 146, 42, 0.25);
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
  }

  .hamburger.active span {
    background: #E8B84B;
  }

  .hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .hamburger.active span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile Menu */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(201, 146, 42, 0.25);
    box-shadow: 0 20px 40px rgba(0,0,0,0.85);
    padding: 0 32px;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    pointer-events: none;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s ease,
                visibility 0.3s ease,
                padding 0.35s ease;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-menu.open {
    max-height: 85vh;
    overflow-y: auto;
    padding: 16px 32px 28px;
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .mobile-link {
    font-size: 1rem;
    font-weight: 600;
    color: rgba(255,255,255,0.8);
    padding: 12px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.2s ease, padding-left 0.2s ease;
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mobile-link:last-child {
    border-bottom: none;
  }

  .mobile-link:hover,
  .mobile-link.active {
    color: #E8B84B;
    padding-left: 6px;
  }

  .mobile-link.active {
    font-weight: 700;
  }

  /* Mobile Dropdown */
  .mobile-dropdown-wrap {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .mobile-dropdown-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    font-weight: 600;
    padding: 14px 0;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    transition: color 0.2s ease;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mobile-dropdown-toggle:hover,
  .mobile-dropdown-toggle.active {
    color: #E8B84B;
  }

  .mobile-dropdown-arrow {
    color: rgba(201, 146, 42, 0.7);
    transition: transform 0.3s ease;
  }

  .mobile-dropdown-toggle.active .mobile-dropdown-arrow {
    transform: rotate(180deg);
    color: #E8B84B;
  }

  .mobile-dropdown-content {
    display: none;
    flex-direction: column;
    gap: 2px;
    padding: 0 0 10px 14px;
    border-left: 2px solid rgba(201, 146, 42, 0.3);
    margin-left: 4px;
    margin-bottom: 8px;
  }

  .mobile-dropdown-content.open {
    display: flex;
  }

  .mobile-sublink {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.88rem;
    font-weight: 400;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sublink-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: rgba(201, 146, 42, 0.5);
    transition: background 0.2s ease;
  }

  .mobile-sublink:hover {
    color: #E8B84B;
    padding-left: 6px;
  }

  .mobile-sublink:hover .sublink-dot {
    background: #E8B84B;
  }

  @media (max-width: 1024px) {
    header { padding: 14px 0; }
    header.scrolled { padding: 10px 0; }
    .nav-container { padding: 0 24px; gap: 0; }
    .nav-links { display: none; }
    .hamburger { display: flex; }
  }

  @media (max-width: 480px) {
    .nav-container { padding: 0 16px; }
    .nav-logo { gap: 10px; }
    .nav-logo img { height: 36px; width: auto; }
    .nav-logo-text { font-size: 1.08rem; }
    .mobile-menu {
      padding: 0 20px;
    }
    .mobile-menu.open {
      padding: 12px 20px 22px;
    }
    .mobile-link {
      padding: 12px 0;
      font-size: 0.95rem;
    }
  }
</style>

<script>
  // Mobile accordion toggle for OUR SOLUTIONS
  const solutionsBtn = document.getElementById('mobileSolutionsBtn');
  const solutionsContent = document.getElementById('mobileSolutionsContent');
  if (solutionsBtn && solutionsContent) {
    solutionsBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = solutionsContent.classList.toggle('open');
      solutionsBtn.classList.toggle('active', isOpen);
      solutionsBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }
</script>
