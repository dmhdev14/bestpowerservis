---
const navLinks = [
  { label: 'Tentang Kami', href: '#tentang' },
  { label: 'Visi & Misi', href: '#visi-misi' },
  { label: 'Layanan', href: '#layanan' },
  { label: 'Proyek', href: '#proyek' },
  { label: 'Produk', href: '#produk' },
  { label: 'Keunggulan', href: '#keunggulan' },
  { label: 'Kontak', href: '#kontak' },
];
---

<header id="navbar">
  <div class="nav-container">
    <!-- Logo -->
    <a href="#hero" class="nav-logo">
      <img src="/logo.webp" alt="Best Power Servis Logo" width="52" height="52" />
      <span class="nav-logo-text">Best Power Servis</span>
    </a>

    <!-- Desktop Links -->
    <nav class="nav-links">
      {navLinks.map(link => (
        <a href={link.href} class="nav-link">{link.label}</a>
      ))}
    </nav>

    <!-- Mobile Hamburger -->
    <button class="hamburger" id="menuBtn" aria-label="Buka navigasi" aria-expanded="false" aria-controls="mobileMenu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobileMenu">
    {navLinks.map(link => (
      <a href={link.href} class="mobile-link">{link.label}</a>
    ))}
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background 0.35s ease, transform 0.35s ease, box-shadow 0.35s ease, padding 0.35s ease;
    padding: 18px 0;
  }

  header.scrolled {
    background: rgba(10, 10, 10, 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(201, 146, 42, 0.18);
    padding: 12px 0;
    box-shadow: 0 4px 30px rgba(0,0,0,0.7);
  }

  .nav-container {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  .nav-logo img {
    width: 48px;
    height: 48px;
    object-fit: contain;
    filter: brightness(1.1);
    transition: transform 0.3s ease;
  }
  .nav-logo:hover img { transform: rotate(-5deg) scale(1.06); }

  .nav-logo-text {
    font-family: 'Inter', sans-serif;
    font-size: clamp(1.18rem, 1.8vw, 1.45rem);
    font-weight: 800;
    color: #EBB136;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
    transition: color 0.25s ease, text-shadow 0.25s ease;
  }

  .nav-logo:hover .nav-logo-text {
    color: #F5C658;
    text-shadow: 0 0 20px rgba(235, 177, 54, 0.4);
  }

  /* Nav Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: rgba(255,255,255,0.75);
    padding: 8px 14px;
    border-radius: 6px;
    transition: color 0.25s ease, background 0.25s ease;
    letter-spacing: 0.01em;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 2px;
    left: 14px;
    right: 14px;
    height: 1px;
    background: #C9922A;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #fff;
  }

  .nav-link:hover::after,
  .nav-link.active::after {
    transform: scaleX(1);
  }

  /* Hamburger */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 8px;
    cursor: pointer;
    padding: 0;
    margin-left: auto;
    -webkit-tap-highlight-color: transparent;
    outline: none;
    transition: all 0.25s ease;
  }

  .hamburger:hover,
  .hamburger:focus-visible,
  .hamburger.active {
    background: rgba(201, 146, 42, 0.18);
    border-color: #C9922A;
    box-shadow: 0 0 16px rgba(201, 146, 42, 0.25);
  }

  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #fff;
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease, background 0.3s ease;
  }

  .hamburger.active span {
    background: #E8B84B;
  }

  .hamburger.active span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 5px);
  }
  .hamburger.active span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .hamburger.active span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -5px);
  }

  /* Mobile Menu - Positioned absolutely so it NEVER inflates header height */
  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: rgba(10, 10, 10, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(201, 146, 42, 0.25);
    box-shadow: 0 20px 40px rgba(0,0,0,0.85);
    padding: 0 32px;
    max-height: 0;
    opacity: 0;
    visibility: hidden;
    overflow: hidden;
    pointer-events: none;
    transition: max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                opacity 0.3s ease,
                visibility 0.3s ease,
                padding 0.35s ease;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu.open {
    max-height: 80vh;
    overflow-y: auto;
    padding: 16px 32px 28px;
    opacity: 1;
    visibility: visible;
    pointer-events: all;
  }

  .mobile-link {
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255,255,255,0.85);
    padding: 13px 0;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    transition: color 0.2s ease, padding-left 0.2s ease;
    text-decoration: none;
  }
  .mobile-link:hover {
    color: #E8B84B;
    padding-left: 6px;
  }

  @media (max-width: 900px) {
    header { padding: 14px 0; }
    header.scrolled { padding: 10px 0; }
    .nav-links { display: none; }
    .hamburger { display: flex; }
    .nav-container { gap: 0; }
  }

  @media (max-width: 480px) {
    .nav-container { padding: 0 16px; }
    .nav-logo { gap: 10px; }
    .nav-logo img { width: 38px; height: 38px; }
    .nav-logo-text { font-size: 1.12rem; }
    .mobile-menu {
      padding: 0 20px;
    }
    .mobile-menu.open {
      padding: 14px 20px 24px;
    }
    .mobile-link {
      padding: 13px 0;
      font-size: 0.95rem;
    }
  }
</style>
