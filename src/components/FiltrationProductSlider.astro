---
// Component: FiltrationProductSlider.astro
// Industrial interactive product slide viewer for Replacement Filter & Fuel Filtration Vessel
---

<section class="filtration-catalog-section anim-slide-up" id="katalog-produk">
  <!-- Section Heading -->
  <div class="catalog-header text-center">
    <div class="chip-badge">
      <span class="chip-dot"></span>
      <span>KATALOG SPESIFIKASI PRODUK</span>
    </div>
    <h2 class="catalog-title">
      KATALOG PRODUK <span class="gold-foil">&amp; SPESIFIKASI</span>
    </h2>
    <p class="catalog-subtitle">
      Jelajahi spesifikasi teknis part number elemen filter pengganti dan varian bejana filtrasi industri kami di bawah ini.
    </p>

    <!-- Main Navigation Switcher (2 Tabs) -->
    <div class="category-switcher" role="tablist" aria-label="Kategori Produk Filtrasi">
      <button
        type="button"
        class="switcher-tab active"
        id="tab-replacement"
        role="tab"
        aria-selected="true"
        aria-controls="panel-replacement"
        data-index="0"
      >
        <span class="tab-glow"></span>
        <span class="tab-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        </span>
        <span class="tab-text">REPLACEMENT FILTER</span>
        <span class="tab-count">2 Halaman</span>
      </button>

      <button
        type="button"
        class="switcher-tab"
        id="tab-vessel"
        role="tab"
        aria-selected="false"
        aria-controls="panel-vessel"
        data-index="1"
      >
        <span class="tab-glow"></span>
        <span class="tab-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
          </svg>
        </span>
        <span class="tab-text">FUEL FILTRATION VESSEL (HOUSING)</span>
        <span class="tab-count">2 Halaman</span>
      </button>
    </div>
  </div>

  <!-- Main Viewport / Slider Container -->
  <div class="catalog-viewport">
    <div class="catalog-track" id="catalogTrack">

      <!-- ========================================================
           SLIDE 1: REPLACEMENT FILTER
           ======================================================== -->
      <div
        class="catalog-slide"
        id="panel-replacement"
        role="tabpanel"
        aria-labelledby="tab-replacement"
      >
        <div class="catalog-card">
          <!-- Slide Sub-header & Controls -->
          <div class="card-top-bar">
            <div class="card-badge">
              <span class="badge-dot"></span>
              <strong>REPLACEMENT FILTER ELEMENT</strong>
            </div>

            <!-- Sub-tabs for Sheet 1 & 2 -->
            <div class="sheet-subtabs" data-category="replacement">
              <button type="button" class="subtab-btn active" data-sheet="0">
                <span>01. Wiremesh &amp; Parker/Velcon</span>
              </button>
              <button type="button" class="subtab-btn" data-sheet="1">
                <span>02. Hydac, Rexroth &amp; Pall</span>
              </button>
            </div>

            <div class="sheet-counter">
              <span class="current-sheet-replacement">1</span> / 2
            </div>
          </div>

          <!-- Sub-Slide Carousel Container -->
          <div class="sheets-carousel-wrapper">
            <button
              type="button"
              class="carousel-nav-btn prev-btn"
              data-dir="prev"
              data-category="replacement"
              aria-label="Katalog Sebelumnya"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <div class="sheets-track-wrapper">
              <div class="sheets-track" id="track-replacement">
                <!-- Sheet 1 -->
                <div class="sheet-item active">
                  <div class="image-frame" data-full="/projects/replacement-filter-1.webp" title="Klik untuk memperbesar">
                    <img
                      src="/projects/replacement-filter-1.webp"
                      alt="Katalog Replacement Filter Elemen Wiremesh Media dan Parker Velcon PT Best Power Servis"
                      class="catalog-img"
                      loading="lazy"
                      width="1080"
                      height="1438"
                    />
                    <div class="zoom-overlay">
                      <span class="zoom-pill">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                        Klik untuk Memperbesar
                      </span>
                    </div>
                  </div>
                  <div class="sheet-caption">
                    <strong>Halaman 1:</strong> Wiremesh Media (Washable), Cimtek Filter (Viking &amp; Centurion Housing), Parker &amp; Velcon Filter (Particulate, Coalescer, Separator).
                  </div>
                </div>

                <!-- Sheet 2 -->
                <div class="sheet-item">
                  <div class="image-frame" data-full="/projects/replacement-filter-2.webp" title="Klik untuk memperbesar">
                    <img
                      src="/projects/replacement-filter-2.webp"
                      alt="Katalog Replacement Filter Hydac Rexroth Pall Rotcl Custom PT Best Power Servis"
                      class="catalog-img"
                      loading="lazy"
                      width="1080"
                      height="1427"
                    />
                    <div class="zoom-overlay">
                      <span class="zoom-pill">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                        Klik untuk Memperbesar
                      </span>
                    </div>
                  </div>
                  <div class="sheet-caption">
                    <strong>Halaman 2:</strong> Hydac Filter, Rexroth Filter, Pall Filter (HFU660GF/HFU620GF), Rotcl Filter, dan Custom Filter (Fuel &amp; Oil Filter).
                  </div>
                </div>
              </div>
            </div>

            <button
              type="button"
              class="carousel-nav-btn next-btn"
              data-dir="next"
              data-category="replacement"
              aria-label="Katalog Selanjutnya"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <!-- Bottom Action Dock -->
          <div class="card-bottom-bar">
            <div class="bottom-info">
              <span class="info-badge">HEMAT S/D 50%</span>
              <p>Pengadaan lebih cepat &amp; garansi kualitas setara OEM untuk semua tipe filter industri.</p>
            </div>
            <a
              href="https://wa.me/628111464967?text=Halo%20PT%20Best%20Power%20Servis,%20saya%20ingin%20tanya%20spesifikasi%20dan%20ketersediaan%20Replacement%20Filter."
              target="_blank"
              rel="noopener noreferrer"
              class="catalog-action-btn"
            >
              <span>Konsultasi Part Number via WhatsApp</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- ========================================================
           SLIDE 2: FUEL FILTRATION VESSEL (HOUSING)
           ======================================================== -->
      <div
        class="catalog-slide"
        id="panel-vessel"
        role="tabpanel"
        aria-labelledby="tab-vessel"
      >
        <div class="catalog-card">
          <!-- Slide Sub-header & Controls -->
          <div class="card-top-bar">
            <div class="card-badge">
              <span class="badge-dot"></span>
              <strong>FUEL FILTRATION VESSEL / HOUSING</strong>
            </div>

            <!-- Sub-tabs for Sheet 1 & 2 -->
            <div class="sheet-subtabs" data-category="vessel">
              <button type="button" class="subtab-btn active" data-sheet="0">
                <span>01. Washable &amp; Stationary Skid</span>
              </button>
              <button type="button" class="subtab-btn" data-sheet="1">
                <span>02. Portable &amp; Fuel Truck</span>
              </button>
            </div>

            <div class="sheet-counter">
              <span class="current-sheet-vessel">1</span> / 2
            </div>
          </div>

          <!-- Sub-Slide Carousel Container -->
          <div class="sheets-carousel-wrapper">
            <button
              type="button"
              class="carousel-nav-btn prev-btn"
              data-dir="prev"
              data-category="vessel"
              aria-label="Katalog Sebelumnya"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>

            <div class="sheets-track-wrapper">
              <div class="sheets-track" id="track-vessel">
                <!-- Sheet 1 -->
                <div class="sheet-item active">
                  <div class="image-frame" data-full="/projects/filtration-vessel-1.webp" title="Klik untuk memperbesar">
                    <img
                      src="/projects/filtration-vessel-1.webp"
                      alt="Katalog Fuel Filtration Vessel Washable dan Stationary Filtration Skid PT Best Power Servis"
                      class="catalog-img"
                      loading="lazy"
                      width="1080"
                      height="1435"
                    />
                    <div class="zoom-overlay">
                      <span class="zoom-pill">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                        Klik untuk Memperbesar
                      </span>
                    </div>
                  </div>
                  <div class="sheet-caption">
                    <strong>Halaman 1:</strong> Washable Filter (Flowrate s/d 2000 LPM) &amp; Stationary Filtration (Triple Vessel &amp; Double Vessel Skids).
                  </div>
                </div>

                <!-- Sheet 2 -->
                <div class="sheet-item">
                  <div class="image-frame" data-full="/projects/filtration-vessel-2.webp" title="Klik untuk memperbesar">
                    <img
                      src="/projects/filtration-vessel-2.webp"
                      alt="Katalog Fuel Filtration Vessel Double Vessel Portable dan Fuel Truck PT Best Power Servis"
                      class="catalog-img"
                      loading="lazy"
                      width="1080"
                      height="1428"
                    />
                    <div class="zoom-overlay">
                      <span class="zoom-pill">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <circle cx="11" cy="11" r="8"></circle>
                          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                          <line x1="11" y1="8" x2="11" y2="14"></line>
                          <line x1="8" y1="11" x2="14" y2="11"></line>
                        </svg>
                        Klik untuk Memperbesar
                      </span>
                    </div>
                  </div>
                  <div class="sheet-caption">
                    <strong>Halaman 2:</strong> Double Vessel Filtration, Portable Filtration Units (Single &amp; Double Cart), dan Fuel Truck Vessels.
                  </div>
                </div>
              </div>
            </div>

            <button
              type="button"
              class="carousel-nav-btn next-btn"
              data-dir="next"
              data-category="vessel"
              aria-label="Katalog Selanjutnya"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>

          <!-- Bottom Action Dock -->
          <div class="card-bottom-bar">
            <div class="bottom-info">
              <span class="info-badge">CUSTOM SKID &amp; CAPACITY</span>
              <p>Desain bejana &amp; unit mobile disesuaikan dengan debit alir (LPM) serta kebutuhan lapangan.</p>
            </div>
            <a
              href="https://wa.me/628111464967?text=Halo%20PT%20Best%20Power%20Servis,%20saya%20ingin%20konsultasi%20mengenai%20Fuel%20Filtration%20Vessel%20(Housing)."
              target="_blank"
              rel="noopener noreferrer"
              class="catalog-action-btn"
            >
              <span>Konsultasi Desain Skid via WhatsApp</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Fullscreen Image Lightbox Modal -->
  <div class="catalog-lightbox" id="catalogLightbox" aria-hidden="true" role="dialog">
    <div class="lightbox-backdrop" id="lightboxBackdrop"></div>
    <div class="lightbox-content">
      <button type="button" class="lightbox-close" id="lightboxClose" aria-label="Tutup Tampilan">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      <div class="lightbox-img-wrap">
        <img src="" alt="Katalog Perbesar" id="lightboxImg" class="lightbox-img" />
      </div>
      <div class="lightbox-hint">Gunakan scroll atau pinch untuk zoom. Klik di luar gambar untuk menutup.</div>
    </div>
  </div>
</section>

<script>
  // Industrial Slide & Lightbox Logic
  function initCatalogSlider() {
    const switcherTabs = document.querySelectorAll<HTMLButtonElement>('.category-switcher .switcher-tab');
    const catalogTrack = document.getElementById('catalogTrack');
    const lightbox = document.getElementById('catalogLightbox');
    const lightboxImg = document.getElementById('lightboxImg') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightboxClose');
    const lightboxBackdrop = document.getElementById('lightboxBackdrop');

    if (!catalogTrack || !switcherTabs.length) return;

    // 1. Main Category Slider Switcher
    function setCategory(index: number) {
      switcherTabs.forEach((tab, i) => {
        const isActive = i === index;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      if (catalogTrack) {
        catalogTrack.style.transform = `translateX(-${index * 50}%)`;
      }
    }

    switcherTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const index = parseInt(tab.getAttribute('data-index') || '0', 10);
        setCategory(index);
      });
    });

    // 2. Sub-sheets Carousel (within Replacement and Vessel)
    const categories = ['replacement', 'vessel'];

    categories.forEach((cat) => {
      const track = document.getElementById(`track-${cat}`);
      const subtabs = document.querySelectorAll<HTMLButtonElement>(`.sheet-subtabs[data-category="${cat}"] .subtab-btn`);
      const counter = document.querySelector<HTMLElement>(`.current-sheet-${cat}`);
      const navBtns = document.querySelectorAll<HTMLButtonElement>(`.carousel-nav-btn[data-category="${cat}"]`);
      let currentSheet = 0;
      const totalSheets = 2;

      function updateSheet(sheetIdx: number) {
        currentSheet = (sheetIdx + totalSheets) % totalSheets;

        if (track) {
          track.style.transform = `translateX(-${currentSheet * 50}%)`;
        }

        subtabs.forEach((st, idx) => {
          st.classList.toggle('active', idx === currentSheet);
        });

        if (counter) {
          counter.textContent = (currentSheet + 1).toString();
        }
      }

      subtabs.forEach((st) => {
        st.addEventListener('click', () => {
          const sheet = parseInt(st.getAttribute('data-sheet') || '0', 10);
          updateSheet(sheet);
        });
      });

      navBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const dir = btn.getAttribute('data-dir');
          if (dir === 'prev') {
            updateSheet(currentSheet - 1);
          } else {
            updateSheet(currentSheet + 1);
          }
        });
      });

      // Touch swipe support for sheets
      let touchStartX = 0;
      let touchEndX = 0;

      track?.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      track?.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 45) {
          if (diff > 0) {
            updateSheet(currentSheet + 1);
          } else {
            updateSheet(currentSheet - 1);
          }
        }
      }, { passive: true });
    });

    // 3. Lightbox Modal
    const imageFrames = document.querySelectorAll<HTMLElement>('.image-frame');

    function openLightbox(src: string) {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = src;
      lightbox.classList.add('open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.remove('open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lightboxImg.src = '';
    }

    imageFrames.forEach((frame) => {
      frame.addEventListener('click', () => {
        const fullSrc = frame.getAttribute('data-full');
        if (fullSrc) openLightbox(fullSrc);
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxBackdrop?.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('open')) {
        closeLightbox();
      }
    });
  }

  // Run on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCatalogSlider);
  } else {
    initCatalogSlider();
  }
</script>

<style>
  /* =========================================
     FILTRATION CATALOG SECTION
     ========================================= */
  .filtration-catalog-section {
    position: relative;
    margin: 50px 0 30px;
    padding: 0;
  }

  /* Header */
  .catalog-header {
    max-width: 900px;
    margin: 0 auto 36px;
    text-align: center;
  }

  .chip-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(201, 146, 42, 0.08);
    border: 1px solid rgba(201, 146, 42, 0.3);
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: #e8b84b;
    text-transform: uppercase;
    margin-bottom: 14px;
  }

  .chip-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #e8b84b;
    box-shadow: 0 0 8px rgba(201, 146, 42, 0.8);
  }

  .catalog-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin: 0 0 12px;
    text-transform: uppercase;
  }

  .gold-foil {
    background: linear-gradient(135deg, #d4a034 0%, #f3cf7a 50%, #b88628 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .catalog-subtitle {
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.65);
    line-height: 1.6;
    margin: 0 auto 28px;
    max-width: 680px;
  }

  /* =========================================
     CATEGORY SWITCHER TABS (2 Options)
     ========================================= */
  .category-switcher {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    background: rgba(18, 22, 32, 0.85);
    border: 1px solid rgba(201, 146, 42, 0.25);
    border-radius: 12px;
    box-shadow:
      0 12px 30px rgba(0, 0, 0, 0.5),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .category-switcher::-webkit-scrollbar {
    display: none;
  }

  .switcher-tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 24px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: rgba(255, 255, 255, 0.65);
    font-family: inherit;
    font-size: 0.88rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
  }

  .switcher-tab:hover {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.08);
  }

  .switcher-tab.active {
    color: #e8b84b;
    background: rgba(201, 146, 42, 0.12);
    border-color: rgba(201, 146, 42, 0.55);
    box-shadow:
      0 0 20px rgba(201, 146, 42, 0.15),
      inset 0 0 12px rgba(201, 146, 42, 0.08);
  }

  .tab-icon {
    display: flex;
    align-items: center;
    color: inherit;
  }

  .switcher-tab.active .tab-icon {
    color: #e8b84b;
  }

  .tab-count {
    font-size: 0.68rem;
    padding: 2px 7px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.5);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .switcher-tab.active .tab-count {
    background: rgba(201, 146, 42, 0.25);
    color: #f3cf7a;
  }

  /* =========================================
     VIEWPORT & MAIN SLIDE TRACK
     ========================================= */
  .catalog-viewport {
    width: 100%;
    overflow: hidden;
    position: relative;
    border-radius: 16px;
  }

  .catalog-track {
    display: flex;
    width: 200%;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform;
  }

  .catalog-slide {
    width: 50%;
    flex-shrink: 0;
    box-sizing: border-box;
    padding: 4px;
  }

  /* =========================================
     CATALOG CARD
     ========================================= */
  .catalog-card {
    background: #0f131a;
    border: 1px solid rgba(201, 146, 42, 0.22);
    border-radius: 14px;
    box-shadow:
      0 20px 45px rgba(0, 0, 0, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    overflow: hidden;
    position: relative;
  }

  /* Top Bar */
  .card-top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 24px;
