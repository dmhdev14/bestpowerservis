---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title = 'PT Best Power Servis — Solusi Energi & Filtrasi Industri',
  description = 'PT Best Power Servis menyediakan rental genset, loadbank, service genset, suku cadang, dan sistem filtrasi industri berkualitas tinggi untuk seluruh Indonesia.',
  isHome = false,
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D0D0D" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/logo.webp" />

    <title>{title}</title>

    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Skip loader synchronously on repeat page navigations within the same session -->
    <script is:inline>
      try {
        if (window.sessionStorage && window.sessionStorage.getItem('bps_visited')) {
          document.documentElement.classList.add('skip-loader');
        }
      } catch (e) {
        // Ignore storage restrictions
      }
    </script>
  </head>
  <body>
    <!-- Page Loader: Power Ignition Sequence (shown once per session) -->
    <div id="pageLoader" aria-hidden="true">
      <div class="loader-curtain loader-curtain-top">
        <div class="loader-grid"></div>
      </div>
      <div class="loader-curtain loader-curtain-bottom">
        <div class="loader-grid"></div>
      </div>

      <div class="loader-inner">
        <!-- Counter-Rotating Precision Turbine Emblem -->
        <div class="loader-emblem">
          <div class="loader-glow"></div>
          <svg class="turbine-ring-outer" viewBox="0 0 140 140" fill="none">
            <circle cx="70" cy="70" r="64" stroke="rgba(201,146,42,0.18)" stroke-width="1" />
            <circle
              cx="70"
              cy="70"
              r="64"
              stroke="#C9922A"
              stroke-width="2"
              stroke-dasharray="48 18 12 18"
              stroke-linecap="round"
            />
          </svg>
          <svg class="turbine-ring-inner" viewBox="0 0 110 110" fill="none">
            <circle
              cx="55"
              cy="55"
              r="49"
              stroke="url(#loaderGoldGrad)"
              stroke-width="1.5"
              stroke-dasharray="90 35"
              stroke-linecap="round"
            />
            <defs>
              <linearGradient id="loaderGoldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#E8B84B" />
                <stop offset="100%" stop-color="#7A5C1E" />
              </linearGradient>
            </defs>
          </svg>
          <img
            src="/logo.webp"
            alt="Best Power Servis"
            class="loader-logo"
            width="62"
            height="62"
          />
        </div>

        <!-- Brand & Tagline -->
        <div class="loader-brand-wrap">
          <div class="loader-brand">PT BEST POWER SERVIS</div>
          <div class="loader-tagline">ENERGIZING YOUR INDUSTRY</div>
        </div>

        <!-- Telemetry Progress Bar -->
        <div class="loader-telemetry">
          <div class="loader-meta">
            <span class="loader-status" id="loaderStatus">POWERING SYSTEMS...</span>
            <span class="loader-percent" id="loaderPercent">0%</span>
          </div>
          <div class="loader-bar">
            <div class="loader-progress" id="loaderBar"></div>
          </div>
        </div>
      </div>
    </div>

    <Navbar />

    <main class={isHome ? '' : 'subpage-main'}>
      <slot />
    </main>

    <Footer />

    <!-- Floating Quick WhatsApp Button -->
    <a
      href="https://wa.me/628111464967?text=Halo%20PT%20Best%20Power%20Servis,%20saya%20ingin%20konsultasi%20mengenai%20layanan%20genset%20dan%20filtrasi."
      target="_blank"
      rel="noopener noreferrer"
      class="floating-wa"
      aria-label="Chat WhatsApp PT Best Power Servis"
    >
      <span class="floating-wa-pulse"></span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
      <span class="floating-wa-text">Konsultasi WA</span>
    </a>

    <style>
      html.skip-loader #pageLoader {
        display: none !important;
      }
      #pageLoader {
        position: fixed;
        inset: 0;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: all;
      }
      #pageLoader.hidden {
        pointer-events: none;
      }

      /* Split Curtains */
      .loader-curtain {
        position: absolute;
        left: 0;
        right: 0;
        height: 50%;
        background: #0A0A0A;
        overflow: hidden;
        transition: transform 0.65s cubic-bezier(0.77, 0, 0.175, 1) 0.12s;
        z-index: 1;
      }
      .loader-curtain-top {
        top: 0;
        border-bottom: 1px solid rgba(201, 146, 42, 0.22);
      }
      .loader-curtain-bottom {
        bottom: 0;
        border-top: 1px solid rgba(201, 146, 42, 0.22);
      }
      .loader-grid {
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(201, 146, 42, 0.04) 1px, transparent 1px),
          linear-gradient(90deg, rgba(201, 146, 42, 0.04) 1px, transparent 1px);
        background-size: 48px 48px;
        opacity: 0.7;
      }

      #pageLoader.hidden .loader-curtain-top {
        transform: translateY(-100%);
      }
      #pageLoader.hidden .loader-curtain-bottom {
        transform: translateY(100%);
      }

      /* Center Content */
      .loader-inner {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        padding: 0 24px;
        transition: opacity 0.28s ease, transform 0.28s ease;
      }
      #pageLoader.hidden .loader-inner {
        opacity: 0;
        transform: scale(0.92);
      }

      /* Turbine Emblem */
      .loader-emblem {
        position: relative;
        width: 132px;
        height: 132px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .loader-glow {
        position: absolute;
        inset: 10px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(201, 146, 42, 0.28) 0%, transparent 70%);
        animation: glowPulse 1.8s ease-in-out infinite;
      }
      .turbine-ring-outer {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        animation: spinCW 4.5s linear infinite;
      }
      .turbine-ring-inner {
        position: absolute;
        width: 102px;
        height: 102px;
        animation: spinCCW 3s linear infinite;
      }
      .loader-logo {
        position: relative;
        z-index: 2;
        width: 58px;
        height: 58px;
        object-fit: contain;
        filter: drop-shadow(0 0 12px rgba(232, 184, 75, 0.4));
      }

      @keyframes spinCW {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      @keyframes spinCCW {
        from { transform: rotate(360deg); }
        to { transform: rotate(0deg); }
      }
      @keyframes glowPulse {
        0%, 100% { opacity: 0.7; transform: scale(0.95); }
        50% { opacity: 1; transform: scale(1.08); }
      }

      /* Brand & Tagline */
      .loader-brand-wrap {
        text-align: center;
      }
      .loader-brand {
        font-family: 'Bebas Neue', sans-serif;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        letter-spacing: 0.14em;
        background: linear-gradient(135deg, #FFFFFF 0%, #E8B84B 55%, #C9922A 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        line-height: 1.1;
        margin-bottom: 4px;
      }
      .loader-tagline {
        font-family: 'Inter', sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.36em;
        color: rgba(232, 184, 75, 0.7);
        text-transform: uppercase;
      }

      /* Telemetry Progress */
      .loader-telemetry {
        width: 240px;
        max-width: 75vw;
      }
      .loader-meta {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 8px;
        font-family: 'Inter', sans-serif;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }
      .loader-status {
        color: rgba(255, 255, 255, 0.55);
        transition: color 0.25s ease;
      }
      .loader-status.ready {
        color: #E8B84B;
      }
      .loader-percent {
        color: #E8B84B;
        font-variant-numeric: tabular-nums;
        font-weight: 700;
      }
      .loader-bar {
        width: 100%;
        height: 3px;
        background: rgba(201, 146, 42, 0.16);
        border-radius: 10px;
        overflow: hidden;
      }
      .loader-progress {
        width: 0%;
        height: 100%;
        background: linear-gradient(90deg, #C9922A, #F5C658);
        border-radius: 10px;
        box-shadow: 0 0 12px rgba(232, 184, 75, 0.6);
        transition: width 0.08s linear;
      }

      @media (max-width: 480px) {
        .loader-emblem {
          width: 112px;
          height: 112px;
        }
        .turbine-ring-inner {
          width: 86px;
          height: 86px;
        }
        .loader-logo {
          width: 48px;
          height: 48px;
        }
        .loader-telemetry {
          width: 210px;
        }
      }

      /* Floating Quick WhatsApp */
      .floating-wa {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 999;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #25D366;
        color: #ffffff;
        padding: 12px 18px;
        border-radius: 50px;
        box-shadow: 0 8px 28px rgba(37, 211, 102, 0.4), 0 2px 8px rgba(0,0,0,0.3);
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .floating-wa:hover {
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 12px 36px rgba(37, 211, 102, 0.55);
        color: #ffffff;
      }
      .floating-wa-pulse {
        position: absolute;
        inset: 0;
        border-radius: 50px;
        background: #25D366;
        opacity: 0.5;
        animation: waPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        z-index: -1;
      }
      @keyframes waPulse {
        0% { transform: scale(1); opacity: 0.6; }
        70% { transform: scale(1.15, 1.3); opacity: 0; }
        100% { transform: scale(1.15, 1.3); opacity: 0; }
      }

      @media (max-width: 600px) {
        .floating-wa {
          bottom: 18px;
          right: 16px;
          padding: 10px 14px;
          font-size: 0.78rem;
          gap: 6px;
        }
        .floating-wa svg {
          width: 18px;
          height: 18px;
        }
      }
    </style>

    <script>
      function initLayout(): void {
        // Mark session visited
        try {
          window.sessionStorage.setItem('bps_visited', '1');
        } catch {
          // Ignore storage restrictions
        }

        // Power Ignition Loader Sequence
        const loader = document.getElementById('pageLoader');
        const percentEl = document.getElementById('loaderPercent');
        const statusEl = document.getElementById('loaderStatus');
        const barEl = document.getElementById('loaderBar');
        const skipLoader = document.documentElement.classList.contains('skip-loader');

        const dismissLoader = (): void => {
          if (loader && !loader.classList.contains('hidden')) {
            loader.classList.add('hidden');
            // Fully remove from layout rendering after split curtain transition finishes
            window.setTimeout(() => {
              loader.style.display = 'none';
            }, 850);
          }
        };

        if (loader && !skipLoader) {
          const duration = 1050;
          const startTime = performance.now();

          const stepLoader = (now: number): void => {
            const elapsed = now - startTime;
            const rawProgress = Math.min(elapsed / duration, 1);
            // Smooth ease-out curve
            const eased = 1 - Math.pow(1 - rawProgress, 2.5);
            const pct = Math.round(eased * 100);

            if (percentEl) percentEl.textContent = `${pct}%`;
            if (barEl) barEl.style.width = `${pct}%`;

            if (statusEl) {
              if (pct >= 100) {
                statusEl.textContent = 'SYSTEM READY';
                statusEl.classList.add('ready');
              } else if (pct >= 45) {
                statusEl.textContent = 'CALIBRATING FILTRATION...';
              }
            }

            if (rawProgress < 1) {
              requestAnimationFrame(stepLoader);
            } else {
              window.setTimeout(dismissLoader, 180);
            }
          };

          requestAnimationFrame(stepLoader);
          // Safety fallback: never block longer than 1.9s
          window.setTimeout(dismissLoader, 1900);
        } else {
          dismissLoader();
        }

        // Immediately reveal above-the-fold elements on both Home and Subpages
        const aboveFoldSelectors =
          '#hero .reveal, .subpage-main > section:first-child .reveal, .subpage-main > section:first-child .reveal-left, .subpage-main > section:first-child .reveal-right';
        document.querySelectorAll(aboveFoldSelectors).forEach((el) => {
          el.classList.add('visible');
        });

        // Intersection Observer for reveal animations
        const revealObserver = new IntersectionObserver(
          (entries: IntersectionObserverEntry[]) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
              }
            });
          },
          { threshold: 0.05, rootMargin: '0px 0px -20px 0px' }
        );

        document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach((el) => {
          revealObserver.observe(el);
        });

        // Counter animation (shared — used by About, Hero & Products sections)
        const animateCounter = (el: Element): void => {
          const target = parseInt(el.getAttribute('data-target') || '0', 10);
          const duration = 1800;
          const start = performance.now();

          const update = (now: number): void => {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.floor(eased * target).toLocaleString();
            if (progress < 1) {
              requestAnimationFrame(update);
            }
          };

          requestAnimationFrame(update);
        };

        const counterObserver = new IntersectionObserver(
          (entries: IntersectionObserverEntry[]) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && !entry.target.classList.contains('counted')) {
                entry.target.classList.add('counted');
                animateCounter(entry.target);
              }
            });
          },
          { threshold: 0.2 }
        );

        document.querySelectorAll('[data-counter]').forEach((el) => {
          counterObserver.observe(el);
        });

        // Navbar — throttled scroll handler
        const navbar = document.getElementById('navbar');
        let scrollTicking = false;

        const updateNavbarScroll = (): void => {
          if (navbar) {
            navbar.classList.toggle('scrolled', window.scrollY > 30);
          }
        };
        updateNavbarScroll();

        window.addEventListener('scroll', () => {
          if (!scrollTicking) {
            requestAnimationFrame(() => {
              updateNavbarScroll();
              scrollTicking = false;
            });
            scrollTicking = true;
          }
        });

        // Mobile menu
        const menuBtn = document.getElementById('menuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        if (menuBtn && mobileMenu) {
          const toggleMenu = (open?: boolean): void => {
            const shouldOpen = open !== undefined ? open : !mobileMenu.classList.contains('open');
            mobileMenu.classList.toggle('open', shouldOpen);
            menuBtn.classList.toggle('active', shouldOpen);
            menuBtn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
          };

          menuBtn.addEventListener('click', (e: Event) => {
            e.stopPropagation();
            toggleMenu();
          });

          mobileMenu.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', () => {
              toggleMenu(false);
            });
          });

          document.addEventListener('click', (e: Event) => {
            if (
              mobileMenu.classList.contains('open') &&
              !mobileMenu.contains(e.target as Node) &&
              !menuBtn.contains(e.target as Node)
            ) {
              toggleMenu(false);
            }
          });

          document.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
              toggleMenu(false);
            }
          });
        }
      }

      initLayout();
    </script>
  </body>
</html>
