---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'PT Best Power Servis — Solusi Energi & Filtrasi Industri',
  description = 'PT Best Power Servis menyediakan rental genset, loadbank, service genset, suku cadang, dan sistem filtrasi industri berkualitas tinggi untuk seluruh Indonesia.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0D0D0D" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />

    <!-- Favicon -->
    <link rel="icon" type="image/webp" href="/logo.webp" />

    <title>{title}</title>

    <!-- Preload fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Page Loader -->
    <div id="pageLoader">
      <div class="loader-inner">
        <img src="/logo.webp" alt="Best Power Servis" width="64" height="64" />
        <div class="loader-bar">
          <div class="loader-progress"></div>
        </div>
      </div>
    </div>

    <slot />

    <!-- Floating Quick WhatsApp Button -->
    <a
      href="https://wa.me/628111464967?text=Halo%20PT%20Best%20Power%20Servis,%20saya%20ingin%20konsultasi%20mengenai%20layanan%20genset%20dan%20filtrasi."
      target="_blank"
      rel="noopener noreferrer"
      class="floating-wa"
      aria-label="Chat WhatsApp PT Best Power Servis"
    >
      <span class="floating-wa-pulse"></span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
      </svg>
      <span class="floating-wa-text">Konsultasi WA</span>
    </a>

    <style>
      #pageLoader {
        position: fixed;
        inset: 0;
        background: #0D0D0D;
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: opacity 0.6s ease, visibility 0.6s ease;
      }
      #pageLoader.hidden {
        opacity: 0;
        visibility: hidden;
      }
      .loader-inner {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 24px;
      }
      .loader-inner img {
        animation: pulse 1.2s ease-in-out infinite;
      }
      .loader-bar {
        width: 180px;
        height: 2px;
        background: rgba(201,146,42,0.2);
        border-radius: 10px;
        overflow: hidden;
      }
      .loader-progress {
        height: 100%;
        background: linear-gradient(90deg, #C9922A, #E8B84B);
        border-radius: 10px;
        animation: loadProgress 1.2s ease forwards;
      }
      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.6; transform: scale(0.95); }
      }
      @keyframes loadProgress {
        from { width: 0; }
        to { width: 100%; }
      }

      /* Floating Quick WhatsApp */
      .floating-wa {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 999;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #25D366;
        color: #ffffff;
        padding: 12px 18px;
        border-radius: 50px;
        box-shadow: 0 8px 28px rgba(37, 211, 102, 0.4), 0 2px 8px rgba(0,0,0,0.3);
        font-family: 'Inter', sans-serif;
        font-size: 0.85rem;
        font-weight: 700;
        letter-spacing: 0.02em;
        text-decoration: none;
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .floating-wa:hover {
        transform: translateY(-2px) scale(1.03);
        box-shadow: 0 12px 36px rgba(37, 211, 102, 0.55);
        color: #ffffff;
      }
      .floating-wa-pulse {
        position: absolute;
        inset: 0;
        border-radius: 50px;
        background: #25D366;
        opacity: 0.5;
        animation: waPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        z-index: -1;
      }
      @keyframes waPulse {
        0% { transform: scale(1); opacity: 0.6; }
        70% { transform: scale(1.15, 1.3); opacity: 0; }
        100% { transform: scale(1.15, 1.3); opacity: 0; }
      }

      @media (max-width: 600px) {
        .floating-wa {
          bottom: 18px;
          right: 16px;
          padding: 10px 14px;
          font-size: 0.78rem;
          gap: 6px;
        }
        .floating-wa svg {
          width: 18px;
          height: 18px;
        }
      }
    </style>

    <script>
      // Page Loader with fast safety fallback
      const hidePageLoader = () => {
        const loader = document.getElementById('pageLoader');
        if (loader && !loader.classList.contains('hidden')) {
          loader.classList.add('hidden');
        }
      };

      window.addEventListener('load', () => {
        setTimeout(hidePageLoader, 500);
      });
      // Safety timeout: dismiss loader after 1.8s regardless of network conditions
      setTimeout(hidePageLoader, 1800);

      // Immediately reveal Hero elements so they are never hidden or delayed
      document.querySelectorAll('#hero .reveal').forEach((el) => {
        el.classList.add('visible');
      });

      // Intersection Observer for reveal animations on remaining sections
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -30px 0px' });

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right').forEach((el) => {
        revealObserver.observe(el);
      });

      // Counter animation (shared — used by About, Hero & Products sections)
      function animateCounter(el: Element) {
        const target = parseInt(el.getAttribute('data-target') || '0');
        const duration = 1800;
        const start = performance.now();
        function update(now: number) {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = Math.floor(eased * target).toLocaleString();
          if (progress < 1) requestAnimationFrame(update);
        }
        requestAnimationFrame(update);
      }

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !entry.target.classList.contains('counted')) {
            entry.target.classList.add('counted');
            animateCounter(entry.target);
          }
        });
      }, { threshold: 0.2 });

      document.querySelectorAll('[data-counter]').forEach((el) => {
        counterObserver.observe(el);
      });

      // Navbar — throttled scroll handler
      const navbar = document.getElementById('navbar');
      let lastScroll = 0;
      let scrollTicking = false;

      window.addEventListener('scroll', () => {
        if (!scrollTicking) {
          requestAnimationFrame(() => {
            const currentScroll = window.scrollY;

            if (navbar) {
              navbar.classList.toggle('scrolled', currentScroll > 30);
            }

            // Active nav link — cast to HTMLElement for offsetTop access
            let current = '';
            document.querySelectorAll('section[id]').forEach((section) => {
              if (window.scrollY >= (section as HTMLElement).offsetTop - 120) current = section.id;
            });
            document.querySelectorAll('.nav-link').forEach((link) => {
              link.classList.toggle('active', link.getAttribute('href') === '#' + current);
            });

            lastScroll = currentScroll;
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      });

      // Mobile menu
      const menuBtn = document.getElementById('menuBtn');
      const mobileMenu = document.getElementById('mobileMenu');
      if (menuBtn && mobileMenu) {
        const toggleMenu = (open?: boolean) => {
          const shouldOpen = open !== undefined ? open : !mobileMenu.classList.contains('open');
          mobileMenu.classList.toggle('open', shouldOpen);
          menuBtn.classList.toggle('active', shouldOpen);
          menuBtn.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
        };

        menuBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          toggleMenu();
        });

        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            toggleMenu(false);
          });
        });

        // Close on click outside
        document.addEventListener('click', (e) => {
          if (
            mobileMenu.classList.contains('open') &&
            !mobileMenu.contains(e.target as Node) &&
            !menuBtn.contains(e.target as Node)
          ) {
            toggleMenu(false);
          }
        });

        // Close on Escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && mobileMenu.classList.contains('open')) {
            toggleMenu(false);
          }
        });
      }
    </script>
  </body>
</html>
